         RowBox[{"productXbool", "==", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"bsXindx", "=", 
           RowBox[{"xIndx", "-", "4"}]}], ";", "\[IndentingNewLine]", 
