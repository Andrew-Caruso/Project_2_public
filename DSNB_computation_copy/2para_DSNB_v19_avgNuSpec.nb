        RowBox[{"x", ",", "y"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}], ",", "..."}], "}"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EnuIBD", "=", 
     RowBox[{"Interpolation", "[", "EnuIBDdata", "]"}]}], ";"}]}]}]], "Input",\

