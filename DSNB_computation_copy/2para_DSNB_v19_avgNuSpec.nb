        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"func", "[", "i", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "dsnbMin", ",", "dsnbMax", ",", "dsnbStep"}], 
