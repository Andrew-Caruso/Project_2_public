Cell["\<\
create function of the IMF used in Kresse et al. (for the progen+engine data)\
\
\>", "Text",
 CellChangeTimes->{{3.948228002892817*^9, 
  3.948228032201158*^9}},ExpressionUUID->"e5690b28-f4bb-4c43-ae8c-\
81bc50773577"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"chosen", " ", "IMF"}], ",", " ", 
    RowBox[{
    "MUST", " ", "be", " ", "consistent", " ", "with", " ", "chosen", " ", 
     "star", " ", "formation", " ", "rate", " ", "SFR", " ", "parameters"}]}],
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"derive", " ", "rate", " ", "of", " ", "core"}], "-", 
    RowBox[{"collapse", " ", "normalization", " ", 
     RowBox[{"(", 
      RowBox[{"i", ".", "e", ".", " ", 
       RowBox[{"Rcc", "[", 
        RowBox[{"z", "=", "0"}], "]"}]}], ")"}], " ", "from", " ", "the", " ",
      "chosen", " ", "IMF", " ", "in", " ", "Kresse", " ", "et", " ", 
     RowBox[{"al", ".", " ", "2021"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "and", " ", "compare", " ", "to", " ", "the", " ", "given", " ", "value", " ",
     "from", " ", "Kresse", " ", "et", " ", 
    RowBox[{"al", ".", " ", "2021"}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Modified", " ", "Salpeter"}], "-", 
    RowBox[{"A", " ", "initial", " ", "mass", " ", "function", " ", "IMF"}]}],
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"NOTE", ":", " ", 
    RowBox[{
    "IMF", " ", "is", " ", "a", " ", "function", " ", "of", " ", "Mzams", " ",
      "NOT", " ", "repeat", " ", "NOT", " ", 
     RowBox[{
      RowBox[{"Mco", "!!"}], "!!"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"From", " ", "Baldry", " ", "et", " ", 
    RowBox[{"al", ".", " ", "2003"}], 
    RowBox[{"??", "?"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"used", " ", "in", " ", "Kresse", " ", "et", " ", 
    RowBox[{"al", ".", " ", "2021"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"TEMPmodSalpeterA", "=", 
    RowBox[{
     RowBox[{"Piecewise", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          SuperscriptBox["#", 
           RowBox[{"-", "2.35"}]], ",", 
          RowBox[{"#", ">=", "0.5"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          SuperscriptBox["#", 
           RowBox[{"-", "1.5"}]], ",", 
          RowBox[{"0.1", "<=", "#", "<", "0.5"}]}], "}"}]}], "}"}], "]"}], 
     "&"}]}], ";"}]}]], "Input",
 CellChangeTimes->{
  3.948227914658388*^9, {3.948227965915262*^9, 3.948227972093285*^9}, {
   3.948271400708288*^9, 3.9482714161081467`*^9}},
 CellLabel->"In[82]:=",ExpressionUUID->"5ae3ee63-fe08-4f14-8870-477df3a8c312"],

