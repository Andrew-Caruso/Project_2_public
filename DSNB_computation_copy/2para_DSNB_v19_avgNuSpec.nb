Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"intDSNBbs", ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "for", " ", "bin", " ", "syn", " ", "without", " ", "outliers"}], ",",
         " ", 
        RowBox[{
         RowBox[{"with", "/", "without"}], " ", "MSW", " ", "effect"}]}], 
       "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "suppress", " ", "numerical", " ", "integration", " ", "error"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Quiet", "[", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"without", " ", "MSW", " ", "effect"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"int1030DSNBallNSwithout", "=", 
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{"DSNBallNSwithout", "[", "x", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "EminKresse", ",", "EmaxKresse"}], "}"}], ",", 
            
            RowBox[{"Method", "->", "\"\<Trapezoidal\>\""}], ",", 
            RowBox[{"PrecisionGoal", "->", "2"}], ",", 
            RowBox[{"AccuracyGoal", "->", "20"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"BH", "+", 
           RowBox[{"NS", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"i", ".", "e", ".", " ", "with"}], " ", "criterion"}], 
             ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"int1030DSNB2Pwithout", "=", 
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{"dsnb2Pwithout", "[", "x", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "EminKresse", ",", "EmaxKresse"}], "}"}], ",", 
            
            RowBox[{"Method", "->", "\"\<Trapezoidal\>\""}], ",", 
            RowBox[{"PrecisionGoal", "->", "2"}], ",", 
            RowBox[{"AccuracyGoal", "->", "20"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"with", " ", "MSW", " ", "effect"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"for", " ", "IH"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"all", " ", "NS"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"int1030DSNBallNSwithoutIH", "=", 
          RowBox[{"NIntegrate", "[", 
