Cell[CellGroupData[{

Cell["construct nu spec", "Subsubsection",
 CellChangeTimes->{{3.964361409800417*^9, 
  3.964361419154991*^9}},ExpressionUUID->"3d8aed7e-af9d-4e5a-99e4-\
0937f2addf99"],

Cell["\<\
get all neutrino energy spectral parameters from bin syn data \
\>", "Text",
 CellChangeTimes->{
  3.964361460409955*^9},ExpressionUUID->"2a116856-e01e-4ef4-b431-\
7910a7700c71"],

Cell["further comments", "Text",
 CellChangeTimes->{{3.964361477215169*^9, 
  3.96436147877695*^9}},ExpressionUUID->"57d3e41d-b396-4ce1-8ecd-\
62fd8996362a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"recall", " ", "neutrino", " ", "sepctrum", " ", 
    RowBox[{"function", ":", " ", 
     RowBox[{"nuSpec", "[", 
      RowBox[{"E_", ",", "Etot_", ",", "Eavg_", ",", "\[Alpha]_"}], "]"}]}]}],
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "recall", " ", "format", " ", "of", " ", "new", " ", "bin", " ", "syn", " ",
     "data", " ", "is", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", ",", "y", ",", "count"}], ")"}], ",", 
      RowBox[{"{", 
       RowBox[{"Etot", ",", "Eavg", ",", "alpha"}], "}"}], ",", "bool"}], 
     ")"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
     "where", " ", "x", " ", "and", " ", "y", " ", "are", " ", "the", " ", 
      "nearest", " ", "values", " ", "in", " ", "progen"}], "+", 
     RowBox[{
     "engine", " ", "data", " ", "to", " ", "bin", " ", "syn", " ", "x", " ", 
      "and", " ", "y", " ", "values"}]}], ",", " ", 
    RowBox[{"keeping", " ", "the", " ", "same", " ", "counts"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"i", ".", "e", ".", " ", "new"}], " ", "bin", " ", "data", " ", 
     "takes", " ", "on", " ", "nearest", " ", "x", " ", "and", " ", "y", " ", 
     "values", " ", "in", " ", "progem"}], "+", 
    RowBox[{"engine", " ", "data"}]}], "*)"}], " ", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"in", " ", "order", " ", "of", " ", 
    RowBox[{"{", 
     RowBox[{"Etotnuebar", ",", "Eavgnuebar", ",", "alpha"}], "}"}]}], "*)"}],
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"nuebar", ":", " ", "1"}], ",", "4", ",", "7"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"nue", ":", " ", "2"}], ",", "5", ",", "8"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"nux", ":", " ", "3"}], ",", "6", ",", "9"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"new", " ", 
    RowBox[{"format", ":", " ", 
     RowBox[{"(", 
      RowBox[{"count", ",", 
       RowBox[{"nuebarSpec", "[", "E", "]"}], ",", 
       RowBox[{"nueSpec", "[", "E", "]"}], ",", 
       RowBox[{"nuxSpec", "[", "E", "]"}], ",", 
       RowBox[{"inside", "-", "bool"}]}], ")"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "get", " ", "neutrino", " ", "spectra", " ", "for", " ", "nuebar"}], ",", 
    "nue", ",", 
    RowBox[{
    "nux", " ", "and", " ", "reformat", " ", "bin", " ", "syn", " ", "data", " ",
      "for", " ", "diff", " ", "cases"}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"NOTE", ":", " ", 
     RowBox[{"neglect", " ", "full", " ", "bin", " ", "syn", " ", "range"}]}],
     ",", " ", 
    RowBox[{
    "since", " ", "it", " ", "makes", " ", "no", " ", "sense", " ", "to", " ",
      "keep"}]}], "*)"}], "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.964361465610458*^9, 3.964361487387207*^9}},
 CellLabel->
  "In[184]:=",ExpressionUUID->"20ae8dbd-0ebb-4e92-a3db-a5d6e82d2a12"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bsConstructnuSpec", ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "build", " ", "neutrino", " ", "spectra", " ", "for", " ", "all", " ", 
       "cases", " ", "in", " ", "new", " ", "bin", " ", "syn", " ", "data"}], 
      "*)"}], "\[IndentingNewLine]", "\t", 
     RowBox[{"(*", 
      RowBox[{"for", " ", "all", " ", "NS", " ", "bin", " ", "syn"}], "*)"}], 
     "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"allNSnu", "=", 
       RowBox[{"nuSpecBuilder", "[", "allNSnewData", "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"(*", 
       RowBox[{"for", " ", "NS", " ", 
        RowBox[{"(", 
         RowBox[{"with", " ", "criterion"}], ")"}], " ", "bin", " ", "syn"}], 
       "*)"}], "\[IndentingNewLine]", "\t", 
      RowBox[{"NS2Pnu", "=", 
       RowBox[{"nuSpecBuilder", "[", "NS2PnewData", "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"(*", 
       RowBox[{"for", " ", "BH", " ", 
        RowBox[{"(", 
         RowBox[{"with", " ", "criterion"}], ")"}], " ", "bin", " ", "syn"}], 
       "*)"}], "\[IndentingNewLine]", "\t", 
      RowBox[{"BH2Pnu", "=", 
       RowBox[{"nuSpecBuilder", "[", "BH2PnewData", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
