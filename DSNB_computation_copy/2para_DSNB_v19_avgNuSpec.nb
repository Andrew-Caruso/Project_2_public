          RowBox[{"{", 
           RowBox[{"0", ",", "maxYround", ",", "\[CapitalDelta]y"}], "}"}]}], 
         "]"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{"num", " ", "of", " ", "BH", " ", "counts"}], "*)"}], 
