       "\[IndentingNewLine]", "\t", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Grid", "[", 
          RowBox[{"table5Rows", ",", 
           RowBox[{"Frame", "->", "All"}]}], "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"for", " ", "comparison"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "replicate", " ", "table", " ", "from", " ", "Horiuchi", " ", "et", " ", 
