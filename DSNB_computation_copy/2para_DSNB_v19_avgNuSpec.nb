Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"keyNumbers", "[", 
     RowBox[{"x_", ",", "y_", ",", "z_", ",", "w_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"chosenMbaryLim", "=", "x"}], ",", 
        RowBox[{"binsynTopName", "=", "y"}], ",", 
        RowBox[{"engineName", "=", "z"}], ",", 
        RowBox[{"bool2Pis", "=", "w"}]}], "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"define", " ", "rows"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"bsIntDSNBrow", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           
           RowBox[{"\"\<\>\"", 
            ",", "\"\< detection integrated DSNB \
(\!\(\*SuperscriptBox[\(cm\), \(-2\)]\)\!\(\*SuperscriptBox[\(s\), \(-1\)]\))\
\>\"", ",", 
            RowBox[{
             RowBox[{"ToString", "[", "EminKresse", "]"}], 
             "<>", "\"\< to \>\"", "<>", 
             RowBox[{"ToString", "[", "EmaxKresse", "]"}], 
             "<>", "\"\< MeV\>\""}]}], "}"}], ",", 
          RowBox[{"{", "\"\<bin syn without outliers\>\"", "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
           "binsynTopName", ",", "\"\<all NS (no MSW)\>\"", ",", 
            "int1030DSNBallNSwithout"}], "}"}], ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<\>\"", ",", "\"\<all NS (IH)\>\"", ",", 
            "int1030DSNBallNSwithoutIH"}], "}"}], ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<\>\"", ",", "\"\<all NS (NH)\>\"", ",", 
            "int1030DSNBallNSwithoutNH"}], "}"}], ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<\>\"", ",", "\"\<NS+BH with 2P crit (no MSW)\>\"", ",",
             "int1030DSNB2Pwithout"}], "}"}], ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<\>\"", ",", "\"\<NS+BH with 2P crit  (IH)\>\"", ",", 
            "int1030DSNB2PwithoutIH"}], "}"}], ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<\>\"", ",", "\"\<NS+BH with 2P crit  (NH)\>\"", ",", 
            "int1030DSNB2PwithoutNH"}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nobsIntDSNBrow", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "\"\<no bin syn without outliers\>\"", "}"}], ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<\>\"", ",", "\"\<all NS (no MSW)\>\"", ",", 
            "noint1030DSNBallNSwithout"}], "}"}], ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<\>\"", ",", "\"\<all NS (IH)\>\"", ",", 
            "noint1030DSNBallNSwithoutIH"}], "}"}], ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<\>\"", ",", "\"\<all NS (NH)\>\"", ",", 
            "noint1030DSNBallNSwithoutNH"}], "}"}], ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<\>\"", ",", "\"\<NS+BH with 2P crit (no MSW)\>\"", ",",
             "noint1030DSNB2Pwithout"}], "}"}], ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<\>\"", ",", "\"\<NS+BH with 2P crit  (IH)\>\"", ",", 
            "noint1030DSNB2PwithoutIH"}], "}"}], ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<\>\"", ",", "\"\<NS+BH with 2P crit  (NH)\>\"", ",", 
            "noint1030DSNB2PwithoutNH"}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Super", "-", 
         RowBox[{"K", " ", "Gd"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"bsEventRateRow", "=", 
        RowBox[{"{", 
