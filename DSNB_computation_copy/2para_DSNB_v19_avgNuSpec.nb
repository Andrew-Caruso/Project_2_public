Cell["\<\
function that takes in combo (progen+engine data) and bin syn data, and spits \
out new bin syn data\
\>", "Text",
 CellChangeTimes->{{3.951160276788149*^9, 
  3.9511602953577337`*^9}},ExpressionUUID->"8330cc5b-9cdf-4e31-b1ff-\
deaa17fbfa97"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"function", " ", "that", " ", "takes", " ", "in", " ", "combo", " ", 
     RowBox[{"(", 
      RowBox[{"progen", "+", 
       RowBox[{"engine", " ", "data"}]}], ")"}], " ", "and", " ", "bin", " ", 
     "syn", " ", "data"}], ",", 
    RowBox[{
    "and", " ", "spits", " ", "out", " ", "new", " ", "bin", " ", "syn", " ", 
     "data"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"inputs", ":", " ", "peData"}], ",", "peXmin", ",", "peXmax", ",",
     "peYmin", ",", "peYmax", ",", "bsData"}], "*)"}], "\[IndentingNewLine]", 
  
  RowBox[{
   RowBox[{"matcher2Pfun", "[", 
    RowBox[{
    "l1_", ",", "min1a_", ",", "max1a_", ",", "min1b_", ",", "max1b_", ",", 
     "l2_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"peData", "=", "l1"}], ",", 
       RowBox[{"XminPE", "=", "min1a"}], ",", 
       RowBox[{"XmaxPE", "=", "max1a"}], ",", 
       RowBox[{"YminPE", "=", "min1b"}], ",", 
       RowBox[{"YmaxPE", "=", "max1b"}], ",", 
       RowBox[{"bsData", "=", "l2"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "bin", " ", "syn", " ", "data", " ", "bsData", " ", "is", " ", "in", " ",
        "format", " ", 
       RowBox[{"(", 
        RowBox[{"x", ",", "y", ",", "count"}], ")"}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"progen", "+", 
       RowBox[{
       "engine", " ", "data", " ", "peData", " ", "is", " ", "in", " ", 
        "format", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", ",", "y"}], ")"}], ",", 
          RowBox[{"(", 
           RowBox[{"Etot", ",", "Eavg", ",", "alpha"}], ")"}]}], ")"}]}]}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "where", " ", "each", " ", "nu", " ", "parameters", " ", "is", " ", 
        "in", " ", "order", " ", "of", " ", "nuebar"}], ",", "nue", ",", " ", 
       
       RowBox[{"and", " ", "nux"}]}], "*)"}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "check", " ", "if", " ", "each", " ", "x", " ", "and", " ", "y", " ", 
        "value", " ", "of", " ", "bin", " ", "syn", " ", "data", " ", "is", " ",
         "within", " ", "bounds", " ", "of", " ", "progen"}], "+", 
       RowBox[{"engine", " ", "data"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"bsMatchedBool", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"XminPE", "<=", 
            RowBox[{"bsData", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "1"}], "]"}], "]"}], "<=", "XmaxPE"}], " ", "&&", 
           RowBox[{"YminPE", "<=", 
            RowBox[{"bsData", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "2"}], "]"}], "]"}], "<=", "YmaxPE"}]}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "bsData", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"for", " ", "each", " ", "pair", " ", 
         RowBox[{"(", 
          RowBox[{"x", ",", "y"}], ")"}], " ", "value", " ", "in", " ", "bin",
          " ", "syn"}], ",", " ", 
        RowBox[{
         RowBox[{"take", " ", "on", " ", "the", " ", "nearest", " ", "pair", " ", 
          RowBox[{"(", 
           RowBox[{"x", ",", "y"}], ")"}], " ", "in", " ", "the", " ", 
          "progen"}], "+", 
         RowBox[{"engine", " ", "data"}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"bsMatchXY", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Nearest", "[", 
          RowBox[{
           RowBox[{"peData", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
           RowBox[{"bsData", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", 
              RowBox[{"1", ";;", "2"}]}], "]"}], "]"}]}], "]"}], ",", "1"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{
         "from", " ", "the", " ", "chosen", " ", "nearest", " ", "pair", " ", 
          
          RowBox[{"(", 
           RowBox[{"x", ",", "y"}], ")"}], " ", "value", " ", "in", " ", 
          "progen"}], "+", 
         RowBox[{"engine", " ", "data"}]}], ",", " ", 
        RowBox[{
         RowBox[{
         "extract", " ", "each", " ", "corresponding", " ", "index", " ", 
          "in", " ", "the", " ", "progen"}], "+", 
         RowBox[{"engine", " ", "data"}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"bsMatchIndex", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{"peData", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"bsMatchXY", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "bsMatchXY", "]"}]}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"form", " ", "final", " ", "data"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"new", " ", "format", " ", 
        RowBox[{"is", ":", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"nearest", " ", "x"}], ",", " ", 
             RowBox[{"nearest", " ", "y"}], ",", " ", 
             RowBox[{"original", " ", "count"}]}], ")"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"Etotnuebar", ",", "Eavgnuebar", ",", "alpha"}], "}"}], ",", 
           RowBox[{"inside", " ", "boolean"}]}], ")"}]}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"bsMatchXY", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"bsMatchXY", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
            RowBox[{"bsData", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "3"}], "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"peData", "[", 
             RowBox[{"[", 
              RowBox[{"bsMatchIndex", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"bsMatchedBool", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "bsMatchIndex", "]"}]}], "}"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], 
   RowBox[{"(*", 
    RowBox[{"end", " ", "of", " ", "module"}], "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.9511603038176928`*^9, 3.951160316826239*^9}, {
   3.951160417116695*^9, 3.951160647458152*^9}, 3.951161192930966*^9, {
   3.9511612348064413`*^9, 3.9511614687279253`*^9}, {3.951208720569173*^9, 
   3.951208776400867*^9}, {3.9512093831987057`*^9, 3.9512093843022747`*^9}, {
   3.95121215689007*^9, 3.951212215579067*^9}, {3.951217408150655*^9, 
   3.9512174152877197`*^9}, {3.951217552679617*^9, 3.951217554196125*^9}, {
   3.951217623569757*^9, 3.951217624412772*^9}, {3.951217712322405*^9, 
   3.951217720359931*^9}, {3.951217789899935*^9, 3.951217790461794*^9}, {
   3.9512184107310266`*^9, 3.951218425522998*^9}, {3.951218497730476*^9, 
   3.95121851181005*^9}, {3.951218558134997*^9, 3.951218559740971*^9}, {
   3.951218610479937*^9, 3.951218718484056*^9}, {3.9512188851629972`*^9, 
