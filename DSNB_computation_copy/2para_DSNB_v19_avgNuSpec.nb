         RowBox[{"(", 
          FractionBox["1", "9"], ")"}]}]}], ";", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"i", ".", "e", ".", " ", "num"}], " ", 
         RowBox[{"p", " ", "/", " ", "kTon"}]}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"signal", " ", "efficiencies"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
