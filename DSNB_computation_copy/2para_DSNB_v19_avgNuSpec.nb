       RowBox[{"~", "1.22"}], "E33", " ", "see", " ", "Li", " ", "et", " ", 
       RowBox[{"al", ".", " ", "2022"}]}], "*)"}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     "]"}]}], ";"}], 
