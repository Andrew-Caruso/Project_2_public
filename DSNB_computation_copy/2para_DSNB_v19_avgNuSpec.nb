   RowBox[{"using", " ", "the", " ", "chosen", " ", "y", " ", 
    RowBox[{"(", "dependent", ")"}], " ", "variable", "\n", "mostly", " ", 
    "copied", " ", "from", " ", "1", "para_DSNB", 
    RowBox[{"_v9", ".", "nb"}], " ", "file", " ", "for", " ", "the", " ", "1",
     " ", "progen", " ", "parameter", " ", "version", " ", "of", " ", "this", 
    " ", "code", "\n", "instead", " ", "of", " ", "rewriting", " ", "the", " ",
     "code", " ", "entirely"}], ",", 
   RowBox[{
   "since", " ", "it", " ", "has", " ", "fixed", " ", "1", " ", "progen", " ",
     "parameter", " ", "just", " ", "append", " ", "this", " ", "code", " ", 
    "with", " ", "a", " ", "general", " ", "form"}]}], "*)"}]], "Input",
