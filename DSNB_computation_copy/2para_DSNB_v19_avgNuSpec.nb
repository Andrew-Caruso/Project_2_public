  RowBox[{"(*", 
   RowBox[{
   "create", " ", "function", " ", "to", " ", "truncate", " ", "numbers", " ",
     "to", " ", "nth", " ", "decimale", " ", "place"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"from", " ", 
     RowBox[{"https", ":"}]}], "//", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"stackoverflow", ".", "com"}], "/", "questions"}], "/", 
       "50313106"}], "/", "truncate"}], "-", "decimal", "-", "numbers", "-", 
     "in", "-", "wolfram", "-", "mathematica"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"truncate", "[", 
    RowBox[{"x_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"IntegerPart", "[", 
      RowBox[{"x", " ", 
       RowBox[{"10", "^", "n"}]}], "]"}], "/", 
     RowBox[{"10", "^", "n"}]}], "]"}]}]}]], "Input",
