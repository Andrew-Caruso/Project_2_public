Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"recall", " ", "neutrino", " ", "sepctrum", " ", 
    RowBox[{"function", ":", " ", 
     RowBox[{"nuSpec", "[", 
      RowBox[{"E_", ",", "Etot_", ",", "Eavg_", ",", "\[Alpha]_"}], "]"}]}]}],
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "recall", " ", "format", " ", "of", " ", "new", " ", "no", " ", "bin", " ",
     "syn", " ", "data", " ", "is", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", ",", "y", ",", "count"}], ")"}], ",", 
      RowBox[{"{", 
       RowBox[{"Etot", ",", "Eavg", ",", "alpha"}], "}"}], ",", "bool"}], 
     ")"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
     "where", " ", "x", " ", "and", " ", "y", " ", "are", " ", "the", " ", 
      "nearest", " ", "values", " ", "in", " ", "progen"}], "+", 
     RowBox[{
     "engine", " ", "data", " ", "to", " ", "bin", " ", "syn", " ", "x", " ", 
      "and", " ", "y", " ", "values"}]}], ",", " ", 
    RowBox[{"keeping", " ", "the", " ", "same", " ", "counts"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"i", ".", "e", ".", " ", "new"}], " ", "bin", " ", "data", " ", 
     "takes", " ", "on", " ", "nearest", " ", "x", " ", "and", " ", "y", " ", 
     "values", " ", "in", " ", "progem"}], "+", 
    RowBox[{"engine", " ", "data"}]}], "*)"}], " ", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"in", " ", "order", " ", "of", " ", 
    RowBox[{"{", 
     RowBox[{"Etotnuebar", ",", "Eavgnuebar", ",", "alpha"}], "}"}]}], "*)"}],
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"nuebar", ":", " ", "1"}], ",", "4", ",", "7"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"nue", ":", " ", "2"}], ",", "5", ",", "8"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"nux", ":", " ", "3"}], ",", "6", ",", "9"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"new", " ", 
    RowBox[{"format", ":", " ", 
     RowBox[{"(", 
      RowBox[{"count", ",", 
       RowBox[{"nuebarSpec", "[", "E", "]"}], ",", 
       RowBox[{"nueSpec", "[", "E", "]"}], ",", 
       RowBox[{"nuxSpec", "[", "E", "]"}], ",", 
       RowBox[{"inside", "-", "bool"}]}], ")"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "get", " ", "neutrino", " ", "spectra", " ", "for", " ", "nuebar"}], ",", 
    "nue", ",", 
    RowBox[{
    "nux", " ", "and", " ", "reformat", " ", "bin", " ", "syn", " ", "data", " ",
      "for", " ", "diff", " ", "cases"}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"NOTE", ":", " ", 
     RowBox[{
     "neglect", " ", "full", " ", "no", " ", "bin", " ", "syn", " ", 
      "range"}]}], ",", " ", 
    RowBox[{
    "since", " ", "it", " ", "makes", " ", "no", " ", "sense", " ", "to", " ",
      "keep"}]}], "*)"}], " ", "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.964361465610458*^9, 3.964361487387207*^9}, {
