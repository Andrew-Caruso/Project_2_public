Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "compute", " ", "event", " ", "rates", " ", "at", " ", "SK_Gd", " ", 
    "without", " ", "outliers"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"recall", " ", "dims"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"DSNB", " ", 
    RowBox[{
     RowBox[{"flux", " ", "~", " ", "MeV"}], "^", 
     RowBox[{"-", "1"}]}], " ", 
    RowBox[{"cm", "^", 
     RowBox[{"-", "2"}]}], " ", 
    RowBox[{"s", "^", 
     RowBox[{"-", "1"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"IBD", " ", "cross", " ", 
    RowBox[{
     RowBox[{"section", " ", "~", " ", "cm"}], "^", "2"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "integrating", " ", "over", " ", "energy", " ", "and", " ", "hitting", " ",
     "with", " ", "cross", " ", "section", " ", "yields"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"event", " ", 
    RowBox[{
     RowBox[{"rate", " ", "~", " ", "events"}], "/", "second"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"need", " ", "to", " ", "convert", " ", "to", " ", 
    RowBox[{"events", "/", "year"}]}], "*)"}]}]], "Input",
 CellChangeTimes->{3.964521719250984*^9},
 CellLabel->
  "In[232]:=",ExpressionUUID->"c4d59604-4729-428c-bc5b-1789abc47905"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"bsEventRateSK", "[", "x3_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"binsynTopName", "=", "x3"}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"quiet", " ", "numerical", " ", "integration", " ", "errors"}],
        "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Quiet", "[", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"without", " ", "MSW", " ", "effect"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"for", " ", "all", " ", "NS", " ", 
          RowBox[{"i", ".", "e", ".", " ", "without"}], " ", "criterion"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"skeventRateAllNSwithout", "=", 
          RowBox[{"yearToSec", "*", 
           RowBox[{"NIntegrate", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"DSNBallNSwithout", "[", 
               RowBox[{"EnuIBD", "[", "x", "]"}], "]"}], "*", "NtSK", "*", 
              RowBox[{"IBDcross", "[", 
               RowBox[{"EnuIBD", "[", "x", "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "EminSKpos", ",", "EmaxSKpos"}], "}"}], ",", 
             RowBox[{"Method", "->", "\"\<Trapezoidal\>\""}], ",", 
             RowBox[{"PrecisionGoal", "->", "2"}], ",", 
             RowBox[{"AccuracyGoal", "->", "20"}]}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"for", " ", "NS"}], "+", 
           RowBox[{"BH", " ", "without", " ", "criterion"}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"skeventRate1Pwithout", "=", 
          RowBox[{"yearToSec", "*", 
           RowBox[{"NIntegrate", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"dsnb2Pwithout", "[", 
               RowBox[{"EnuIBD", "[", "x", "]"}], "]"}], "*", "NtSK", "*", 
              RowBox[{"IBDcross", "[", 
               RowBox[{"EnuIBD", "[", "x", "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "EminSKpos", ",", "EmaxSKpos"}], "}"}], ",", 
             RowBox[{"Method", "->", "\"\<Trapezoidal\>\""}], ",", 
             RowBox[{"PrecisionGoal", "->", "2"}], ",", 
             RowBox[{"AccuracyGoal", "->", "20"}]}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"with", " ", "MSW", " ", "effect"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"for", " ", "IH"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"for", " ", "all", " ", "NS", " ", 
           RowBox[{"i", ".", "e", ".", " ", "without"}], " ", "criterion"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"skeventRateAllNSwithoutIH", "=", 
          RowBox[{"yearToSec", "*", 
           RowBox[{"NIntegrate", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"DSNBallNSwithoutIH", "[", 
               RowBox[{"EnuIBD", "[", "x", "]"}], "]"}], "*", "NtSK", "*", 
              RowBox[{"IBDcross", "[", 
               RowBox[{"EnuIBD", "[", "x", "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "EminSKpos", ",", "EmaxSKpos"}], "}"}], ",", 
             RowBox[{"Method", "->", "\"\<Trapezoidal\>\""}], ",", 
             RowBox[{"PrecisionGoal", "->", "2"}], ",", 
             RowBox[{"AccuracyGoal", "->", "20"}]}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"for", " ", "NS"}], "+", 
           RowBox[{"BH", " ", "without", " ", "criterion"}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"skeventRate1PwithoutIH", "=", 
          RowBox[{"yearToSec", "*", 
           RowBox[{"NIntegrate", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"dsnb2PwithoutIH", "[", 
               RowBox[{"EnuIBD", "[", "x", "]"}], "]"}], "*", "NtSK", "*", 
              RowBox[{"IBDcross", "[", 
               RowBox[{"EnuIBD", "[", "x", "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "EminSKpos", ",", "EmaxSKpos"}], "}"}], ",", 
             RowBox[{"Method", "->", "\"\<Trapezoidal\>\""}], ",", 
             RowBox[{"PrecisionGoal", "->", "2"}], ",", 
             RowBox[{"AccuracyGoal", "->", "20"}]}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"with", " ", "MSW", " ", "effect"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"for", " ", "NH"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"for", " ", "all", " ", "NS", " ", 
           RowBox[{"i", ".", "e", ".", " ", "without"}], " ", "criterion"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"skeventRateAllNSwithoutNH", "=", 
          RowBox[{"yearToSec", "*", 
           RowBox[{"NIntegrate", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"DSNBallNSwithoutNH", "[", 
               RowBox[{"EnuIBD", "[", "x", "]"}], "]"}], "*", "NtSK", "*", 
              RowBox[{"IBDcross", "[", 
               RowBox[{"EnuIBD", "[", "x", "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "EminSKpos", ",", "EmaxSKpos"}], "}"}], ",", 
             RowBox[{"Method", "->", "\"\<Trapezoidal\>\""}], ",", 
             RowBox[{"PrecisionGoal", "->", "2"}], ",", 
             RowBox[{"AccuracyGoal", "->", "20"}]}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"for", " ", "NS"}], "+", 
           RowBox[{"BH", " ", "without", " ", "criterion"}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"skeventRate1PwithoutNH", "=", 
          RowBox[{"yearToSec", "*", 
           RowBox[{"NIntegrate", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"dsnb2PwithoutNH", "[", 
               RowBox[{"EnuIBD", "[", "x", "]"}], "]"}], "*", "NtSK", "*", 
              RowBox[{"IBDcross", "[", 
               RowBox[{"EnuIBD", "[", "x", "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "EminSKpos", ",", "EmaxSKpos"}], "}"}], ",", 
             RowBox[{"Method", "->", "\"\<Trapezoidal\>\""}], ",", 
             RowBox[{"PrecisionGoal", "->", "2"}], ",", 
             RowBox[{"AccuracyGoal", "->", "20"}]}], "]"}]}]}], ";"}], 
        "\[IndentingNewLine]", "]"}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{"end", " ", "quiet"}], "*)"}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"create", " ", "table"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"without", " ", "outliers"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"bsSKeventRateRow1without", "=", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{
           
           RowBox[{"\"\<bin syn without outliers: \>\"", "<>", 
            "binsynTopName"}], 
           ",", "\"\<SK-Gd Event Rates (\!\(\*SuperscriptBox[\(year\), \
\(-1\)]\))\>\"", ",", 
           RowBox[{"\"\<Enu: \>\"", "<>", 
            RowBox[{"ToString", "[", "EminSKnu", "]"}], "<>", "\"\< to \>\"", 
            "<>", " ", 
            RowBox[{"ToString", "[", "EmaxSKnu", "]"}], 
            "<>", "\"\< MeV\>\""}]}], "}"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"bsSKeventRateRow2without", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           
           RowBox[{"\"\<All NS (no MSW)\>\"", ",", "skeventRateAllNSwithout", 
            ",", 
            RowBox[{"\"\<Epos: \>\"", "<>", 
             RowBox[{"ToString", "[", "EminSKpos", "]"}], "<>", "\"\< to \>\"",
              "<>", " ", 
             RowBox[{"ToString", "[", "EmaxSKpos", "]"}], 
             "<>", "\"\< MeV\>\""}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<All NS (NH)\>\"", ",", "skeventRateAllNSwithoutNH"}], 
           "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<All NS (IH)\>\"", ",", "skeventRateAllNSwithoutIH"}], 
           "}"}], ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<NS+BH with criterion (no MSW)\>\"", ",", 
            "skeventRate1Pwithout"}], "}"}], ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<NS+BH with criterion (NH)\>\"", ",", 
            "skeventRate1PwithoutNH"}], "}"}], ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<NS+BH with criterion (IH)\>\"", ",", 
            "skeventRate1PwithoutIH"}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"bsSKeventRateRowswithout", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
         "bsSKeventRateRow1without", ",", "bsSKeventRateRow2without"}], 
         "]"}]}], ";"}]}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"bsSKeventRatewithoutTable", "=", 
       RowBox[{"Grid", "[", 
        RowBox[{"bsSKeventRateRowswithout", ",", 
         RowBox[{"Frame", "->", "All"}]}], "]"}]}], "*)"}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"end", " ", "module"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.96452172596138*^9, 3.964521821641863*^9}, {
  3.964522075933296*^9, 3.964522125652823*^9}},
