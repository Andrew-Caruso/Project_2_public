Cell[TextData[StyleBox["WARNING",
 FontWeight->"Bold",
 FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
 CellChangeTimes->{{3.959423787263575*^9, 
  3.9594237883168163`*^9}},ExpressionUUID->"68c2e904-590c-41a7-9eb0-\
dbeabee394e2"],

Cell["\<\
for the IBD cross section: 
1. replies on interpolation of table 1 in Strumia et al. 2003, same method as \
Nick Ekanger et al. 2024 did 
2. neglects scattering angle (i.e. assume spherically symmetric detector)
3. did not do perform analytically but could via Heston et al. 2023 or Vogel \
et al. 1999
4. Nick Ekanger et al. 2024 assumes perfect efficiency (also assume for \
Hyper-K)\
\>", "Text",
 CellChangeTimes->{{3.959423792429721*^9, 3.959423879294991*^9}, {
  3.959423914064035*^9, 3.9594239655783663`*^9}, {3.959424051665803*^9, 
  3.959424053529931*^9}, {3.959424200398497*^9, 3.959424289797317*^9}, {
  3.960474092311474*^9, 3.960474112816411*^9}, {3.962530964175391*^9, 
  3.962530970809914*^9}, {3.962541624896276*^9, 
  3.9625416303342857`*^9}},ExpressionUUID->"146dad59-7342-4ba1-bf70-\
bb3d7d74a069"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"for", " ", "the", " ", "IBD", " ", "cross", " ", 
    RowBox[{"section", ":", 
     RowBox[{
     "1.", " ", "replies", " ", "on", " ", "interpolation", " ", "of", " ", 
      "table", " ", "1", " ", "in", " ", "Strumia", " ", "et", " ", 
      RowBox[{"al", ".", "2003"}]}]}]}], ",", 
   RowBox[{
   "same", " ", "method", " ", "as", " ", "Nick", " ", "Ekanger", " ", "et", " ", 
    RowBox[{"al", ".", "2024"}], " ", "did", "\n", "2.", " ", "neglects", " ",
     "scattering", " ", "angle", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"i", ".", "e", ".", "assume"}], " ", "spherically", " ", 
      "symmetric", " ", "detector"}], ")"}], "\n", "3.", " ", "did", " ", 
    "not", " ", "do", " ", "perform", " ", "analytically", " ", "but", " ", 
    "could", " ", "via", " ", "Heston", " ", "et", " ", 
    RowBox[{"al", ".", "2023"}], " ", "or", " ", "Vogel", " ", "et", " ", 
    RowBox[{"al", ".", "1999"}]}]}], "*)"}]], "Input",
 CellChangeTimes->{{3.9594244625630903`*^9, 3.95942446517527*^9}},
 CellLabel->
  "In[228]:=",ExpressionUUID->"d866f75a-ecd9-4f36-b3cc-75d0d1c26599"]
}, Closed]],

