Cell[BoxData[
 RowBox[{
  RowBox[{"nobsConstructnuSpec", ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "build", " ", "neutrino", " ", "spectra", " ", "for", " ", "all", " ", 
       "cases", " ", "in", " ", "new", " ", "no", " ", "bin", " ", "syn", " ",
        "data"}], "*)"}], "\[IndentingNewLine]", "\t", 
     RowBox[{"(*", 
      RowBox[{
      "for", " ", "all", " ", "NS", " ", "no", " ", "bin", " ", "syn"}], 
      "*)"}], "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"noallNSnu", "=", 
       RowBox[{"nuSpecBuilder", "[", "noallNSnewData", "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"(*", 
       RowBox[{"for", " ", "NS", " ", 
        RowBox[{"(", 
         RowBox[{"with", " ", "criterion"}], ")"}], " ", "no", " ", "bin", " ",
         "syn"}], "*)"}], "\[IndentingNewLine]", "\t", 
      RowBox[{"noNS2Pnu", "=", 
       RowBox[{"nuSpecBuilder", "[", "noNS2PnewData", "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"(*", 
       RowBox[{"for", " ", "BH", " ", 
        RowBox[{"(", 
         RowBox[{"with", " ", "criterion"}], ")"}], " ", "no", " ", "bin", " ",
         "syn"}], "*)"}], "\[IndentingNewLine]", "\t", 
      RowBox[{"noBH2Pnu", "=", 
       RowBox[{"nuSpecBuilder", "[", "noBH2PnewData", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"discard", " ", "outliers"}], "*)"}], "\[IndentingNewLine]", 
      "\t", 
      RowBox[{"(*", 
       RowBox[{
       "get", " ", "all", " ", "new", " ", "bin", " ", "syn", " ", "data", " ",
         "without", " ", "outliers"}], "*)"}], "\[IndentingNewLine]", "\t", 
      RowBox[{"noallNSnuWithout", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"noallNSnu", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "5", "]"}], "]"}], "==", "True"}], "&"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"noNS2PnuWithout", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"noNS2Pnu", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "5", "]"}], "]"}], "==", "True"}], "&"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"noBH2PnuWithout", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"noBH2Pnu", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "5", "]"}], "]"}], "==", "True"}], "&"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "plots", " ", "for", " ", "single", " ", "nu", " ", "spec", " ", "all",
         " ", "flavors"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "for", " ", "single", " ", "binned", " ", "population", " ", "without",
         " ", "outliers"}], "*)"}], "\[IndentingNewLine]", "\t", 
      RowBox[{"indx", "=", "5"}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"(*", 
       RowBox[{"for", " ", "all", " ", "NS"}], "*)"}], "\[IndentingNewLine]", 
      "\t", 
      RowBox[{"nobsSinglePopAllNSplot", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"noallNSnuWithout", "[", 
              RowBox[{"[", "indx", "]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}], "[", "x", "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"noallNSnuWithout", "[", 
              RowBox[{"[", "indx", "]"}], "]"}], "[", 
             RowBox[{"[", "3", "]"}], "]"}], "[", "x", "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"noallNSnuWithout", "[", 
              RowBox[{"[", "indx", "]"}], "]"}], "[", 
             RowBox[{"[", "4", "]"}], "]"}], "[", "x", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "30"}], "}"}], ",", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           
           RowBox[{"\"\<MeV\>\"", 
            ",", "\"\<\!\(\*SuperscriptBox[\(MeV\), \(-1\)]\)\>\""}], "}"}]}],
          ",", 
         RowBox[{
         "PlotLabel", 
          "->", "\"\<Single Pop all NS without outliers no bin syn\>\""}], ",", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"{", 
           
           RowBox[{"\"\<\!\(\*OverscriptBox[SubscriptBox[\(\[Nu]\), \(e\)], \
\(_\)]\)\>\"", ",", "\"\<\!\(\*SubscriptBox[\(\[Nu]\), \(e\)]\)\>\"", 
            ",", "\"\<\!\(\*SubscriptBox[\(\[Nu]\), \(x\)]\)\>\""}], 
           "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"(*", 
       RowBox[{"for", " ", "NS", " ", 
        RowBox[{"(", 
         RowBox[{"with", " ", "criterion"}], ")"}]}], "*)"}], 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"nobsSinglePopNS2Pplot", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"noNS2PnuWithout", "[", 
