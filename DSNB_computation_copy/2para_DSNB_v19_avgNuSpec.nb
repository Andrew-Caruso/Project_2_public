Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"fixed", " ", "CCSN", " ", "rate", " ", "factor"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"CCSNrateFactor", ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "use", " ", "star", " ", "formation", " ", "rate", " ", "to", " ", 
        "get", " ", "CCSN", " ", "rate"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"star", " ", "formation", " ", "rate", " ", "function"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"from", " ", "Yuksel", " ", "et", " ", 
        RowBox[{"al", ".", " ", "2008"}], 
        " ", "\"\<Revealing the High-Redshift...\>\""}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "star", " ", "formation", " ", "rate", " ", "as", " ", "a", " ", 
        "function", " ", "of", " ", "redshift", " ", "z"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "used", " ", "in", " ", "both", " ", "Kresse", " ", "et", " ", 
        RowBox[{"al", ".", " ", "2021"}], " ", "and", " ", "Horiuchi", " ", 
        "et", " ", 
        RowBox[{"al", ".", " ", "2021"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]dot", "=", 
        RowBox[{
         RowBox[{"\[Rho]0dot", "*", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"1", "+", "#"}], ")"}], 
              RowBox[{"a0", "*", "\[Eta]0"}]], "+", 
             SuperscriptBox[
              RowBox[{"(", 
               FractionBox[
                RowBox[{"1", "+", "#"}], "B0"], ")"}], 
              RowBox[{"b0", "*", "\[Eta]0"}]], "+", 
             SuperscriptBox[
              RowBox[{"(", 
               FractionBox[
                RowBox[{"1", "+", "#"}], "C0"], ")"}], 
              RowBox[{"c0", "*", "\[Eta]0"}]]}], ")"}], 
           RowBox[{"1", "/", "\[Eta]0"}]]}], "&"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "renormalize", " ", "\[Rho]dot", " ", "by", " ", "cancelling", " ", 
          "out", " ", "\[Rho]0dot", " ", "since", " ", "Rcc0"}], ",", " ", 
         RowBox[{
          RowBox[{
          "such", " ", "that", " ", "Rcc", " ", "is", " ", "Rcc0", " ", "at", 
           " ", "z"}], "=", "0"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Rcc", "[", "z_", "]"}], ":=", 
        RowBox[{"Rcc0", "*", 
         RowBox[{
          RowBox[{"\[Rho]dot", "[", "z", "]"}], "/", "\[Rho]0dot"}]}]}], 
       ";"}]}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"CCSN", " ", 
        RowBox[{
         RowBox[{"rate", " ", "~", " ", "Mcp"}], "^", 
         RowBox[{"-", "3"}]}], " ", 
        RowBox[{"year", "^", 
         RowBox[{"-", "1"}]}]}], " ", "->", " ", 
       RowBox[{"MeV", "^", "4"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"LogPlot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Rcc", "[", "z", "]"}], "*", 
          SuperscriptBox["10", "4"], "*", 
          SuperscriptBox["Mpc", "3"], "*", "year"}], ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "0", ",", "5"}], "}"}], ",", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<z\>\"", ",", "\"\<Rate [10^-4 Mpc^-3 yr^-1]\>\""}], 
           "}"}]}], ",", 
         RowBox[{
         "PlotLabel", "->", "\"\<Core Collapse Supernova Rate\>\""}]}], "]"}],
        ";"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], 
   ";"}], 
  RowBox[{"(*", 
   RowBox[{"end", " ", "module"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.964444400556896*^9, 3.964444430480032*^9}, {
  3.964444484151696*^9, 3.964444497240993*^9}, {3.9644446125990887`*^9, 
