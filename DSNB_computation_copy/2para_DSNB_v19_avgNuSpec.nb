       RowBox[{"(*", 
        RowBox[{"num", " ", "p", " ", "targets", " ", "for", " ", "HK"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"NtHK", "=", 
        RowBox[{"fidVolHK", "*", "kTons", "*", "efficiencyHK"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
