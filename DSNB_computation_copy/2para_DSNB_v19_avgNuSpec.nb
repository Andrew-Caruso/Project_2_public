Cell[CellGroupData[{

Cell["IMF weights ", "Subsubsection",
 CellChangeTimes->{{3.9643784875151176`*^9, 3.9643784935266113`*^9}, {
  3.964378552034643*^9, 
  3.9643785537359324`*^9}},ExpressionUUID->"65ce4f37-bfa3-4acc-b375-\
697ab310e323"],

Cell["\<\
get average nuebar spec for progen + engine data (knows BH vs NS) to compute \
DSNB without binary synthesis
BEWARE : bin syn data is already IMF weighted while progen + engine data is NOT
but like no bin syn data, progen+engine data is only single stars
thus do not need renorm fb (to account for binaries in bin syn data)\
\>", "Text",
 CellChangeTimes->{{3.964378690157452*^9, 3.964378692673725*^9}, {
  3.9644391503163767`*^9, 
  3.9644391959388323`*^9}},ExpressionUUID->"3f9ea8fa-0fb1-472c-a051-\
1f5952d3ffca"],

Cell["further comments", "Text",
 CellChangeTimes->{{3.964378849133791*^9, 
  3.9643788508785686`*^9}},ExpressionUUID->"80af2d13-8cce-4c35-864a-\
26d05f3c5934"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "get", " ", "average", " ", "nuebar", " ", "spec", " ", "for", " ", 
     "progen"}], "+", 
    RowBox[{"engine", " ", "data", " ", 
     RowBox[{"(", 
      RowBox[{"knows", " ", "BH", " ", "vs", " ", "NS"}], ")"}], " ", "to", " ",
      "compute", " ", "DSNB", " ", "without", " ", "binary", " ", "synthesis",
      "\n", 
     RowBox[{"BEWARE", ":", 
      RowBox[{
       RowBox[{
       "bin", " ", "syn", " ", "data", " ", "is", " ", "already", " ", "IMF", 
        " ", "weighted", " ", "while", " ", "progen"}], "+", 
       RowBox[{"engine", " ", "data", " ", "is", " ", "NOT"}]}]}]}]}], "*)"}],
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "but", " ", "like", " ", "no", " ", "bin", " ", "syn", " ", "data"}], ",", 
    RowBox[{"progen", "+", 
     RowBox[{
     "engine", " ", "data", " ", "is", " ", "only", " ", "single", " ", 
      "stars", "\n", "thus", " ", "do", " ", "not", " ", "need", " ", 
      "renorm", " ", "fb", " ", 
      RowBox[{"(", 
       RowBox[{
       "to", " ", "account", " ", "for", " ", "binaries", " ", "in", " ", 
        "bin", " ", "syn", " ", "data"}], ")"}]}]}]}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "do", " ", "not", " ", "need", " ", "renormalization", " ", "fb", " ", 
    "used", " ", "in", " ", "bin", " ", "syn", " ", "avg", " ", "observed", " ",
     "nuebar", " ", "spec"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"because", " ", "progen"}], "+", 
    RowBox[{"engine", " ", "or", " ", "Kresse", " ", "et", " ", 
     RowBox[{"al", ".", " ", "2021"}], " ", "data", " ", "is", " ", "single", 
     " ", "stars", " ", "and", " ", "not", " ", "binaries"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"also", " ", "note", " ", "that", " ", "progen"}], "+", 
    RowBox[{
    "engine", " ", "data", " ", "already", " ", "has", " ", "BH", " ", "and", 
     " ", "NS", " ", "together"}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"lastly", ",", " ", 
    RowBox[{
     RowBox[{
     "chosen", " ", "IMF", " ", "is", " ", "Modified", " ", "Salpeter"}], "-", 
     RowBox[{"A", " ", "from", " ", "Kresse", " ", "et", " ", 
      RowBox[{"al", ".", " ", "which"}], " ", "has", " ", "already", " ", 
      "been", " ", "normalized", " ", "to", " ", "the", " ", "Mzams", " ", 
      "bounds", " ", "from", " ", "Kresse", " ", "et", " ", 
      RowBox[{"al", ".", " ", "2021"}], " ", "paper"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "but", " ", "need", " ", "to", " ", "renormalize", " ", "to", " ", 
     "bounds", " ", "in", " ", "progen"}], "+", 
    RowBox[{"engine", " ", "data"}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"create", " ", "IMF", " ", "weight", " ", "functions", " ", 
    RowBox[{"i", ".", "e", ".", " ", "integrals"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "integrate", " ", "IMF", " ", "over", " ", "some", " ", "intermediate", " ",
     "range", " ", "and", " ", "divide", " ", "by", " ", "the", " ", 
    "integral", " ", "of", " ", "the", " ", "IMF", " ", "over", " ", "the", " ",
     "total", " ", "range", " ", "of", " ", "Mzams"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "this", " ", "ratio", " ", "is", " ", "the", " ", "IMF", " ", "wieght", " ",
     "and", " ", "will", " ", "weigh", " ", "each", " ", "neutrino", " ", 
    "spectrum", " ", "accordingly"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"NOTE", ":", " ", 
    RowBox[{
     RowBox[{
     "peMco\[Mu]4Nu", " ", "is", " ", "in", " ", "SAME", " ", "ordering", " ",
       "as", " ", "original", " ", "progen"}], "+", 
     RowBox[{"engine", " ", "data", " ", "comboData"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"thus", " ", "can", " ", "use", " ", "Mzams", " ", "accordingly"}],
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"similar", " ", "to", " ", "Kresse", " ", "et", " ", 
    RowBox[{"al", ".", " ", "2021"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"see", " ", 
    RowBox[{
     RowBox[{"e", ".", "g", ".", " ", "NS"}], "/", "BH"}], " ", "percentages",
     " ", "section", " ", "which", " ", "follows", " ", "Kresse", " ", "et", " ", 
    RowBox[{"al", ".", " ", "2021"}], " ", "exactly"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"here", ",", " ", "however", ",", " ", 
    RowBox[{
    "need", " ", "to", " ", "slightly", " ", "change", " ", "to", " ", "make",
      " ", "the", " ", "IMF", " ", "weights", " ", "normalized", " ", "to", " ",
      "unity"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"they", " ", "computed", " ", 
    RowBox[{"NS", "/", "BH"}], " ", "percentages", " ", "based", " ", "on", " ",
     "IMF", " ", "weighted", " ", "pops"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"NOTE", ":", " ", 
     RowBox[{
     "not", " ", "a", " ", "function", " ", "of", " ", "Mco", " ", "but", " ",
       "of", " ", "Mzams"}]}], ",", " ", 
    RowBox[{"zero", " ", "age", " ", "main", " ", "sequence", " ", "mass"}]}],
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "for", " ", "details", " ", "see", " ", "eqn", " ", "6", " ", "and", " ", 
    "footnote", " ", "9", " ", "of", " ", "kresse", " ", "et", " ", 
    RowBox[{"al", ".", " ", "2021"}]}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.964378860770895*^9, 3.9643788687094173`*^9}, {
  3.964439201743189*^9, 3.9644392033770027`*^9}},
