Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"IMFweights", ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"create", " ", "IMF", " ", "function"}], "*)"}], 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "Mzams", " ", "at", " ", "column", " ", "2", " ", "of", " ", 
         "original", " ", "progen"}], "+", 
        RowBox[{"engine", " ", "data", " ", "comboData"}]}], "*)"}], 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"(*", 
       RowBox[{
       "normalization", " ", "prefactor", " ", "is", " ", "NOT", " ", "the", " ",
         "same", " ", "range", " ", "as", " ", "used", " ", "in", " ", 
        "Kresse", " ", "et", " ", 
        RowBox[{"al", "."}]}], "*)"}], "\[IndentingNewLine]", "\t", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"use", " ", "the", " ", "extrema", " ", "of", " ", "progen"}],
         "+", 
        RowBox[{"engine", " ", "data"}]}], "*)"}], "\[IndentingNewLine]", 
      "\t", 
      RowBox[{
       RowBox[{"prefactorJR", "=", 
        FractionBox["1", 
         RowBox[{"Integrate", "[", 
          RowBox[{
           RowBox[{"modSalpeterA", "[", "x", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "peMinMzams", ",", "peMaxMzams"}], "}"}]}], 
          "]"}]]}], ";", "\[IndentingNewLine]", "\t", 
       RowBox[{"(*", 
        RowBox[{
        "create", " ", "function", " ", "to", " ", "get", " ", "the", " ", 
         "IMF", " ", "weights"}], "*)"}], "\[IndentingNewLine]", "\t", 
       RowBox[{"(*", 
        RowBox[{
        "use", " ", "numerical", " ", "integration", " ", "to", " ", "speed", 
         " ", "up", " ", "the", " ", "process"}], "*)"}], 
       "\[IndentingNewLine]", "\t", 
       RowBox[{
        RowBox[{"IMFnormFunJR", "[", 
         RowBox[{"lower_", ",", "upper_"}], "]"}], ":=", 
        RowBox[{"prefactorJR", "*", 
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{"modSalpeterA", "[", "x", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "lower", ",", "upper"}], "}"}]}], "]"}]}]}], ";",
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "get", " ", "Mzams", " ", "integration", " ", "limits", " ", "for", " ",
          "each", " ", "star"}], "*)"}], "\[IndentingNewLine]", "\t", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"e", ".", "g", ".", " ", "star"}], " ", "has", " ", "Mzams", 
         " ", "of", " ", "9.5", " ", "and", " ", "the", " ", "previous", " ", 
         "has", " ", "9.25", " ", "while", " ", "the", " ", "next", " ", 
         "has", " ", "9.75"}], "*)"}], "\[IndentingNewLine]", "\t", 
       RowBox[{"(*", 
        RowBox[{
        "get", " ", "the", " ", "average", " ", "between", " ", "the", " ", 
         "nearest", " ", "neighbors"}], "*)"}], "\[IndentingNewLine]", "\t", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"which", " ", "is", " ", "9.375", " ", "and", " ", "9.625"}],
          ",", " ", 
         RowBox[{
         "which", " ", "are", " ", "now", " ", "the", " ", "integration", " ",
           "bounds", " ", "for", " ", "the", " ", "star", " ", "with", " ", 
          "Mzams", " ", "of", " ", "9"}], ",", "5"}], "*)"}], 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"(*", 
        RowBox[{"NOTE", ":", " ", 
         RowBox[{
          RowBox[{"peXYnu", " ", 
           RowBox[{"(", 
            RowBox[{"and", " ", "thus", " ", "peCountNuBool"}], ")"}], " ", 
           "is", " ", "in", " ", "SAME", " ", "ordering", " ", "as", " ", 
           "original", " ", "progen"}], "+", 
          RowBox[{"engine", " ", "data", " ", "comboData"}]}]}], "*)"}], 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"(*", 
        RowBox[{
        "thus", " ", "can", " ", "use", " ", "Mzams", " ", "accordingly"}], 
        "*)"}], "\[IndentingNewLine]", "\t", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"general", " ", "format", " ", 
          RowBox[{"{", 
           RowBox[{"previous", ",", " ", "now", ",", " ", "next"}], "}"}]}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"lower", "/", "midpoint1"}], ",", " ", 
           RowBox[{"upper", "/", "midpoint2"}]}], "}"}]}], "*)"}], 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "EXCLUDING", " ", "first", " ", "and", " ", "last", " ", "Mzams"}], ",",
          " ", 
         RowBox[{"i", ".", "e", ".", " ", "extrema"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"excludeEndsPEMzamsList", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"comboData", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"i", "-", "1"}], ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"comboData", "[", 
