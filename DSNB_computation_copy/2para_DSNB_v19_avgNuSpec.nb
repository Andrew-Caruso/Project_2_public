         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "30"}], "}"}], ",", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           
           RowBox[{"\"\<MeV\>\"", 
            ",", "\"\<\!\(\*SuperscriptBox[\(MeV\), \(-1\)]\)\>\""}], "}"}]}],
          ",", 
         RowBox[{
         "PlotLabel", 
          "->", "\"\<Single Pop NS (2P criterion) without outliers no bin syn\
\>\""}], ",", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"{", 
           
           RowBox[{"\"\<\!\(\*OverscriptBox[SubscriptBox[\(\[Nu]\), \(e\)], \
\(_\)]\)\>\"", ",", "\"\<\!\(\*SubscriptBox[\(\[Nu]\), \(e\)]\)\>\"", 
            ",", "\"\<\!\(\*SubscriptBox[\(\[Nu]\), \(x\)]\)\>\""}], 
           "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"(*", 
       RowBox[{"for", " ", "BH", " ", 
        RowBox[{"(", 
         RowBox[{"with", " ", "criterion"}], ")"}]}], "*)"}], 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"nobsSinglePopBH2Pplot", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
