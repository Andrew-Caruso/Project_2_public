Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"since", " ", "Kresse", " ", "et", " ", 
    RowBox[{"al", ".", " ", "2021"}], " ", "do", " ", "not", " ", "compute", " ",
     "event", " ", "rates"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "instead", " ", "they", " ", "look", " ", "at", " ", "the", " ", "energy", 
    " ", "integrated", " ", "DSNB", " ", "flux"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "see", " ", "table", " ", "6", " ", "in", " ", "Kresse", " ", "et", " ", 
    RowBox[{"al", ".", " ", "2021"}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "regarding", " ", "superkamiokande", " ", "gadolinium", " ", "doped", " ", 
    "upper", " ", "limit", " ", "energy", " ", "range"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"see", " ", "Kresse", " ", "et", " ", 
    RowBox[{"al", ".", " ", "2021"}], " ", "section", " ", "8"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"SK", "-", 
    RowBox[{"Gd", " ", "gound", " ", "from", " ", "Bays", " ", "et", " ", 
     RowBox[{"al", ".", " ", "2012"}], " ", "is"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "nuebar", " ", "DSNB", " ", "flux", " ", "integrated", " ", "above", " ", 
    "17.3", " ", "MeV"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"must", " ", "be", " ", "below", " ", "2.8"}], "-", 
    RowBox[{"3.1", " ", 
     RowBox[{"cm", "^", 
      RowBox[{"-", "2"}]}], " ", 
     RowBox[{"s", "^", 
      RowBox[{"-", "1"}]}]}]}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.964464224392672*^9, 3.964464263158374*^9}},
