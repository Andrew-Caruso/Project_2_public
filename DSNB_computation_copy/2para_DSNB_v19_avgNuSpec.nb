         RowBox[{"al", ".", " ", "2024"}], " ", "and", " ", "Li", " ", "et", " ", 
         RowBox[{"al", ".", " ", "2022"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"efficiencySKGd", "=", "0.5"}], ";", "\[IndentingNewLine]", 
       RowBox[{"efficiencyJ", " ", "=", " ", "0.5"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"efficiencyHK", "=", "0.5"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
