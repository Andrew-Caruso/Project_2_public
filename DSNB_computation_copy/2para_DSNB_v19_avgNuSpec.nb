            "}"}], ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<NS+BH 2P crit without outliers\>\"", ",", 
            "NSBH2PfbWithout"}], "}"}]}], "}"}]}], ";", "\[IndentingNewLine]",
        "\t", 
       RowBox[{"table5Rows", "=", 
        RowBox[{"Join", "[", 
