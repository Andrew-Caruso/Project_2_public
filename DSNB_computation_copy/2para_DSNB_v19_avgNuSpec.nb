       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "for", " ", "single", " ", "indep", " ", "x", " ", "and", " ", "dep", 
         " ", "y", " ", "values"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
