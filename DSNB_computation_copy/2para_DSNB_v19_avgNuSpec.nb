Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"renormConstfb", "[", "x_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"binsynTopName", "=", "x"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"get", " ", "bin", " ", "syn", " ", "pops"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"noBinaryPop", "=", 
        RowBox[{"Length", "[", "noBinSynData", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"noBinaryPopWithout", "=", 
        RowBox[{"Total", "[", 
         RowBox[{"nobsNewDataWithout", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1", ",", "3"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"bsTotPop", "=", 
        RowBox[{"Length", "[", "binSynData", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"bsTotPopWithout", "=", 
        RowBox[{"Total", "[", 
         RowBox[{"bsNewDataWithout", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1", ",", "3"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"get", " ", "the", " ", "different", " ", "binary"}], "-", 
         RowBox[{"noBinary", " ", "renorm", " ", "const", " ", "fb"}]}], 
        "*)"}], "\[IndentingNewLine]", "\t\t", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "since", " ", "no", " ", "pops", " ", "are", " ", "lost", " ", "in", 
          " ", "bin", " ", "syn", " ", "data", " ", "WITH", " ", "outliers"}],
          ",", " ", 
         RowBox[{
          RowBox[{"all", " ", "NS", " ", "pop"}], " ", "=", " ", 
          RowBox[{
           RowBox[{"all", " ", "BH", " ", "pop"}], " ", "=", " ", 
           RowBox[{
            RowBox[{"BH", "+", 
             RowBox[{"NS", " ", 
              RowBox[{"(", 
               RowBox[{"with", " ", "crit"}], ")"}], " ", "pop"}]}], " ", "=",
             " ", 
            RowBox[{"tot", " ", "bin", " ", "syn", " ", "pop"}]}]}]}]}], 
        "*)"}], "\[IndentingNewLine]", "\t\t", 
       RowBox[{"(*", 
        RowBox[{"however", ",", " ", 
         RowBox[{
         "cannot", " ", "use", " ", "total", " ", "no", " ", "bin", " ", 
          "syn", " ", "pop", " ", "for", " ", "denominator", " ", "when", " ",
           "doing", " ", "WITHOUT", " ", "outliers"}], ",", " ", 
         RowBox[{
         "since", " ", "this", " ", "pops", " ", "diff", " ", "now"}]}], 
        "*)"}], "\[IndentingNewLine]", "\t\t", 
       RowBox[{"(*", 
        RowBox[{"with", " ", "outliers", " ", 
         RowBox[{"(", 
          RowBox[{"by", " ", "default"}], ")"}]}], "*)"}], 
       "\[IndentingNewLine]", "\t\t", 
       RowBox[{"(*", 
        RowBox[{"for", " ", "entire", " ", "bin", " ", "syn", " ", "pop"}], 
        "*)"}], "\[IndentingNewLine]", "\t\t", 
       RowBox[{"fbTot", "=", 
        RowBox[{"N", "[", 
         RowBox[{"bsTotPop", "/", "noBinaryPop"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\t\t", 
       RowBox[{"allNSfb", "=", 
        RowBox[{"N", "[", 
         RowBox[{"allNSpop", "/", "noBinaryPop"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\t\t", 
       RowBox[{"NSBH2Pfb", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"NS2Ppop", "+", "BH2Ppop"}], ")"}], "/", "noBinaryPop"}], 
         "]"}]}], ";", "\[IndentingNewLine]", "\t\t", 
       RowBox[{"(*", 
        RowBox[{"without", " ", "outliers"}], "*)"}], "\[IndentingNewLine]", 
       "\t\t", 
       RowBox[{"(*", 
        RowBox[{"for", " ", "entire", " ", "bin", " ", "syn", " ", "pop"}], 
        "*)"}], "\[IndentingNewLine]", "\t\t", 
       RowBox[{"fbTotWithout", "=", 
        RowBox[{"N", "[", 
         RowBox[{"bsTotPopWithout", "/", "noBinaryPopWithout"}], "]"}]}], ";",
        "\[IndentingNewLine]", "\t\t", 
       RowBox[{"allNSfbWithout", "=", 
        RowBox[{"N", "[", 
         RowBox[{"allNSpopWithout", "/", "noallNSpopWithout"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\t\t", 
       RowBox[{"NSBH2PfbWithout", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"NS2PpopWithout", "+", "BH2PpopWithout"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"noNS2PpopWithout", "+", "noBH2PpopWithout"}], ")"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", "\t\t", 
       RowBox[{"(*", 
        RowBox[{"NOTE", ":"}], " ", "*)"}], "\[IndentingNewLine]", "\t\t", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"for", " ", "without", " ", "outliers"}], ",", " ", 
         RowBox[{
         "used", " ", "corresponding", " ", "pop", " ", "instead", " ", "of", 
          " ", "no", " ", "bin", " ", "syn", " ", "pop", " ", "without", " ", 
          "outliers"}]}], "*)"}], "\[IndentingNewLine]", "\t\t", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "because", " ", "the", " ", "no", " ", "bin", " ", "syn", " ", 
          "data", " ", "without", " ", "outliers", " ", "looks", " ", "at", " ",
           "entire", " ", "extrema", " ", "range", " ", "in", " ", "progen"}],
          "+", 
