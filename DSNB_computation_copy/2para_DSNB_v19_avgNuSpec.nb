    "N_targets", " ", "*", " ", "IBD_crossSection", " ", "*", " ", "DSNB", " ",
      "flux", " ", "nuebar", " ", "integrated", " ", "over", " ", "positron", 
     " ", "energy"}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"IBD", " ", "cross", " ", "section", " ", "function", " ", 
     RowBox[{"sigma", "[", "Enu", "]"}]}], ",", " ", 
    RowBox[{"IBD", " ", "positron", " ", "energy", " ", 
