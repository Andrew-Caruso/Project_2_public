Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"intDSNBlistMod", "[", "x_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"data", "=", "x"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"intDSNBlist", "=", 
        RowBox[{"{", 
         RowBox[{"{", 
          
          RowBox[{"\"\<case\>\"", ",", "\"\<scenario\>\"", 
           ",", "\"\<integrated DSNB\>\"", ",", "\"\<iteration\>\"", 
           ",", "\"\<i,j,k indices\>\""}], "}"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"counter2", "=", "0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"counter2", "=", 
           RowBox[{"counter2", "+", "1"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"intDSNBlist", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Flatten", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"data", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", "1"}], "]"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"data", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"2", ",", "k", ",", "2", ",", "1"}], "]"}], "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"Flatten", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"data", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "k", ",", "2", ",", "1"}], "]"}], "]"}],
                    "[", 
                   RowBox[{"[", 
                    RowBox[{"3", ";;", "4"}], "]"}], "]"}], "[", 
                  RowBox[{"[", 
                   RowBox[{"-", "1"}], "]"}], "]"}], ",", "1"}], "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", "counter2", ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "j", ",", "k"}], "}"}]}], "}"}]}], "]"}]}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"ith", " ", "case"}], ",", " ", 
           RowBox[{
            RowBox[{"jth", " ", 
             RowBox[{"allNS", "/", "BH"}]}], "+", "NS"}], ",", " ", 
           RowBox[{"kth", " ", 
            RowBox[{
             RowBox[{"noMSW", "/", "IH"}], "/", "NH"}]}]}], "*)"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "data", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "2", ",", "3"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "3"}], "}"}]}], "\[IndentingNewLine]", 
        "]"}], ";", 
       RowBox[{"(*", 
        RowBox[{"end", " ", "do", " ", "loop"}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"output", " ", "list"}], "*)"}], "\[IndentingNewLine]", 
       "intDSNBlist"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"end", " ", "module"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.968234672777782*^9, 3.9682347144281883`*^9}, {
  3.968234789332089*^9, 3.9682348189883347`*^9}, {3.968234901107567*^9, 
