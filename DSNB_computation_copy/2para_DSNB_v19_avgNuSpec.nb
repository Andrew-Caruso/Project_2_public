Cell[CellGroupData[{

Cell["Extract NS and BH pops", "Subsubsection",
 CellChangeTimes->{{3.9467257219422483`*^9, 3.946725756523641*^9}, {
  3.946727001432228*^9, 3.946727005033482*^9}, {3.946735265825695*^9, 
  3.946735270058169*^9}},ExpressionUUID->"2575a235-508f-4813-8ffd-\
d704e4762279"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MatrixForm", "[", "comboColumns", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.964013839781699*^9, 3.96401386460569*^9}, 
   3.964013913215848*^9},
 CellLabel->
  "In[123]:=",ExpressionUUID->"575a6ba6-a880-4cef-b98b-bb8387ac5470"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"extractNSBHpops", "[", "x_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"chosenMbaryLim", "=", "x"}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "Get", " ", "NS", " ", "and", " ", "BH", " ", "pops", " ", "from", " ",
          "progen"}], "+", 
        RowBox[{"engine", " ", "data"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"For", " ", "NS", " ", "pops"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"NScomboData", " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"comboData", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "15", "]"}], "]"}], "==", "\"\<NS\>\""}], "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"NScomboData", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "15"}], "]"}], "]"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"For", " ", "BH", " ", "pops"}], "*)"}], 
       "\[IndentingNewLine]", 
