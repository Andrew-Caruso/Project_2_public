Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"for", " ", "normal", " ", "hierarchy", " ", "NH"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"observed", " ", "nuebar", " ", 
     RowBox[{"flux", " ", "~", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"cos", 
         RowBox[{"(", 
          SubscriptBox["\[Theta]", "12"], ")"}]}], ")"}], "2"]}], " ", 
     "nuebar", " ", "flux"}], " ", "+", " ", 
