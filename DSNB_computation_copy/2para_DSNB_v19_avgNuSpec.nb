            RowBox[{"1", "+", "1"}], ",", 
            RowBox[{
             RowBox[{"Length", "[", "comboData", "]"}], "-", "1"}]}], "}"}]}],
          "]"}]}], ";", "\[IndentingNewLine]", "\t", 
       RowBox[{"(*", 
        RowBox[{"add", " ", "in", " ", "extrema"}], "*)"}], 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"(*", 
        RowBox[{"prepend", " ", "the", " ", "min", " ", "Mzams"}], "*)"}], 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"TEMPpeMzamsList", "=", 
        RowBox[{"Prepend", "[", 
         RowBox[{"excludeEndsPEMzamsList", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Null", ",", 
              RowBox[{"comboData", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"comboData", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"comboData", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"comboData", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "2"}], "]"}], "]"}], "+", 
                 RowBox[{"comboData", "[", 
                  RowBox[{"[", 
                   RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ")"}], "/", 
               "2"}]}], "}"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]",
        "\t", 
       RowBox[{"(*", 
        RowBox[{"append", " ", "the", " ", "max", " ", "Mzams"}], "*)"}], 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"peMzamsList", "=", 
        RowBox[{"Append", "[", 
         RowBox[{"TEMPpeMzamsList", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"comboData", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"-", "2"}], ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"comboData", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}], ",", "Null"}], 
             "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"comboData", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"-", "2"}], ",", "2"}], "]"}], "]"}], "+", 
                 RowBox[{"comboData", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}]}], ")"}], "/",
                "2"}], ",", 
              RowBox[{"comboData", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}]}], "}"}]}], 
           "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"finally", " ", "get", " ", "IMF", " ", "weights"}], "*)"}], 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"format", " ", 
          RowBox[{"{", 
           RowBox[{"previous", ",", " ", "now", ",", " ", "next"}], "}"}]}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"lower", "/", "midpoint1"}], ",", " ", 
           RowBox[{"upper", "/", "midpoint2"}]}], "}"}]}], "*)"}], 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"peMzamsList", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
       "\t", 
       RowBox[{"peIMFweights", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"IMFnormFunJR", "[", 
           RowBox[{
            RowBox[{"peMzamsList", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "2", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"peMzamsList", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "2", ",", "2"}], "]"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "peMzamsList", "]"}]}], "}"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", "\t", 
       RowBox[{"(*", 
        RowBox[{"confirm", " ", "no", " ", "lost", " ", "stars"}], "*)"}], 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"Length", "[", "peIMFweights", "]"}], ";", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"Length", "[", "comboData", "]"}], ";", "\[IndentingNewLine]", 
       "\t", 
       RowBox[{"(*", 
        RowBox[{
        "confirm", " ", "it", " ", "is", " ", "properly", " ", "normalized", " ",
          "to", " ", "unity"}], "*)"}], "\[IndentingNewLine]", "\t", 
       RowBox[{"Total", "[", "peIMFweights", "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "to", " ", "confirm", " ", "IMF", " ", "weights", " ", "are", " ", 
         "correct"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "compare", " ", "percentages", " ", "of", " ", "BH", " ", "and", " ", 
         "NS", " ", "to", " ", "Kresse", " ", "et", " ", 
         RowBox[{"al", ".", "2021"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"i", ".", "e", ".", " ", "check"}], " ", "IMF", " ", 
         "weighted", " ", "NS", " ", "and", " ", "BH", " ", "pops"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "in", " ", "order", " ", "to", " ", "compare", " ", "percentages", " ",
          "of", " ", "BH", " ", "and", " ", "NS", " ", "to", " ", "Kresse", " ",
          "et", " ", 
         RowBox[{"al", ".", "2021"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"note", " ", "that", " ", "progen"}], "+", 
          RowBox[{
          "engine", " ", "data", " ", "comboData", " ", "is", " ", "in", " ", 
           "SAME", " ", "order", " ", "as", " ", "peIMFweights"}]}], ",", " ", 
         RowBox[{"thus", " ", "can", " ", "merge", " ", "accordingly"}]}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"format", " ", "of", " ", 
         RowBox[{"{", 
          RowBox[{"weight", ",", " ", 
           RowBox[{"BH", "/", "NS"}]}], "}"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"peWeightNSBH", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"peIMFweights", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"comboData", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "15"}], "]"}], "]"}], "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "comboData", "]"}]}], "}"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"separate", " ", "BH", " ", "and", " ", "NS", " ", "pops"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"peWeightNS", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"peWeightNSBH", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "==", "\"\<NS\>\""}], "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"peWeightBH", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"peWeightNSBH", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "==", "\"\<BH\>\""}], "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"IMF", " ", "weighted", " ", "percents"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"each", " ", "is", " ", "a", " ", "single", " ", "star"}], ",",
          " ", 
         RowBox[{
         "thus", " ", "sum", " ", "up", " ", "the", " ", "relevant", " ", 
          "weights"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"peIMFweightedNSfrac", "=", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"peWeightNS", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "peWeightNS", "]"}]}], "}"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"peIMFweightedBHfrac", "=", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"peWeightBH", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "peWeightBH", "]"}]}], "}"}]}], "]"}]}], 
       ";"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], ";"}], 
  
  RowBox[{"(*", 
   RowBox[{"end", " ", "module"}], "*)"}]}]], "Input",
