  RowBox[{"(*", 
   RowBox[{"NOTE", ":", " ", 
    RowBox[{
    "there", " ", "is", " ", "a", " ", "speed", " ", "of", " ", "light", " ", 
     "c", " ", "factor", " ", "if", " ", "converting", " ", "completely", " ",
      "back", " ", "to", " ", "SI", " ", "or", " ", "CGS"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"but", " ", "want", " ", "to", " ", "keep", " ", 
    RowBox[{"MeV", "^", 
     RowBox[{"-", "1"}]}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"NOTE", ":", " ", 
    RowBox[{"need", " ", "to", " ", "redshift", " ", 
