Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"intDSNBpe", ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Quiet", "[", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "integrate", " ", "DSNB", " ", "flux", " ", "from", " ", "progen"}],
           "+", 
          RowBox[{
          "engine", " ", "data", " ", "over", " ", "entire", " ", "range"}]}],
          "*)"}], "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"without", " ", "MSW", " ", "effect"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"int1030PEdsnb", "=", 
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{"peDSNB", "[", "x", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "EminKresse", ",", "EmaxKresse"}], "}"}], ",", 
            
            RowBox[{"Method", "->", "\"\<Trapezoidal\>\""}], ",", 
            RowBox[{"PrecisionGoal", "->", "2"}], ",", 
            RowBox[{"AccuracyGoal", "->", "20"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"with", " ", "MSW", " ", "effect"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"for", " ", "IH"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"int1030PEdsnbIH", "=", 
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{"peDSNBIH", "[", "x", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "EminKresse", ",", "EmaxKresse"}], "}"}], ",", 
            
            RowBox[{"Method", "->", "\"\<Trapezoidal\>\""}], ",", 
            RowBox[{"PrecisionGoal", "->", "2"}], ",", 
            RowBox[{"AccuracyGoal", "->", "20"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"with", " ", "MSW", " ", "effect"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"for", " ", "NH"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"int1030PEdsnbNH", "=", 
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{"peDSNBNH", "[", "x", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "EminKresse", ",", "EmaxKresse"}], "}"}], ",", 
            
            RowBox[{"Method", "->", "\"\<Trapezoidal\>\""}], ",", 
            RowBox[{"PrecisionGoal", "->", "2"}], ",", 
            RowBox[{"AccuracyGoal", "->", "20"}]}], "]"}]}], ";"}], 
        "\[IndentingNewLine]", "]"}], ";", 
       RowBox[{"(*", 
        RowBox[{"end", " ", "quiet"}], "*)"}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"make", " ", "table"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"peIntDSNBrow", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           
           RowBox[{"\"\<progen+engine\>\"", 
            ",", "\"\<energy integrated DSNB (\!\(\*SuperscriptBox[\(cm\), \
\(-2\)]\)\!\(\*SuperscriptBox[\(s\), \(-1\)]\))\>\"", 
            ",", "\"\<energy bounds\>\""}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<IH\>\"", ",", "int1030PEdsnbIH", ",", 
            RowBox[{
             RowBox[{"ToString", "[", "EminKresse", "]"}], 
             "<>", "\"\< to \>\"", "<>", 
             RowBox[{"ToString", "[", "EmaxKresse", "]"}], 
             "<>", "\"\< MeV\>\""}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<NH\>\"", ",", "int1030PEdsnbNH", ",", 
            RowBox[{
             RowBox[{"ToString", "[", "EminKresse", "]"}], 
             "<>", "\"\< to \>\"", "<>", 
             RowBox[{"ToString", "[", "EmaxKresse", "]"}], 
             "<>", "\"\< MeV\>\""}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<without MSW\>\"", ",", "int1030PEdsnb", ",", 
            RowBox[{
             RowBox[{"ToString", "[", "EminKresse", "]"}], 
             "<>", "\"\< to \>\"", "<>", 
             RowBox[{"ToString", "[", "EmaxKresse", "]"}], 
             "<>", "\"\< MeV\>\""}]}], "}"}]}], "}"}]}], ";"}]}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"peInDSNBTable", "=", 
        RowBox[{"Grid", "[", 
         RowBox[{"peIntDSNBrow", ",", 
          RowBox[{"Frame", "->", "All"}]}], "]"}]}], ";"}], "*)"}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"end", " ", "of", " ", "module"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.964464265545169*^9, 3.9644643207078333`*^9}, {
  3.964464709821663*^9, 3.964464724419799*^9}},
 CellLabel->
  "In[223]:=",ExpressionUUID->"ff4ef0ff-2b5d-4217-a154-193c71af530f"]
}, Closed]],

