            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ">", 
            RowBox[{"criter2P", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "&"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "bin", " ", "both", " ", "x", " ", "and", " ", "y", " ", "vars", " ", 
         "simultaenously"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"recall", " ", "format", " ", 
         RowBox[{"(", 
          RowBox[{"x", ",", "y"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"NScounts", "=", 
        RowBox[{"BinCounts", "[", 
         RowBox[{"NS2P", ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "maxXround", ",", "\[CapitalDelta]x"}], "}"}], ",", 
