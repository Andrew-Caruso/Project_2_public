Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"defCheck2Pcrit", "[", 
     RowBox[{"x_", ",", "k_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"engineName", "=", "x"}], ",", 
        RowBox[{"boolis2Pcrit", "=", "k"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "chose", " ", "1", " ", "parameter", " ", "or", " ", "2", " ", 
        "parameter", " ", "criterion", " ", "based", " ", "on", " ", "input", 
        " ", "boolean"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"select", " ", "1", " ", "parameter", " ", "criterion", " ", 
        RowBox[{"(", "mu4", ")"}], " ", "or", " ", "select", " ", "2", " ", 
        "parameter", " ", "criterion", " ", 
        RowBox[{"(", 
         RowBox[{"mu4", "[", 
          RowBox[{"mu4", "*", "m4"}], "]"}], ")"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"do", " ", "not", " ", "relabel", " ", "variable", " ", 
        RowBox[{"(", 
         RowBox[{"originally", " ", "only", " ", "2", "P", " ", "criterion"}],
          ")"}], " ", "for", " ", "sake", " ", "of", " ", "safety"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"boolis2Pcrit", "==", "1"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"criter2P", "=", "tempCutFun"}], " ", ";", 
          "\[IndentingNewLine]", 
          RowBox[{"criter2Pname", "=", "tempCutName"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"chosenSuccessFrac", "=", 
           RowBox[{"slopeYinterSuccess", "[", 
            RowBox[{"[", 
             RowBox[{"optIndex", ",", "2"}], "]"}], "]"}]}], ";"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"(*", "otherwise", "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"criter2P", " ", "=", " ", "criter1PFun"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"criter2Pname", "=", "yAxis"}], ";", "\[IndentingNewLine]", 
          
          RowBox[{"chosenSuccessFrac", "=", "maxSuccessFrac"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "create", " ", "2", "D", " ", "histograms", " ", "for", " ", "x", " ",
          "value"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"recall", " ", "format", " ", "of", " ", 
         RowBox[{"comboDataJR", ":", " ", 
          RowBox[{"(", 
           RowBox[{"xVar", ",", "Yvar", ",", 
            RowBox[{"BH", "/", "NS"}]}], ")"}]}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"for", " ", "all", " ", "progen"}], "+", 
         RowBox[{"engine", " ", "data"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Histogram", "[", 
        RowBox[{
         RowBox[{"comboDataJR", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", "35", ",", 
         RowBox[{
         "PlotLabel", "->", "\"\<Total pop in Progen+Engine Data\>\""}], ",", 
         
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           RowBox[{"xAxis", ",", "\"\<Count\>\""}], "}"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
