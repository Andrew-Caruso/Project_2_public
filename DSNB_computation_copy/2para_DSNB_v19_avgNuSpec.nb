             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", 
               RowBox[{"Length", "[", "binSynData", "]"}]}], "}"}]}], "]"}]}],
           ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
     RowBox[{"(*", 
      RowBox[{"end", " ", "if", " ", "branch"}], "*)"}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"end", " ", "module"}], "*)"}]}]], "Input",
