         RowBox[{"with", " ", "1", " ", "parameter", " ", "criterion"}], 
         ")"}], " ", "with", " ", "outliers", " ", "relocated"}], "*)"}], 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"BH2PnuebarAVGwithout", "=", 
       RowBox[{
        RowBox[{"NSBH2PfbWithout", "*", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"BH2PnuWithout", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "1"}], "]"}], "]"}], "*", 
            RowBox[{
             RowBox[{
              RowBox[{"BH2PnuWithout", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}], "[", "#", "]"}], "/", 
             RowBox[{"(", 
              RowBox[{"NS2PpopWithout", "+", "BH2PpopWithout"}], ")"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "BH2PnuWithout", "]"}]}], "}"}]}], 
          "]"}]}], "&"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"create", " ", "plots"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "plot", " ", "observed", " ", "nuebar", " ", "spec", " ", "without", " ",
         "outliers"}], "*)"}], "\[IndentingNewLine]", "\t", 
      RowBox[{"bsAvgNuebarAllNSplot", "=", " ", 
