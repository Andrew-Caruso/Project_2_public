Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"reformBSdata", ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"change", " ", "progen"}], "+", 
        RowBox[{
        "engine", " ", "index", " ", "to", " ", "bin", " ", "syn", " ", 
         "index"}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "for", " ", "single", " ", "indep", " ", "x", " ", "and", " ", 
        "single", " ", "dep", " ", "y", " ", "values"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"productXbool", "==", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"bsXindx", "=", 
           RowBox[{"xIndx", "-", "4"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"bsYindx", "=", 
           RowBox[{"yIndx", "-", "4"}]}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", 
       RowBox[{"(*", 
        RowBox[{"end", " ", "if", " ", "branch"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "for", " ", "product", " ", "indep", " ", "x", " ", "and", " ", 
         "single", " ", "dep", " ", "y", " ", "values"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"productXbool", "==", "1"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"bsXindx1", "=", 
           RowBox[{"xIndx1", "-", "4"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"bsXindx2", "=", 
           RowBox[{"xIndx2", "-", "4"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"bsYindx", "=", 
           RowBox[{"yIndx", "-", "4"}]}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", 
       RowBox[{"(*", 
        RowBox[{"end", " ", "if", " ", "branch"}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "reformat", " ", "bin", " ", "syn", " ", "data", " ", "into", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"x", " ", "indep", " ", "var"}], ",", " ", 
           RowBox[{"y", " ", "dep", " ", "var"}]}], ")"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "where", " ", "these", " ", "variables", " ", "are", " ", "the", " ",
           "chosen", " ", "progen", " ", "vars", " ", "for", " ", "the", " ", 
          "criterion", " ", 
          RowBox[{"y", "[", "x", "]"}]}], "=", 
         RowBox[{"mx", "+", "b"}]}], "*)"}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "for", " ", "single", " ", "indep", " ", "x", " ", "and", " ", "dep", 
         " ", "y", " ", "values"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"productXbool", "==", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"binSynDataJR", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"binSynData", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "bsXindx"}], "]"}], "]"}], ",", 
               RowBox[{"binSynData", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "bsYindx"}], "]"}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", 
               RowBox[{"Length", "[", "binSynData", "]"}]}], "}"}]}], "]"}]}],
           ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       RowBox[{"(*", 
        RowBox[{"end", " ", "if", " ", "branch"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "for", " ", "product", " ", "indep", " ", "x", " ", "and", " ", 
         "single", " ", "dep", " ", "y", " ", "values"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"productXbool", "==", "1"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"binSynDataJR", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"binSynData", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "bsXindx1"}], "]"}], "]"}], "*", 
                RowBox[{"binSynData", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "bsXindx2"}], "]"}], "]"}]}], ",", 
               RowBox[{"binSynData", "[", 
                RowBox[{"[", 
