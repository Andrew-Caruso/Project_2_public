Cell[CellGroupData[{

Cell["outlierCheck Extractor", "Subsubsection",
 CellChangeTimes->{{3.964685569320479*^9, 
  3.964685577535718*^9}},ExpressionUUID->"94c049da-e9c3-4158-880b-\
60b3925d4ab0"],

Cell["\<\
takes in outliers check (from all runs in loop) and returns a table of \
combined stats for each case\
\>", "Text",
 CellChangeTimes->{{3.964685600288499*^9, 
  3.9646856376775427`*^9}},ExpressionUUID->"c5d1fe56-dcfe-4f7b-8564-\
9ab24fae1eca"],

Cell["can run for bin syn or no bin syn ", "Text",
 CellChangeTimes->{{3.964685641457995*^9, 
  3.964685658615553*^9}},ExpressionUUID->"954930c4-8b06-4286-a96c-\
3043c7d34d5d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"outlierCheckExactor", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"checkTabRows", "=", "x"}], ",", 
       RowBox[{"caseName", "=", "y"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"create", " ", "empty", " ", "output"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"outputOutliersRow", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "get", " ", "only", " ", "relevant", " ", "entries", " ", "and", " ", 
        "group", " ", "by", " ", "case"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"tempOutputRows", "=", 
       RowBox[{"GroupBy", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"checkTabRows", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", 
                RowBox[{"4", ";;", 
                 RowBox[{"-", "1"}]}]}], "]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", 
               RowBox[{"Length", "[", "checkTabRows", "]"}]}], "}"}]}], "]"}],
            ",", "1"}], "]"}], ",", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"add", " ", "titles", " ", "of", " ", "new", " ", "table"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"outputOutliersRow", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"caseName", "<>", "\"\< for all models\>\""}], 
          ",", "\"\<Min\>\"", ",", "\"\<Max\>\"", ",", "\"\<Avg\>\"", 
          ",", "\"\<STD\>\""}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"loop", " ", "over", " ", "all", " ", "cases"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"title", " ", "of", " ", "each", " ", "case"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"tempTitle", "=", 
          RowBox[{"DeleteDuplicates", "[", 
           RowBox[{
            RowBox[{"tempOutputRows", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "divide", " ", "out", " ", "%", " ", "to", " ", "ensure", " ", "no",
            " ", "math", " ", "issues"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"tempPercents", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"tempOutputRows", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "4"}], "]"}], "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"100", "*", "\"\<%\>\""}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"tempPercentsRow", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"tempTitle", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"Min", "[", "tempPercents", "]"}], "*", 
             "100", "\"\<%\>\""}], ",", 
            RowBox[{
             RowBox[{"Max", "[", "tempPercents", "]"}], "*", 
             "100", "\"\<%\>\""}], ",", 
            RowBox[{
             RowBox[{"Mean", "[", "tempPercents", "]"}], "*", 
             "100", "\"\<%\>\""}], ",", 
            RowBox[{
             RowBox[{"StandardDeviation", "[", "tempPercents", "]"}], "*", 
             "100", "\"\<%\>\""}]}], "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"outputOutliersRow", ",", "tempPercentsRow"}], "]"}], ";"}],
         "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "tempOutputRows", "]"}]}], "}"}]}], "]"}], ";", 
      RowBox[{"(*", 
       RowBox[{"end", " ", "do", " ", "loop"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", "output", "*)"}], "\[IndentingNewLine]", 
      "outputOutliersRow"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
