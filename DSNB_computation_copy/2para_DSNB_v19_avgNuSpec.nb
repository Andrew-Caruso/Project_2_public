            RowBox[{
             RowBox[{"noBH2PnuWithout", "[", 
              RowBox[{"[", "indx", "]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}], "[", "x", "]"}], ",", 
           RowBox[{
            RowBox[{
