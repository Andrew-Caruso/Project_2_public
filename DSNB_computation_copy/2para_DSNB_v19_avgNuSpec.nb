Cell["Create IBD cross section function from IBD data ", "Text",
 CellChangeTimes->{{3.95934200449804*^9, 
  3.959342005726108*^9}},ExpressionUUID->"96cbd7aa-38ab-4ead-87d1-\
ebc4ac1a8881"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "from", " ", "IBD", " ", "data", " ", "create", " ", "function", " ", "of",
     " ", "IBD", " ", "cross", " ", "section", " ", "as", " ", "a", " ", 
    "function", " ", "of", " ", "nu", " ", "energy"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"from", " ", "table", " ", "1", " ", "Strumia", " ", "et", " ", 
    RowBox[{"al", ".", " ", "2003"}], 
    " ", "\"\<Precise quasielastic neutrino...\>\""}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "recall", " ", "data", " ", "is", " ", "in", " ", "format", " ", "of", " ", 
    RowBox[{"(", 
     RowBox[{"Enu", ",", "sigma", ",", 
      RowBox[{"Ee", "+"}]}], ")"}], " ", "sublists"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"with", " ", "units", " ", "of", " ", "MeV", " ", "and", " ", 
    RowBox[{"10", "^", 
     RowBox[{"-", "41"}]}], " ", 
    RowBox[{"cm", "^", "2"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"reformat", " ", "into", " ", 
    RowBox[{"(", 
     RowBox[{"MeV", ",", 
      RowBox[{"cm", "^", "2"}], ",", "MeV"}], ")"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"newIBDcrossData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"IBDcrossData", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"IBDcrossData", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}], "*", 
          RowBox[{"10", "^", 
           RowBox[{"-", "41"}]}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "IBDcrossData", "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "interpolate", " ", "the", " ", "data", " ", "such", " ", "that", " ", 
     RowBox[{"sigma", "[", "Enu", "]"}], " ", "cross", " ", "section", " ", 
     "in", " ", 
     RowBox[{"cm", "^", "2"}], " ", "as", " ", "a", " ", "function", " ", 
     "of", " ", "neutrino", " ", "energy", " ", "MeV"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"IBDcross", "=", 
