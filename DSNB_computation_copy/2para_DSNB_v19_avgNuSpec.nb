Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"crit1Pcompare", "[", "x_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"engineName", "=", "x"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "alternative", " ", "visualization", " ", "of", " ", "Mco", " ", 
        "values", " ", "for", " ", "BH", " ", "and", " ", "NS", " ", "for", " ",
         "each", " ", 
        RowBox[{"index", "/", "star"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "because", " ", "data", " ", "is", " ", "in", " ", "1", "D", " ", 
        "let", " ", "boolean", " ", "of", " ", "yes", " ", "NS", " ", "1", " ",
         "or", " ", "not", " ", "NS", " ", "0", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"i", ".", "e", ".", " ", "yes"}], " ", "BH"}], ")"}], " ", 
        "be", " ", "the", " ", "dependent", " ", "variable", " ", "on", " ", 
        "1", " ", "parameter", " ", "Mco"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"i", ".", "e", ".", " ", "format"}], " ", 
         RowBox[{"(", 
          RowBox[{"yVar", ",", "NSbool"}], ")"}], " ", "for", " ", "both", " ",
          "BH", " ", "and", " ", "NS", " ", "progen"}], "+", 
        RowBox[{"engine", " ", "data"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"NSpoints", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"NScomboData", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "yIndx"}], "]"}], "]"}], ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "NScomboData", "]"}]}], "}"}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"BHpoints", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"BHcomboData", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "yIndx"}], "]"}], "]"}], ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "BHcomboData", "]"}]}], "}"}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"allpoints", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"NSpoints", ",", "BHpoints"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"look", " ", "at", " ", 
           RowBox[{"target", "/", "true"}], " ", "NS", " ", "percentage", " ",
            "in", " ", "progen"}], "+", 
          RowBox[{"engine", " ", "data"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"NStruefracPE", "=", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"Length", "[", "NScomboData", "]"}], "/", 
           RowBox[{"Length", "[", "comboData", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"BHtruefracPE", "=", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"Length", "[", "BHcomboData", "]"}], "/", 
           RowBox[{"Length", "[", "comboData", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"recall", " ", "format", " ", 
          RowBox[{"(", 
           RowBox[{"x", ",", "y", ",", 
            RowBox[{"BH", "/", "NS"}]}], ")"}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"NOTE", ":", " ", 
           RowBox[{"peYmax", " ", "is", " ", "the", " ", "same"}]}], ",", " ", 
          RowBox[{
          "but", " ", "it", " ", "is", " ", "defined", " ", "later"}]}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"(*", "peYmax", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"yMax", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"comboDataJR", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "create", " ", "data", " ", "of", " ", "1", " ", "parameter", " ", 
          "thresholds", " ", "and", " ", "success", " ", "fraction"}], "*)"}],
         "\[IndentingNewLine]", "\t", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"from", " ", "progen"}], "+", 
          RowBox[{"engine", " ", "data", " ", 
           RowBox[{"(", 
            RowBox[{"knows", " ", "BH", " ", "vs", " ", "NS"}], ")"}]}]}], 
         "*)"}], "\[IndentingNewLine]", "\t", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"1", " ", "parameter", " ", "threshold"}], " ", "=", " ", 
          RowBox[{"1", "P", " ", "test", " ", "criterion"}]}], " ", "*)"}], 
        "\[IndentingNewLine]", "\t", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"success", " ", "fraction"}], " ", "=", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"successfully", " ", "identified", " ", "NS"}], " ", "+",
               " ", 
              RowBox[{
              "successfully", " ", "identified", " ", "BH", " ", "in", " ", 
               "pop", " ", "of", " ", 
               RowBox[{"NS", "/", "BH"}], " ", "after", " ", "imposing", " ", 
               "the", " ", "1", "P", " ", "threshold", " ", "on", " ", 
               "progen"}], "+", 
              RowBox[{"engine", " ", "data"}]}], ")"}], " ", "/", " ", 
            "tot"}], " ", "pop"}]}], "*)"}], "\[IndentingNewLine]", "\t", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
           RowBox[{"i", ".", "e", ".", " ", "success"}], " ", "fraction"}], 
          " ", "=", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"successful", " ", "NS", " ", "pop"}], " ", "+", " ", 
              RowBox[{"successful", " ", "BH", " ", "pop"}]}], ")"}], " ", "/",
             " ", "tot"}], " ", "pop"}]}], "*)"}], "\[IndentingNewLine]", 
        "\t", 
        RowBox[{"(*", 
         RowBox[{"i", ".", "e", ".", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"y", " ", "threshold"}], ",", " ", 
            RowBox[{"success", " ", "fraction"}]}], ")"}]}], "*)"}], 
        "\[IndentingNewLine]", "\t", 
        RowBox[{"(*", 
         RowBox[{
         "recall", " ", "format", " ", "of", " ", "comboDataJR", " ", 
          RowBox[{"(", 
           RowBox[{"x", ",", "y", ",", 
            RowBox[{"BH", "/", "NS"}]}], ")"}]}], "*)"}], 
        "\[IndentingNewLine]", "\t", 
        RowBox[{"(*", 
         RowBox[{
         "create", " ", "list", " ", "of", " ", "1", " ", "parameter", " ", 
          RowBox[{"(", 
           RowBox[{"y", " ", "variable"}], ")"}], " ", "thresholds", " ", 
          "or", " ", "test", " ", "cuts"}], "*)"}], "\[IndentingNewLine]", 
        "\t", 
        RowBox[{"yThresh", "=", 
         RowBox[{"Table", "[", 
          RowBox[{"i", ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", "yMax", ",", "0.001"}], "}"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", "\t", 
        RowBox[{"(*", 
