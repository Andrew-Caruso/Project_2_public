Cell[BoxData[
 RowBox[{
  RowBox[{"intDSNBCheckMod", "[", "x_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"data", "=", "x"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"intDSNBlistCheck", "=", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"\"\<case\>\"", ",", "\"\<scenario\>\"", 
         ",", "\"\<integrated DSNB\>\"", ",", "\"\<same truncated\>\"", 
         ",", "\"\<same rounded\>\"", ",", "\"\<iteration\>\""}], "}"}], 
       "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"counter3", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"counter3", "=", 
         RowBox[{"counter3", "+", "1"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"decimalPlace", "=", "1"}], ";", "\[IndentingNewLine]", 
        RowBox[{"tempBooltruncate", "=", 
         RowBox[{
          RowBox[{"truncate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"data", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"2", ",", "k", ",", "2", ",", "1"}], "]"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"3", ";;", "4"}], "]"}], "]"}], ",", "1"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", "decimalPlace"}], "]"}], "==", 
          RowBox[{"truncate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"data", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"2", ",", "k", ",", "2", ",", "1"}], "]"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"3", ";;", "4"}], "]"}], "]"}], ",", "1"}], "]"}], "[", 
             RowBox[{"[", "4", "]"}], "]"}], ",", "decimalPlace"}], "]"}]}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"tempBoolRound", "=", 
         RowBox[{
          RowBox[{"Round", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"data", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"2", ",", "k", ",", "2", ",", "1"}], "]"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"3", ";;", "4"}], "]"}], "]"}], ",", "1"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", "decimalPlace"}], "]"}], "==", 
          RowBox[{"Round", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"data", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"2", ",", "k", ",", "2", ",", "1"}], "]"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"3", ";;", "4"}], "]"}], "]"}], ",", "1"}], "]"}], "[", 
             RowBox[{"[", "4", "]"}], "]"}], ",", "decimalPlace"}], "]"}]}]}],
         ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"intDSNBlistCheck", ",", 
          RowBox[{"{", 
           RowBox[{
