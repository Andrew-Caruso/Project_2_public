Cell["compute CCSN rate normalization from IMF for DSNB flux ", "Text",
 CellChangeTimes->{{3.9644444582706833`*^9, 
  3.9644444742960567`*^9}},ExpressionUUID->"3a856fd5-892e-41a6-b912-\
402fb96ebae6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"fixed", " ", "CCSN", " ", "rate", " ", "factor"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"CCSNrateNormalization", ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Modified", " ", "Salpeter"}], "-", 
        RowBox[{
        "A", " ", "initial", " ", "mass", " ", "function", " ", "IMF"}]}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"NOTE", ":", " ", 
        RowBox[{
        "IMF", " ", "is", " ", "a", " ", "function", " ", "of", " ", "Mzams", 
         " ", "NOT", " ", "repeat", " ", "NOT", " ", 
         RowBox[{
          RowBox[{"Mco", "!!"}], "!!"}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"From", " ", "Baldry", " ", "et", " ", 
        RowBox[{"al", ".", " ", "2003"}], 
        RowBox[{"??", "?"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"used", " ", "in", " ", "Kresse", " ", "et", " ", 
        RowBox[{"al", ".", " ", "2021"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Rcc0estimate", "=", 
        RowBox[{
         RowBox[{"\[Rho]dot", "[", "0", "]"}], "*", 
         FractionBox[
          RowBox[{"Integrate", "[", 
           RowBox[{
            RowBox[{"modSalpeterA", "[", "x", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "ccMzamsMinKresse", ",", "ccMzamsMaxKresse"}], 
             "}"}]}], "]"}], 
          RowBox[{"Integrate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"modSalpeterA", "[", "x", "]"}], "*", "x"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "MzamMinKresse", ",", "ccMzamsMaxKresse"}], 
             "}"}]}], "]"}]]}]}], ";"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], 
  RowBox[{"(*", 
   RowBox[{"end", " ", "module"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.964444499907053*^9, 3.9644445045723953`*^9}, {
  3.964444585217452*^9, 3.9644446331913*^9}},
