Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"peEventRateJ", "[", "x3_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"engineName", "=", "x3"}], "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Quiet", "[", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"recall", " ", "that", " ", "progen"}], "+", 
          RowBox[{
          "engine", " ", "already", " ", "knows", " ", "BH", " ", "vs", " ", 
           "NS"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"without", " ", "MSW"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"peJEventRate", "=", 
          RowBox[{"yearToSec", "*", 
           RowBox[{"NIntegrate", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"peDSNB", "[", 
               RowBox[{"EnuIBD", "[", "x", "]"}], "]"}], "*", "NtJ", "*", 
              RowBox[{"IBDcross", "[", 
               RowBox[{"EnuIBD", "[", "x", "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "EminSKpos", ",", "EmaxSKpos"}], "}"}], ",", 
             RowBox[{"Method", "->", "\"\<Trapezoidal\>\""}], ",", 
             RowBox[{"PrecisionGoal", "->", "2"}], ",", 
             RowBox[{"AccuracyGoal", "->", "20"}]}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"with", " ", "MSW"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", "IH", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"peJEventRateIH", "=", 
          RowBox[{"yearToSec", "*", 
           RowBox[{"NIntegrate", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"peDSNBIH", "[", 
               RowBox[{"EnuIBD", "[", "x", "]"}], "]"}], "*", "NtJ", "*", 
              RowBox[{"IBDcross", "[", 
               RowBox[{"EnuIBD", "[", "x", "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "EminSKpos", ",", "EmaxSKpos"}], "}"}], ",", 
             RowBox[{"Method", "->", "\"\<Trapezoidal\>\""}], ",", 
             RowBox[{"PrecisionGoal", "->", "2"}], ",", 
             RowBox[{"AccuracyGoal", "->", "20"}]}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"with", " ", "MSW"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", "NH", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"peJEventRateNH", "=", 
          RowBox[{"yearToSec", "*", 
           RowBox[{"NIntegrate", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"peDSNBNH", "[", 
               RowBox[{"EnuIBD", "[", "x", "]"}], "]"}], "*", "NtJ", "*", 
              RowBox[{"IBDcross", "[", 
               RowBox[{"EnuIBD", "[", "x", "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "EminSKpos", ",", "EmaxSKpos"}], "}"}], ",", 
             RowBox[{"Method", "->", "\"\<Trapezoidal\>\""}], ",", 
             RowBox[{"PrecisionGoal", "->", "2"}], ",", 
             RowBox[{"AccuracyGoal", "->", "20"}]}], "]"}]}]}], ";"}], 
        "\[IndentingNewLine]", "]"}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{"end", " ", "quiet"}], "*)"}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"comparisons", " ", "for", " ", "SK"}], "-", 
         RowBox[{"Gd", " ", "event", " ", "rates", " ", 
          RowBox[{"(", 
           RowBox[{"progen", "+", 
            RowBox[{"engine", " ", "data"}]}], ")"}]}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"peJeventRateRow1", "=", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<progen+engine: \>\"", "<>", "engineName"}], 
           ",", "\"\<JUNO Event Rates (\!\(\*SuperscriptBox[\(year\), \(-1\)]\
\))\>\"", ",", 
           RowBox[{"\"\<Enu: \>\"", "<>", 
            RowBox[{"ToString", "[", "EminSKnu", "]"}], "<>", "\"\< to \>\"", 
            "<>", " ", 
            RowBox[{"ToString", "[", "EmaxSKnu", "]"}], 
            "<>", "\"\< MeV\>\""}]}], "}"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"peJeventRateRow2", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<No MSW\>\"", ",", "peSKEventRate", ",", 
            RowBox[{"\"\<Epos: \>\"", "<>", 
             RowBox[{"ToString", "[", "EminSKpos", "]"}], "<>", "\"\< to \>\"",
              "<>", " ", 
             RowBox[{"ToString", "[", "EmaxSKpos", "]"}], 
