          RowBox[{"{", 
           RowBox[{"\"\<all NS\>\"", ",", "allNSfb"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<NS+BH 2P crit\>\"", ",", "NSBH2Pfb"}], "}"}]}], 
         "}"}]}], ";", "\[IndentingNewLine]", "\t", 
       RowBox[{"subtable5row2", "=", 
