Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"peEventRateSK", "[", "x3_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"engineName", "=", "x3"}], "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Quiet", "[", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"recall", " ", "that", " ", "progen"}], "+", 
          RowBox[{
          "engine", " ", "already", " ", "knows", " ", "BH", " ", "vs", " ", 
           "NS"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"without", " ", "MSW"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"peSKEventRate", "=", 
          RowBox[{"yearToSec", "*", 
           RowBox[{"NIntegrate", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"peDSNB", "[", 
               RowBox[{"EnuIBD", "[", "x", "]"}], "]"}], "*", "NtSK", "*", 
              RowBox[{"IBDcross", "[", 
               RowBox[{"EnuIBD", "[", "x", "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "EminSKpos", ",", "EmaxSKpos"}], "}"}], ",", 
             RowBox[{"Method", "->", "\"\<Trapezoidal\>\""}], ",", 
             RowBox[{"PrecisionGoal", "->", "2"}], ",", 
             RowBox[{"AccuracyGoal", "->", "20"}]}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"with", " ", "MSW"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", "IH", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"peSKEventRateIH", "=", 
          RowBox[{"yearToSec", "*", 
           RowBox[{"NIntegrate", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"peDSNBIH", "[", 
               RowBox[{"EnuIBD", "[", "x", "]"}], "]"}], "*", "NtSK", "*", 
              RowBox[{"IBDcross", "[", 
               RowBox[{"EnuIBD", "[", "x", "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "EminSKpos", ",", "EmaxSKpos"}], "}"}], ",", 
             RowBox[{"Method", "->", "\"\<Trapezoidal\>\""}], ",", 
             RowBox[{"PrecisionGoal", "->", "2"}], ",", 
             RowBox[{"AccuracyGoal", "->", "20"}]}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"with", " ", "MSW"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", "NH", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"peSKEventRateNH", "=", 
          RowBox[{"yearToSec", "*", 
           RowBox[{"NIntegrate", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"peDSNBNH", "[", 
               RowBox[{"EnuIBD", "[", "x", "]"}], "]"}], "*", "NtSK", "*", 
              RowBox[{"IBDcross", "[", 
               RowBox[{"EnuIBD", "[", "x", "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "EminSKpos", ",", "EmaxSKpos"}], "}"}], ",", 
             RowBox[{"Method", "->", "\"\<Trapezoidal\>\""}], ",", 
             RowBox[{"PrecisionGoal", "->", "2"}], ",", 
             RowBox[{"AccuracyGoal", "->", "20"}]}], "]"}]}]}], ";"}], 
        "\[IndentingNewLine]", "]"}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{"end", " ", "quiet"}], "*)"}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"comparisons", " ", "for", " ", "SK"}], "-", 
         RowBox[{"Gd", " ", "event", " ", "rates", " ", 
          RowBox[{"(", 
           RowBox[{"progen", "+", 
            RowBox[{"engine", " ", "data"}]}], ")"}]}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"peSKeventRateRow1", "=", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<progen+engine: \>\"", "<>", "engineName"}], 
           ",", "\"\<SK-Gd Event Rates (\!\(\*SuperscriptBox[\(year\), \
\(-1\)]\))\>\"", ",", 
           RowBox[{"\"\<Enu: \>\"", "<>", 
            RowBox[{"ToString", "[", "EminSKnu", "]"}], "<>", "\"\< to \>\"", 
            "<>", " ", 
            RowBox[{"ToString", "[", "EmaxSKnu", "]"}], 
            "<>", "\"\< MeV\>\""}]}], "}"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"peSKeventRateRow2", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<No MSW\>\"", ",", "peSKEventRate", ",", 
            RowBox[{"\"\<Epos: \>\"", "<>", 
             RowBox[{"ToString", "[", "EminSKpos", "]"}], "<>", "\"\< to \>\"",
              "<>", " ", 
             RowBox[{"ToString", "[", "EmaxSKpos", "]"}], 
             "<>", "\"\< MeV\>\""}]}], "}"}], ",", 
