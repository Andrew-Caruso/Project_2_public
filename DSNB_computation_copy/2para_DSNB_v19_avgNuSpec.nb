Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"NOTE", ":", " ", 
    RowBox[{
    "bin", " ", "syn", " ", "data", " ", "is", " ", "in", " ", "terms", " ", 
     "of", " ", "individual", " ", "stars", " ", 
     RowBox[{"(", 
      RowBox[{"AFTER", " ", "binary", " ", "evolution", " ", "treatment"}], 
      ")"}], " ", "NOT", " ", "systems", "\n", "see", " ", 
     RowBox[{"e", ".", "g", ".", " ", "Horiuchi"}], " ", "et", " ", 
     RowBox[{"al", ".", "2021"}], " ", "table", " ", "I", " ", "for", " ", 
     "details", " ", "on", " ", "pops", "\n", "therefore", " ", "later", " ", 
     "need", " ", "to", " ", "renormalize", " ", "the", " ", "nuebar", " ", 
     "avg", " ", "energy", " ", "spectrum", " ", "to", " ", "account", " ", 
     "for", " ", "this", " ", "change", " ", "from", " ", "the", " ", "no", " ",
      "binary", " ", "case", " ", 
     RowBox[{"(", 
      RowBox[{"pop", " ", "of", " ", "stars"}], ")"}], " ", "to", " ", "the", 
     " ", "binary", " ", "case", " ", 
     RowBox[{"(", 
      RowBox[{"diff", " ", "pop", " ", "of", " ", "stars"}], ")"}]}]}], 
   "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "see", " ", "no", " ", "binary", " ", "populations", " ", "from", " ", 
    "table", " ", "I", " ", "Horiuchi", " ", "et", " ", 
    RowBox[{"al", ".", " ", "2021"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"NOTE", ":", " ", 
     RowBox[{"table", " ", "I", " ", "in", " ", "Horiuchi", " ", "et", " ", 
      RowBox[{"al", ".", " ", "2021"}], " ", "is", " ", "in", " ", "terms", " ",
       "of", " ", "sytems", " ", "not", " ", "individual", " ", "stars"}]}], ",",
     " ", 
    RowBox[{
    "thus", " ", "need", " ", "to", " ", "double", " ", "the", " ", "coulmn", 
     " ", "for", " ", "double"}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   StyleBox[
    RowBox[{
     RowBox[{
     "need", " ", "to", " ", "renormalize", " ", "nuebar", " ", "spectrum", " ",
       "since", " ", "no", " ", "binary", " ", "pop", " ", 
      RowBox[{"(", "original", ")"}]}], " ", "!=", " ", 
     RowBox[{"binary", " ", "pops", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"AFTER", " ", "binary", " ", "evolution", " ", "treatment"}], 
        ",", " ", 
        RowBox[{
        "which", " ", "is", " ", "the", " ", "bin", " ", "syn", " ", "data", " ",
          "pops"}]}], ")"}]}]}],
    FontSlant->"Plain"], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"also", " ", "note", " ", "that", " ", "unlike", " ", "progen"}],
      "+", 
     RowBox[{"engine", " ", "data"}]}], ",", 
    RowBox[{
    "bin", " ", "syn", " ", "and", " ", "no", " ", "bin", " ", "syn", " ", 
     "data", " ", "is", " ", "already", " ", "IMF", " ", "weighted"}]}], 
   "*)"}]}]], "Input",
