Cell["import progenitor & engine model data (knows NS vs BH)", "Text",
 CellChangeTimes->{{3.963926806327344*^9, 
  3.963926827201138*^9}},ExpressionUUID->"a90ce6a3-8ff3-46f6-ac4d-\
5a7ee1ad1249"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"peModelImporter", "[", 
     RowBox[{"x_", ",", "z_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"engineName", "=", "x"}], ",", 
        RowBox[{"garchingDir", "=", "z"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"import", " ", "progenitor", " ", "model", " ", "data"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Select", " ", "Progenitor", " ", "Model", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"only", " ", "1", " ", "data", " ", "file"}], ",", 
          RowBox[{"includes", " ", "models", " ", "therein"}]}], ")"}]}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rawProgenData", "=", " ", 
        RowBox[{"Import", "[", 
         RowBox[{
          RowBox[{
          "currentDir", "<>", "\"\</\>\"", "<>", "garchingDir", 
           "<>", "\"\</progenitor_properties_presn.txt\>\""}], 
          ",", "\"\<Table\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Dimensions", "[", "rawProgenData", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "need", " ", "to", " ", "remove", " ", "first", " ", "2", " ", "rows",
          " ", "of", " ", "description"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"rawProgenData", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", "2"}], "]"}], "]"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"rawProgenData", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"progenData", "=", 
        RowBox[{"rawProgenData", "[", 
         RowBox[{"[", 
          RowBox[{"3", ";;", 
           RowBox[{"Length", "[", "rawProgenData", "]"}]}], "]"}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Dimensions", "[", "progenData", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"progenColumns", "=", 
        RowBox[{"Drop", "[", 
         RowBox[{
          RowBox[{"rawProgenData", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", "1"}], "]"}]}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{
        "take", " ", "2", "nd", " ", "row", " ", "of", " ", "description", " ",
          "and", " ", "remove", " ", "first", " ", "element", " ", "for", " ",
          "all", " ", "column", " ", "labels"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"all", " ", "progenitor", " ", "models", " ", "therein"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"progenNames", "=", 
        RowBox[{"DeleteDuplicates", "[", 
         RowBox[{"progenData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"import", " ", "engine", " ", "model", " ", "data"}], " ", 
        RowBox[{"(*", 
         RowBox[{
         "used", " ", "to", " ", "calibrate", " ", "all", " ", "progenitors", 
          " ", "to", " ", "a", " ", "single", " ", "star", " ", "consistent", 
          " ", "with", " ", "SN1987a"}], "*)"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"(", 
         RowBox[{"multiple", " ", "to", " ", "choose", " ", "from"}], ")"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"rawEngineData", "=", 
        RowBox[{"Import", "[", 
         RowBox[{
          RowBox[{
          "currentDir", "<>", "\"\</\>\"", "<>", "garchingDir", 
           "<>", "\"\</\>\"", "<>", "engineName", "<>", "\"\<.txt\>\""}], 
          ",", "\"\<Table\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Dimensions", "[", "rawEngineData", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"engineColumns", "=", 
        RowBox[{"rawEngineData", "[", 
         RowBox[{"[", 
          RowBox[{"2", ";;", "16"}], "]"}], "]"}]}], " ", ";", 
       RowBox[{"(*", 
        RowBox[{
        "remove", " ", "1", " ", "and", " ", "17", " ", "fluff", " ", 
         "text"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"engineData", " ", "=", " ", 
        RowBox[{"rawEngineData", "[", 
         RowBox[{"[", 
          RowBox[{"18", ";;", 
           RowBox[{"Length", "[", "rawEngineData", "]"}]}], "]"}], "]"}]}], 
       ";"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"end", " ", "module"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.946718041807077*^9, 3.946718131356146*^9}, {
