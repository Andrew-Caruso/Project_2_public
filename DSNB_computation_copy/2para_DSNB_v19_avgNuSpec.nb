  RowBox[{"(*", 
   RowBox[{"from", " ", "table", " ", "1", " ", "Strumia", " ", "et", " ", 
    RowBox[{"al", ".", " ", "2003"}], 
    " ", "\"\<Precise quasielastic neutrino...\>\""}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"recall", " ", "dims"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"DSNB", " ", 
    RowBox[{
     RowBox[{"flux", " ", "~", " ", "MeV"}], "^", 
