          RowBox[{"{", 
           
           RowBox[{"\"\<bin syn without outliers\>\"", 
            ",", "\"\< detection integrated DSNB \
(\!\(\*SuperscriptBox[\(cm\), \(-2\)]\)\!\(\*SuperscriptBox[\(s\), \(-1\)]\))\
\>\"", ",", 
