Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"NOTE", ":"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "bin", " ", "syn", " ", "data", " ", "is", " ", "already", " ", "IMF", " ",
     "weighted", " ", "but", " ", "needs", " ", "to", " ", "be", " ", 
    "renormalized", " ", "by", " ", "fb", " ", "to", " ", "account", " ", 
    "for", " ", "binaries", " ", "vs", " ", "single", " ", "star", " ", 
    "pops"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"progen", "+", 
    RowBox[{
    "engine", " ", "data", " ", "is", " ", "NOT", " ", "IMF", " ", "weighted",
      " ", "and", " ", "needs", " ", "to", " ", 
     RowBox[{"be", ".", " ", "Since"}], " ", "it", " ", "is", " ", "also", " ",
      "single", " ", "stars", " ", "thus", " ", "do", " ", "not", " ", "need",
      " ", "renorm", " ", "fb"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "no", " ", "bin", " ", "syn", " ", "data", " ", "is", " ", "already", " ", 
    "IMF", " ", "weighted", " ", "and", " ", "does", " ", "NOT", " ", "need", 
    " ", "to", " ", "be", " ", "renormalized", " ", "by", " ", "fb", " ", 
    "since", " ", "it", " ", "is", " ", "single", " ", "stars"}], 
   "*)"}]}]], "Input",
 CellChangeTimes->{{3.962362024949102*^9, 3.962362132002606*^9}},
 CellLabel->
  "In[174]:=",ExpressionUUID->"db004523-6df5-44b0-970c-54e66a3428a8"],

Cell["\<\
NOTE:
bin syn data is already IMF weighted but needs to be renormalized by fb to \
account for binaries vs single star pops
progen+engine data is NOT IMF weighted and needs to be. Since it is also \
single stars thus do not need renorm fb
no bin syn data is already IMF weighted and does NOT need to be renormalized \
by fb since it is single stars\
\>", "Text",
 CellChangeTimes->{{3.962362138459988*^9, 
  3.962362149391787*^9}},ExpressionUUID->"a52e00df-d06b-445b-851b-\
35d65e61425b"]
}, Closed]],

