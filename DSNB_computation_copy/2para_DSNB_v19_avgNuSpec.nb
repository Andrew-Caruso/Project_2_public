  3.963926519125079*^9}},ExpressionUUID->"849715d1-4f4e-435d-a4f9-\
37e26415fd15"],

Cell["\<\
Match the progenitor and engine models together via Mzams
forming the progen+engine data (knows which is BH vs NS)\
\>", "Text",
 CellChangeTimes->{{3.9639261488498163`*^9, 
  3.963926149481048*^9}},ExpressionUUID->"38686bdb-0a11-427c-b64a-\
c6796128e2be"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"peDataMatcher", ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"create", " ", "joint", " ", "progeitor"}], "+", 
        RowBox[{"engine", " ", "data"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"comboData", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"progenData", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{"engineData", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "engineData", "]"}]}], "}"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Dimensions", "[", "progenData", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Dimensions", "[", "engineData", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Dimensions", "[", "comboData", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "progen", " ", "data", " ", "is", " ", "column", " ", "1", " ", "to", 
         " ", "13"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"comboData", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "13"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"(*", 
        RowBox[{
        "engine", " ", "data", " ", "is", " ", "column", " ", "14", " ", "to",
          " ", "28"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"comboData", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"14", ";;", "28"}], "]"}], "]"}], ";", "\[IndentingNewLine]",
        "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"confirm", " ", "Mzams", " ", "is", " ", "matched"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", "\"\<All Mzams matched:\>\"", "]"}], ";"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"ContainsExactly", "[", 
        RowBox[{
         RowBox[{"comboData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
         RowBox[{"comboData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "14"}], "]"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"create", " ", "joint", " ", "columns"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"tempColumns", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"progenColumns", ",", "engineColumns"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"comboColumns", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"tempColumns", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "tempColumns", "]"}]}], "}"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"30", " ", "columns"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"MatrixForm", "[", "comboColumns", "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "look", " ", "at", " ", "Mzams", " ", "extrema", " ", "in", " ", 
          "progen"}], "+", 
         RowBox[{"engine", " ", "data"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Mzams", " ", "range", " ", "in", " ", "progen"}], "+", 
         RowBox[{"engine", " ", "data"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"peMaxMzams", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"comboData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Max", "[", 
        RowBox[{"comboData", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "14"}], "]"}], "]"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"peMinMzams", "=", 
        RowBox[{"Min", "[", 
         RowBox[{"comboData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Min", "[", 
        RowBox[{"comboData", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "14"}], "]"}], "]"}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"end", " ", "of", " ", "module"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.963925461500318*^9, 3.963925464328189*^9}, {
   3.9639258503228607`*^9, 3.963925852004198*^9}, {3.9639262322364817`*^9, 
   3.9639263230488*^9}, 3.963927089095779*^9, {3.96401379490329*^9, 
   3.964013799767274*^9}},
 CellLabel->
  "In[122]:=",ExpressionUUID->"0bd710b5-2fac-4ed5-804c-72e7aa3a2bd7"]
}, Closed]]
}, Closed]]
}, Closed]],

