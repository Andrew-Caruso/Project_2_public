    RowBox[{"flux", " ", "~", " ", "nux"}], " ", "flux"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"assuming", " ", "nux", " ", 
    RowBox[{"flux", " ", "~", " ", "nuxbar"}], " ", "flux"}], "*)"}], 
  "\[IndentingNewLine]", 
