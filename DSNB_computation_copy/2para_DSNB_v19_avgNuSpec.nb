Cell[TextData[{
 "Importation of no binaries from binary synthesis simulation. Will be used \
to renormalize the average neutrino spectrum for bin syn data. \nBecause ",
 StyleBox["need to renormalize nuebar spectrum since no binary pop (original) \
!= binary pops (AFTER binary evolution treatment, which is the bin syn data \
pops)",
  FontSlant->"Plain"]
}], "Text",
