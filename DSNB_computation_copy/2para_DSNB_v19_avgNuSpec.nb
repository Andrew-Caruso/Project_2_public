Cell["\<\
check the alpha or pinching parameter (for neutrino spectrum) in engine data\
\>", "Text",
 CellChangeTimes->{{3.972485940744567*^9, 3.972485954389338*^9}, {
  3.9724860676544323`*^9, 
  3.972486088713767*^9}},ExpressionUUID->"3ab2b0c6-b43e-4f95-a1ef-\
40ebf3f1c5f3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"alphaCheck", "[", 
     RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"engineName", "=", "x"}], ",", 
        RowBox[{"maxNSm", "=", "y"}], ",", 
        RowBox[{"garchingDir", "=", "z"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"import", " ", "engine", " ", "model", " ", "data"}], " ", 
       RowBox[{"(*", 
        RowBox[{
        "used", " ", "to", " ", "calibrate", " ", "all", " ", "progenitors", " ",
          "to", " ", "a", " ", "single", " ", "star", " ", "consistent", " ", 
         "with", " ", "SN1987a"}], "*)"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"(", 
        RowBox[{"multiple", " ", "to", " ", "choose", " ", "from"}], ")"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ArawEngineData", "=", 
        RowBox[{"Import", "[", 
         RowBox[{
          RowBox[{
          "currentDir", "<>", "\"\</\>\"", "<>", "garchingDir", 
           "<>", "\"\</\>\"", "<>", "engineName", "<>", "\"\<.txt\>\""}], 
          ",", "\"\<Table\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Dimensions", "[", "ArawEngineData", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"AengineColumns", "=", 
        RowBox[{"ArawEngineData", "[", 
         RowBox[{"[", 
          RowBox[{"2", ";;", "16"}], "]"}], "]"}]}], " ", ";", 
       RowBox[{"(*", 
        RowBox[{
        "remove", " ", "1", " ", "and", " ", "17", " ", "fluff", " ", 
         "text"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"AengineData", " ", "=", " ", 
        RowBox[{"ArawEngineData", "[", 
         RowBox[{"[", 
          RowBox[{"18", ";;", 
           RowBox[{"Length", "[", "ArawEngineData", "]"}]}], "]"}], "]"}]}], ";",
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"select", " ", "only", " ", "NS"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"remnant", " ", "type", " ", "is", " ", "column", " ", "2"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"AengineDataNS", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"AengineData", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "==", "\"\<NS\>\""}], "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "select", " ", "only", " ", "BH", " ", "assuming", " ", "MbaryLim"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "select", " ", "out", " ", "BH", " ", "data", " ", "assuming", " ", 
         "the", " ", "chosen", " ", "NS", " ", "baryonic", " ", "mass", " ", 
         "limit", " ", "prior", " ", "to", " ", "BH", " ", "formation"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "baryonic", " ", "NS", " ", "mass", " ", "limit", " ", "at", " ", 
         "time", " ", "of", " ", "BH", " ", "formation", " ", "is", " ", "at",
          " ", "column", " ", "4", " ", "of", " ", "engine", " ", "data"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"AengineDataBH", "=", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{"AengineData", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "==", "\"\<BH\>\""}], "&"}]}], 
           "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "4", "]"}], "]"}], "==", "y"}], "&"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "AengineDataBH", "]"}], "+", 
          RowBox[{"Length", "[", "AengineDataNS", "]"}]}], "==", 
         RowBox[{"Length", "[", "AengineData", "]"}]}], "}"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "get", " ", "avg", " ", "alpha", " ", "for", " ", "NS", " ", "or", " ",
          "BH"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"in", " ", "order", " ", "of", " ", "nuebar"}], ",", " ", 
         "nue", ",", " ", 
         RowBox[{"and", " ", "nux", " ", "alpha", " ", 
          RowBox[{"only", ":", " ", 
           RowBox[{"columns", " ", "13"}]}]}], ",", "14", ",", "15"}], "*)"}],
        "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"in", " ", "order", " ", "of", " ", "NS"}], ",", " ", "BH", 
         ","}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"AengineAlphaAvgs", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           
           RowBox[{"\"\<pop\>\"", ",", "\"\<nuebar \[Alpha]\>\"", 
            ",", "\"\<nue \[Alpha]\>\"", ",", "\"\<nux \[Alpha]\>\""}], "}"}],
           ",", 
          RowBox[{"{", 
           RowBox[{"\"\<NS\>\"", ",", 
            RowBox[{"Mean", "[", 
             RowBox[{"AengineDataNS", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "13"}], "]"}], "]"}], "]"}], ",", 
            RowBox[{"Mean", "[", 
             RowBox[{"AengineDataNS", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "14"}], "]"}], "]"}], "]"}], ",", 
            RowBox[{"Mean", "[", 
             RowBox[{"AengineDataNS", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "15"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
          
          RowBox[{"{", 
           RowBox[{"\"\<BH\>\"", ",", 
            RowBox[{"Mean", "[", 
             RowBox[{"AengineDataBH", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "13"}], "]"}], "]"}], "]"}], ",", 
            RowBox[{"Mean", "[", 
             RowBox[{"AengineDataBH", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "14"}], "]"}], "]"}], "]"}], ",", 
            RowBox[{"Mean", "[", 
             RowBox[{"AengineDataBH", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "15"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
          
          RowBox[{"{", 
           RowBox[{"\"\<All\>\"", ",", 
            RowBox[{"Mean", "[", 
             RowBox[{"AengineData", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "13"}], "]"}], "]"}], "]"}], ",", 
            RowBox[{"Mean", "[", 
             RowBox[{"AengineData", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "14"}], "]"}], "]"}], "]"}], ",", 
            RowBox[{"Mean", "[", 
             RowBox[{"AengineData", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "15"}], "]"}], "]"}], "]"}]}], "}"}]}], 
         "}"}]}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"end", " ", "module"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.97248605876567*^9, 3.972486062599218*^9}, {
   3.9724860941306763`*^9, 3.9724862405853987`*^9}, {3.97248630781472*^9, 
   3.9724863114877577`*^9}, {3.972486348847439*^9, 3.972486370537654*^9}, {
   3.972486635353266*^9, 3.972486667039115*^9}, 3.972486742791711*^9, {
