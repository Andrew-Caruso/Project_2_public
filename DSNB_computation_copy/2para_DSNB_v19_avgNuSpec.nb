         RowBox[{"guessBHdata1P", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "15", "]"}], "]"}], "==", "\"\<BH\>\""}], "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", "\t", 
       RowBox[{"(*", 
        RowBox[{
        "get", " ", "pops", " ", "of", " ", "successfully", " ", 
         "identifided", " ", "NS", " ", "and", " ", "BH", " ", "assuming", " ",
          "the", " ", "1", "P", " ", "criterion"}], "*)"}], 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"sucessNSguess1P", "=", 
        RowBox[{"Length", "[", "successfulGuessNSdata1P", "]"}]}], ";", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"sucessBHguess1P", "=", 
        RowBox[{"Length", "[", "successfulGuessBHdata1P", "]"}]}], ";", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"(*", 
        RowBox[{"get", " ", "success", " ", 
         RowBox[{"fraction", ":", " ", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
               "num", " ", "of", " ", "sucessfully", " ", "identified", " ", 
                "NS"}], " ", "+", " ", 
               RowBox[{
               "number", " ", "successfully", " ", "identified", " ", 
                "BH"}]}], ")"}], "/", "tot"}], " ", "progen"}], "+", 
           RowBox[{"engine", " ", "pop"}]}]}]}], "*)"}], 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"successFrac1P", "=", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"sucessNSguess1P", "+", "sucessBHguess1P"}], "]"}], "/", 
         RowBox[{"Length", "[", "comboData", "]"}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Visualize", " ", "whether", " ", "this", " ", "optimal", " ", 
         "threshold", " ", "is", " ", "reasonable", " ", "or", " ", "not"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "create", " ", "histogram", " ", "of", " ", "true", " ", "BH", " ", 
          "and", " ", "NS", " ", "pop", " ", "in", " ", "progen"}], "+", 
         RowBox[{
         "engine", " ", "data", " ", "with", " ", "1", "P", " ", 
          "criterion"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"peHistoPops", "=", 
