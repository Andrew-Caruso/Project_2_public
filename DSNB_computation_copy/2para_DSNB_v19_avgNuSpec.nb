Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"chose", " ", "step", " ", "size"}], ",", " ", "min", ",", " ", 
    RowBox[{"and", " ", "max"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dsnbStep", "=", "0.25"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dsnbMin", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dsnbMax", "=", "40"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", "\"\<Number of points\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{"Length", "[", 
    RowBox[{"Table", "[", 
