         SubscriptBox["\[Theta]", "12"], ")"}]}], ")"}], "2"], " ", "nux", " ",
      "flux"}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"for", " ", "inverted", " ", "hierarchy", " ", "IH"}], "*)"}], 
  "\[IndentingNewLine]", 
