     RowBox[{"section", " ", "~", " ", "cm"}], "^", "2"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "integrating", " ", "over", " ", "energy", " ", "and", " ", "hitting", " ",
