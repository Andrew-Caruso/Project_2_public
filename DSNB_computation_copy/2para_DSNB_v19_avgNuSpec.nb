       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"create", " ", "table", " ", "with", " ", "all", " ", "fb"}], 
        "*)"}], "\[IndentingNewLine]", "\t", 
       RowBox[{"subtable5row1", "=", 
        RowBox[{"{", 
