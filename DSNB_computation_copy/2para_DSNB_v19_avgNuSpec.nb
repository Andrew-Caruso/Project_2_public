Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"binAllBSdata", ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "get", " ", "initial", " ", "variables", " ", "for", " ", "binning"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"recall", " ", "binSynDataJR", " ", "format", " ", 
        RowBox[{"(", 
         RowBox[{"x", ",", "y"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"NOTE", ":", " ", 
        RowBox[{
        "x", " ", "independent", " ", "variable", " ", "can", " ", "be", " ", 
         "a", " ", "single", " ", "progen", " ", "var", " ", "or", " ", "a", " ",
          "product", " ", "of", " ", "two"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"bin", " ", "x", " ", "var", " ", 
        RowBox[{"(", 
         RowBox[{"chosen", " ", 
          RowBox[{"single", "/", "product"}], " ", "progen", " ", "var", 
          RowBox[{"(", "s", ")"}]}], ")"}], " ", "bin", " ", "syn", " ", 
        "data"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[CapitalDelta]x", "=", "0.01"}], " ", ";", 
       RowBox[{"(*", 
        RowBox[{"choose", " ", "bin", " ", "sizes"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"maxXround", "=", 
        RowBox[{"Ceiling", "[", 
         RowBox[{"Max", "[", 
          RowBox[{"binSynDataJR", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"bsXbins", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"i", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "\[CapitalDelta]x", ",", 
            RowBox[{"maxXround", "-", "\[CapitalDelta]x"}], ",", 
            "\[CapitalDelta]x"}], "}"}]}], "]"}]}], " ", ";", 
       RowBox[{"(*", 
        RowBox[{"x", " ", "bins", " ", "excluding", " ", "ends"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"bin", " ", "y", " ", "var", " ", 
         RowBox[{"(", 
          RowBox[{"chosen", " ", "single", " ", "progen", " ", "var"}], ")"}],
          " ", "bin", " ", "syn", " ", "data"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"\[CapitalDelta]y", "=", "0.01"}], ";", "  ", 
       RowBox[{"(*", 
        RowBox[{"choose", " ", "bin", " ", "sizes"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"maxYround", "=", 
        RowBox[{"Ceiling", "[", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"binSynDataJR", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}], " ", ",", 
          "0.1"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"bsYbins", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"i", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "\[CapitalDelta]y", ",", 
            RowBox[{"maxYround", "-", "\[CapitalDelta]y"}], ",", 
            "\[CapitalDelta]y"}], "}"}]}], "]"}]}], " ", ";", 
       RowBox[{"(*", 
        RowBox[{"y", " ", "bins", " ", "excluding", " ", "ends"}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"apply", " ", "2", "P", " ", "criterion", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"based", " ", "on", " ", "progen"}], "+", 
           RowBox[{
           "engine", " ", "data", " ", "of", " ", "single", " ", "stars"}]}], 
          ")"}], " ", "to", " ", "bin", " ", "syn", " ", "data"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"recall", " ", "2", "P", " ", "criterion", " ", "is", " ", 
         RowBox[{"y", "[", "x", "]"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "NS", " ", "are", " ", "below", " ", "or", " ", "equal", " ", "to", " ",
          "criterion"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"NS2P", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"binSynDataJR", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "<=", 
            RowBox[{"criter2P", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "&"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"BH", " ", "are", " ", "above", " ", "criterion"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"BH2P", "=", 
        RowBox[{"Select", "[", 
