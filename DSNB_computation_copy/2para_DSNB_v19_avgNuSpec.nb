Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "compute", " ", "event", " ", "rates", " ", "at", " ", "SK_Gd", " ", 
     "with", " ", "progen"}], "+", 
    RowBox[{"engine", " ", "data"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "note", " ", "that", " ", "integration", " ", "is", " ", "over", " ", 
    "positron", " ", "energies", " ", "but", " ", "the", " ", "integrand", " ",
     "functions", " ", "are", " ", "functions", " ", "of", " ", "neutrino", " ",
     "energies"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"also", " ", "convert", " ", "from", " ", 
    RowBox[{"s", "^", 
     RowBox[{"-", "1"}]}], " ", "to", " ", 
    RowBox[{"year", "^", 
     RowBox[{"-", "1"}]}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"recall", " ", "that", " ", "progen"}], "+", 
    RowBox[{
    "engine", " ", "already", " ", "knows", " ", "BH", " ", "vs", " ", 
     "NS"}]}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.964521957595928*^9, 3.9645219692496157`*^9}},
 CellLabel->
