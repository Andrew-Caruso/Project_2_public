Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"NOTE", ":", 
   RowBox[{
   "bin", " ", "syn", " ", "data", " ", "is", " ", "in", " ", "terms", " ", 
    "of", " ", "individual", " ", "stars", " ", 
    RowBox[{"(", 
     RowBox[{"AFTER", " ", "binary", " ", "evolution", " ", "treatment"}], 
     ")"}], " ", "NOT", " ", "systems", "\n", "see", " ", 
    RowBox[{"e", ".", "g", ".", "horiuchi"}], " ", "et", " ", 
    RowBox[{"al", ".", "2021"}], " ", "table", " ", "I", " ", "for", " ", 
    "details", " ", "on", " ", "pops", "\n", "therefore", " ", "later", " ", 
    "need", " ", "to", " ", "renormalize", " ", "the", " ", "nuebar", " ", 
    "avg", " ", "energy", " ", "spectrum", " ", "to", " ", "account", " ", 
    "for", " ", "this", " ", "change", " ", "from", " ", "the", " ", "no", " ",
     "binary", " ", "case", " ", 
    RowBox[{"(", 
     RowBox[{"pop", " ", "of", " ", "stars"}], ")"}], " ", "to", " ", "the", " ",
     "binary", " ", "case", " ", 
    RowBox[{"(", 
     RowBox[{"diff", " ", "pop", " ", "of", " ", "stars"}], ")"}]}]}], 
  "*)"}]], "Input",
 CellChangeTimes->{3.963926582357395*^9},
 CellLabel->
  "In[118]:=",ExpressionUUID->"6f5fa303-51a5-4504-afdc-814e48c27322"],

Cell["import binary synthesis model (blind to NS vs BH) ", "Text",
 CellChangeTimes->{{3.963926556905581*^9, 
  3.9639265680638733`*^9}},ExpressionUUID->"a12b9a11-f779-4a8a-a42a-\
a161fbc9da1a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"bsModelImporter", "[", "x_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"binsynTopName", "=", "x"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rawBinSynData", "=", 
        RowBox[{"Import", "[", 
         RowBox[{
          RowBox[{
          "currentDir", "<>", "\"\</BinarySynthesis2_SN_Mco_M4_Mu4/\>\"", "<>",
            "binsynTopName", "<>", "\"\</Mco_M4_Mu4_type.txt\>\""}], 
          ",", "\"\<Table\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Dimensions", "[", "rawBinSynData", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rawbinSynColumns", "=", 
        RowBox[{"{", 
         RowBox[{"\"\<Mco\>\"", ",", "\"\<M4\>\"", 
          ",", "\"\<\!\(\*SubscriptBox[\(\[Mu]\), \(4\)]\)\>\"", 
          ",", "\"\<SN\>\""}], "}"}]}], " ", ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"NOTE", ":", " ", 
         RowBox[{"in", " ", "format", " ", "of", " ", 
          RowBox[{"(", 
           RowBox[{"Mco", ",", " ", "M4", ",", " ", "Mu4", ",", " ", 
            RowBox[{"SN", " ", "type", " ", 
             RowBox[{"(", 
              RowBox[{"II", " ", "or", " ", 
               RowBox[{"Ia", "/", "Ib"}]}], ")"}]}]}], ")"}], " ", "which", " ",
           "are", " ", "progenitor", " ", "parameters"}]}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"extract", " ", "only", " ", "Mco"}], ",", " ", "M4", ",", 
         " ", 
         RowBox[{"and", " ", 
          SubscriptBox["\[Mu]", "4"]}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"binSynData", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"rawBinSynData", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", 
             RowBox[{"1", ";;", "3"}]}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "rawBinSynData", "]"}]}], "}"}]}], "]"}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"binSynColumns", "=", 
        RowBox[{"rawbinSynColumns", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", "3"}], "]"}], "]"}]}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"end", " ", "of", " ", "module"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.963926523125909*^9, 3.963926531058477*^9}, {
  3.9639266069166107`*^9, 3.9639266498404713`*^9}, {3.964034567881049*^9, 
