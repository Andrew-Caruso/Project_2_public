Cell["comment on SK-Gd number of proton targets ", "Text",
 CellChangeTimes->{{3.964521190388883*^9, 
  3.9645212039948874`*^9}},ExpressionUUID->"477fad82-c170-42b1-9249-\
2c9b3ff80d96"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"The", " ", "fiducial", " ", "volume", " ", "for", " ", "SK", " ", 
     RowBox[{"(", 
      RowBox[{"and", " ", "SK", " ", "Gd"}], ")"}], " ", "is", " ", "22.5", " ",
      "kton", " ", "of", " ", "water", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
        "this", " ", "is", " ", "the", " ", "earliest", " ", "reference", " ", 
         RowBox[{"I", "'"}], "ve", " ", "seen", " ", "for", " ", "it"}], ",", 
        
        RowBox[{
         RowBox[{
         "but", " ", "is", " ", "very", " ", "widely", " ", "used", " ", 
          "for", " ", "the", " ", 
          RowBox[{"value", ":", "https", ":"}]}], "//", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"arxiv", ".", "org"}], "/", "pdf"}], "/", "astro"}], "-", 
          
          RowBox[{
           RowBox[{"ph", "/", "0702613"}], "v3"}]}]}]}], ")"}], ".", "To"}], " ",
      "get", " ", "that", " ", "number"}], ",", 
    RowBox[{
    "you", " ", "are", " ", "assuming", " ", "that", " ", "the", " ", 
     "incoming", " ", "neutrinos", " ", "interact", " ", "with", " ", "the", " ",
      "protons", " ", 
     RowBox[{"(", 
      RowBox[{"or", " ", "H"}], ")"}], " ", "in", " ", "the", " ", "water", " ",
      "molecules"}], ",", 
    RowBox[{"i", ".", "e", "."}], ",", 
    RowBox[{"NtSK", "=", 
     RowBox[{"22.5", " ", "kton", "*", "1000", " ", 
      RowBox[{"ton", "/", "kton"}], "*", "1000", " ", 
      RowBox[{
       RowBox[{"kg", "/", "ton"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"1.67", "e"}], "-", 
         RowBox[{"27", " ", 
          RowBox[{"kg", "/", "proton"}]}]}], ")"}]}], "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "/", "18"}], " ", 
         RowBox[{"protons", "/", "water"}], " ", "molecule"}], ")"}], "~", 
       "1.5"}], "e33", " ", "water", " ", "molecules", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"or", " ", "targets"}], ")"}], ".", "2"}], "/", "18"}], " ", 
      
      RowBox[{"protons", "/", "water"}], " ", "molecule", " ", "because", " ",
       "the", " ", "O", " ", "in", " ", "H2O", " ", "has", " ", "a", " ", 
      "mass", " ", 
      RowBox[{"of", "~", "16"}], " ", 
      RowBox[{"mp", ".", "It"}], " ", "is", " ", "the", " ", "same", " ", 
      "number", " ", "of", " ", "targets", " ", "in", " ", "SK", " ", "and", " ",
       "SK", " ", "Gd", " ", "because", " ", "both", " ", "experimental", " ",
       "iterations", " ", "have", " ", "the", " ", "same", " ", "amount", " ",
       "of", " ", 
      RowBox[{"water", ".", "The"}], " ", "Gd", " ", "case", " ", "just", " ",
       "has", " ", "a", " ", "higher", " ", "efficiency", " ", "because", " ",
       "the", " ", "resulting", " ", "neutron", " ", "from", " ", "the", " ", 
      "IBD", " ", "interaction", " ", "gets", " ", "absorbed", " ", "by", " ",
       "the", " ", "tiny", " ", "amount", " ", "of", " ", "Gd"}]}], ",", 
    RowBox[{
    "then", " ", "the", " ", "gamma", " ", "rays", " ", "that", " ", "are", " ",
      "emitted", " ", "after", " ", "the", " ", "absorption", " ", "are", " ",
      "more", " ", "easily", " ", "detected", " ", "than", " ", "the", " ", 
     "case", " ", "without", " ", 
     RowBox[{"Gd", "."}]}]}], "*)"}], " ", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"from", " ", "Nick", " ", "Ekanger"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"22.5", "*", 
   RowBox[{"(", 
