Cell[CellGroupData[{

Cell["integrated DSNB flux Extractor", "Subsubsection",
 CellChangeTimes->{{3.964793269586451*^9, 
  3.9647932772259617`*^9}},ExpressionUUID->"d532de9e-ea2c-47a3-9b26-\
5a2fa6c15904"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"intFluxCheckExtractor", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"intFluxCheck", "=", "x"}], ",", 
        RowBox[{"caseName", "=", "y"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"make", " ", "title", " ", "rows"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "where", " ", "caseName", " ", "is", " ", "no", " ", "bin", " ", "syn",
         " ", "or", " ", "bin", " ", "syn"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tableTitle", "=", 
        RowBox[{"{", 
         RowBox[{"caseName", ",", 
          RowBox[{"intFluxCheck", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], ",", 
          RowBox[{"intFluxCheck", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1", ",", "3"}], "]"}], "]"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tableTitle2", "=", 
        RowBox[{"{", 
         RowBox[{"\"\<\>\"", ",", "\"\<min\>\"", ",", "\"\<max\>\""}], 
         "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"initial", " ", "empty", " ", "temp", " ", "rows"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"outputRows1", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"outputRows2", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"outputRows3", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"outputRows4", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"extract", " ", "list", " ", "of", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"peMod", ",", "engineMod", ",", "number"}], "}"}], ",", 
           "popCase"}], "}"}], " ", "removing", " ", "everything", " ", 
         "else"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"tempRow1", "=", 
           RowBox[{"intFluxCheck", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", 
              RowBox[{"2", ";;", 
               RowBox[{"-", "1"}]}]}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"extract", " ", "list", " ", "of", " ", 
            RowBox[{"{", 
             RowBox[{"number", ",", "popCase"}], "}"}], " ", "removing", " ", 
            "everything", " ", "else"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"tempRow2", "=", 
           RowBox[{"Map", "[", 
            RowBox[{"Reverse", ",", 
             RowBox[{"DeleteCases", "[", 
              RowBox[{
               RowBox[{"Map", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Drop", "[", 
                   RowBox[{"#", ",", "1"}], "]"}], "&"}], ",", "tempRow1", ",",
                  "1"}], "]"}], ",", 
               RowBox[{"{", "}"}]}], "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"tempRow3", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"tempRow2", "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", "2"}], "]"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"bsModsRunned", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                   RowBox[{"enginesRunned", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
                 RowBox[{"tempRow2", "[", 
                  RowBox[{"[", 
                   RowBox[{"j", ",", "1"}], "]"}], "]"}]}], "}"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", 
               RowBox[{"Length", "[", "tempRow2", "]"}]}], "}"}]}], "]"}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"add", " ", "each", " ", "temp", " ", "row"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"outputRows1", ",", "tempRow3"}], "]"}], ";"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "intFluxCheck", "]"}]}], "}"}]}], 
        "\[IndentingNewLine]", "]"}], ";", 
       RowBox[{"(*", 
        RowBox[{"end", " ", "do", " ", "loop"}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "regroup", " ", "by", " ", "subtitles", " ", "or", " ", "popCase"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "upgrade", " ", "outputRows1", " ", "to", " ", "outputRows2"}], 
         ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"outputRows2", "=", 
        RowBox[{"GroupBy", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{"outputRows1", ",", "1"}], "]"}], ",", "First"}], "]"}]}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "manipulate", " ", "this", " ", "list", " ", "to", " ", "form", " ", 
         "new", " ", "table", " ", "rows"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "upgrade", " ", "outputRows2", " ", "to", " ", "outputRows3"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"rowSubtitle", "=", 
           RowBox[{"DeleteDuplicates", "[", 
            RowBox[{
             RowBox[{"outputRows2", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"modComboTitles", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"intFluxCheckExtractor", "[", 
                RowBox[{"intFluxCheckBS", ",", "\"\<Bin syn\>\""}], "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2", ",", "1"}], "]"}], "]"}]}], ";"}], 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"rowNums", "=", 
           RowBox[{
            RowBox[{"outputRows2", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"add", " ", "each", " ", "temp", " ", "row"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"outputRows3", ",", 
            RowBox[{"Join", "[", 
             RowBox[{"rowSubtitle", ",", "rowNums"}], "]"}]}], "]"}], ";"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "add", " ", "cases", " ", "or", " ", "model", " ", "combo", " ", 
           "titles"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"PrependTo", "[", 
            RowBox[{"outputRows3", ",", "modComboTitles"}], "]"}], ";"}], 
          "*)"}], "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", 
           RowBox[{"Length", "[", "outputRows2", "]"}]}], "}"}]}], 
        "\[IndentingNewLine]", "]"}], ";", 
       RowBox[{"(*", 
        RowBox[{"end", " ", "do", " ", "loop"}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "find", " ", "extrema", " ", "values", " ", "for", " ", "every", " ", 
         "popCase"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "in", " ", "order", " ", "to", " ", "determine", " ", "model", " ", 
         "combo", " ", "with", " ", 
         RowBox[{"lowest", "/", "highest"}], " ", "DSNB", " ", "flux"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"get", " ", 
          RowBox[{"max", "/", "min"}], " ", "values"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"maxFlux", "=", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"outputRows3", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"2", ";;", 
                RowBox[{"-", "1"}]}], "]"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"minFlux", "=", 
           RowBox[{"Min", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"outputRows3", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"2", ";;", 
                RowBox[{"-", "1"}]}], "]"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"get", " ", "corresponding", " ", "indices"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"maxIndex", "=", 
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{"Position", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"outputRows3", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"2", ";;", 
                   RowBox[{"-", "1"}]}], "]"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "maxFlux"}], 
              "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"minIndex", "=", 
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{"Position", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"outputRows3", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"2", ";;", 
                   RowBox[{"-", "1"}]}], "]"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "minFlux"}], 
              "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"append", " ", "to", " ", "output"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"outputRows4", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"outputRows3", "[", 
                RowBox[{"[", "k", "]"}], "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"Flatten", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"outputRows3", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], "[", 
                  RowBox[{"[", 
                   RowBox[{"2", ";;", 
                    RowBox[{"-", "1"}]}], "]"}], "]"}], "[", 
                 RowBox[{"[", "minIndex", "]"}], "]"}], ",", "2"}], "]"}], ",", 
              RowBox[{"Flatten", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"outputRows3", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], "[", 
                  RowBox[{"[", 
                   RowBox[{"2", ";;", 
                    RowBox[{"-", "1"}]}], "]"}], "]"}], "[", 
                 RowBox[{"[", "maxIndex", "]"}], "]"}], ",", "2"}], "]"}]}], 
             "}"}]}], "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", 
           RowBox[{"Length", "[", "outputRows3", "]"}]}], "}"}]}], "]"}], ";", 
       RowBox[{"(*", 
        RowBox[{"end", " ", "do", " ", "loop"}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"add", " ", "title", " ", "rows"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"PrependTo", "[", 
        RowBox[{"outputRows4", ",", "tableTitle2"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"PrependTo", "[", 
        RowBox[{"outputRows4", ",", "tableTitle"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", "output", "*)"}], "\[IndentingNewLine]", 
       "outputRows4"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"end", " ", "module"}], "*)"}], "\[IndentingNewLine]"}]], "Input",
