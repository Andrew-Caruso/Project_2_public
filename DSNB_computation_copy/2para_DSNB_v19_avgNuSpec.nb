Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "with", " ", "previous", " ", "two", " ", "fixed", " ", "factors", " ", 
    "and", " ", "the", " ", "third", " ", "unfixed", " ", "factor", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
      "avg", " ", "nu", " ", "spec", " ", "from", " ", "assuming", " ", "bin",
        " ", "syn", " ", "and", " ", "progen"}], "+", 
      RowBox[{
      "engine", " ", "models", " ", "and", " ", "2", " ", "progenitor", " ", 
       "parameter", " ", "criterion"}]}], ")"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "can", " ", "compute", " ", "the", " ", "DSNB", " ", "flux", " ", "for", " ",
     "all", " ", "cases", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"all", " ", "BH", " ", "without", " ", "criterion"}], ",", 
      RowBox[{"all", " ", "NS", " ", "without", " ", "criterion"}], ",", 
      RowBox[{"and", " ", "with", " ", "criterion"}]}], ")"}], " ", 
    RowBox[{"with", "/", "without"}], " ", "outliers"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"CCSN", " ", 
     RowBox[{
      RowBox[{"rate", " ", "~", " ", "Mcp"}], "^", 
      RowBox[{"-", "3"}]}], " ", 
     RowBox[{"year", "^", 
      RowBox[{"-", "1"}]}]}], " ", "->", " ", 
    RowBox[{"MeV", "^", "4"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"cosmological", " ", 
     RowBox[{"factor", " ", "~", " ", "s"}]}], " ", "->", " ", 
    RowBox[{"MeV", "^", 
     RowBox[{"-", "1"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"avg", " ", "nu", " ", 
    RowBox[{
     RowBox[{"spec", " ", "~", " ", "MeV"}], "^", 
     RowBox[{"-", "1"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"DSNB", " ", 
    RowBox[{
     RowBox[{"flux", " ", "~", " ", "MeV"}], "^", "2"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "DSNB", " ", "flux", " ", "will", " ", "be", " ", "a", " ", "function", " ",
     "of", " ", "energy", " ", "in", " ", "MeV"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"want", " ", "to", " ", "convert", " ", "to", " ", "smei"}], "-", 
    
    RowBox[{"natural", " ", "units", " ", 
