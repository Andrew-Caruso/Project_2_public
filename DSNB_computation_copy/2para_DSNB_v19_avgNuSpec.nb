Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"fixed", " ", "cosmological", " ", "factor"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"cosmoFactor", ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"|", 
          RowBox[{"dt", "/", "dz"}], "|", " ", 
          RowBox[{"factor", " ", "in", " ", "integrated"}]}], ",", " ", 
         RowBox[{
         "when", " ", "integrating", " ", "over", " ", "redshift", " ", 
          "z"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"from", " ", "Horiuchi", " ", "et", " ", 
         RowBox[{"al", ".", " ", "2021"}], " ", "\"\<Impact of binary\>\""}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"dtdz", "[", "z_", "]"}], ":=", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"H0", "*", 
            RowBox[{"(", 
             RowBox[{"1", "+", "z"}], ")"}], "*", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"1", "+", "z"}], ")"}], "3"], "*", 
                "\[CapitalOmega]m"}], "+", 
               "\[CapitalOmega]\[CapitalLambda]"}], ")"}], 
             RowBox[{"1", "/", "2"}]]}], ")"}]}]}], ";"}]}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Plot", "[", 
         RowBox[{
          RowBox[{"dtdz", "[", "z", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"z", ",", "0", ",", "5"}], "}"}], ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<z\>\"", ",", "\"\<dt/dz\>\""}], "}"}]}], ",", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{
            RowBox[{"ColorData", "[", 
             RowBox[{"97", ",", "\"\<ColorList\>\""}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ",", 
          RowBox[{"PlotLabel", "->", "\"\<Cosmological Factor\>\""}]}], "]"}],
         ";"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}],
     ";"}], 
   RowBox[{"(*", 
    RowBox[{"end", " ", "module"}], "*)"}], 
   "\[IndentingNewLine]"}]}]], "Input",
