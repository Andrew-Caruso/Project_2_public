Cell["but need to normalize this IMF", "Text",
 CellChangeTimes->{{3.948271430780302*^9, 
  3.948271441235545*^9}},ExpressionUUID->"b2543abb-863d-4df2-b273-\
619b781baef8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "need", " ", "to", " ", "renormalize", " ", "the", " ", "function"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"initial", " ", "mass", " ", "function", " ", 
     RowBox[{"(", "IMF", ")"}], " ", "is", " ", "a", " ", "probability", " ", 
     "distribution", " ", "function", " ", 
     RowBox[{"(", "PDF", ")"}]}], ",", 
    RowBox[{
    "needs", " ", "to", " ", "be", " ", "integrated", " ", "to", " ", "yield",
      " ", "initial", " ", "mass", " ", "distribution", " ", "of", " ", 
     "stars", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"depending", " ", "on", " ", "mass", " ", "range"}], ")"}], ".",
       "Has"}], " ", "to", " ", "be", " ", "normalized", " ", "to", " ", 
     "unity", " ", "manually", " ", "by", " ", "selecting", " ", "a", " ", 
     "mass", " ", "range"}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"from", " ", "Kresse", " ", "et", " ", 
    RowBox[{"al", ".", " ", "2021"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"CCSN", " ", "progenitor", " ", "Mzams", " ", 
    RowBox[{"range", ":", " ", 
     RowBox[{"8.7", " ", "to", " ", "125", " ", "Msol"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"all", " ", "baby", " ", "star", " ", "Mzams", " ", 
    RowBox[{"range", ":", " ", 
     RowBox[{"0.1", " ", "to", " ", "125", " ", "Msol"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Print", "[", "\"\<Mzams range for core-collapse progens (from Kresse et \
al 2021):\>\"", "]"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ccMzamsMinKresse", "=", "8.7"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ccMzamsMaxKresse", "=", "125"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Print", "[", "\"\<Mzams range for IMF normalization (full range from \
Kresse et al 2021):\>\"", "]"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MzamMinKresse", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MzamMaxKresse", "=", "125"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"get", " ", "normlization", " ", "of", " ", "the", " ", "IMF"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"IMFnorm", "=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"TEMPmodSalpeterA", "[", "x", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "MzamMinKresse", ",", "MzamMaxKresse"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"modSalpeterA", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"TEMPmodSalpeterA", "[", "#", "]"}], "/", "IMFnorm"}], "&"}]}],
     ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9482280351383877`*^9, 3.9482280443380337`*^9}, {
   3.9482281400111837`*^9, 3.948228202240974*^9}, 3.948228253401977*^9, {
