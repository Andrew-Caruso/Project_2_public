Cell["\<\
after also finding the corresponding temperature at high energy (beyond the \
maximum)\
\>", "Text",
 CellChangeTimes->{{3.987500656128377*^9, 
  3.987500672786263*^9}},ExpressionUUID->"90766f16-b26e-4508-ae9d-\
2658c3ea66de"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"take", " ", "in", " ", 
      RowBox[{"e", ".", "g", ".", " ", "binModData"}]}], "=", 
     RowBox[{"selectorRecursive", "[", 
      RowBox[{"dataAll", ",", 
       RowBox[{"{", 
        RowBox[{"\"\<bin syn\>\"", ",", "\"\<W18-BH2.7-a2.0\>\"", ",", "2.7", 
         ",", "1", ",", "\"\<BHNS\>\"", ",", "\"\<no MSW\>\""}], "}"}], ",", 
       "1"}], "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "create", " ", "DSNB", " ", "flux", " ", "plot", " ", "of", " ", "all", " ",
     "elements"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dsnbFluxesTemperaturePlotter", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"data", "=", "x"}], ",", 
        RowBox[{"title", "=", "y"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"fill", " ", "as", " ", 
        RowBox[{"{", 
         RowBox[{"caseName", ",", "DSNBflux"}], "}"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"dsnbFluxList", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "get", " ", "DSNB", " ", "flux", " ", "and", " ", "case", " ", 
          "name"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"tempDSNBFlux", "=", 
           RowBox[{"data", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", 
              RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"tempCaseName", "=", 
           RowBox[{"data", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"get", " ", "temperature"}], ",", " ", 
            RowBox[{"numerator", " ", "coefficient"}], ",", " ", 
            RowBox[{"maxIndex", " ", "for", " ", "corresponding"}]}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"dirac", " ", "delta", " ", "distribution"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"FDpara", "=", 
           RowBox[{"tempFinder", "[", "tempDSNBFlux", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"maxIndexJR", "=", 
           RowBox[{"FDpara", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"foundTemp", "=", 
           RowBox[{"FDpara", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"foundNumNum", "=", 
           RowBox[{"FDpara", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "create", " ", "list", " ", "of", " ", "of", " ", "corresponding", 
            " ", "dirac", " ", "delta"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"FDlist", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"z", ",", 
               RowBox[{"fermiDirac", "[", 
                RowBox[{"z", ",", "foundTemp", ",", "foundNumNum"}], "]"}]}], 
              "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"z", ",", "0", ",", "40"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"append", " ", "to", " ", "ultimate", " ", "list"}], 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "legendName", ",", " ", "dsnbFlux", ",", "fermiDiracDist"}], 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"dsnbFluxList", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"ToString", "[", "FDpara", "]"}], "<>", 
               RowBox[{"ToString", "[", "tempCaseName", "]"}]}], ",", 
              "tempDSNBFlux", ",", "FDlist"}], "}"}]}], "]"}], ";"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "data", "]"}]}], "}"}]}], "]"}], ";", 
       RowBox[{"(*", 
        RowBox[{"end", " ", "do", " ", "loop"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"end", " ", "do", " ", "loop"}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"create", " ", "plot"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"dsnbFluxList", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{"dsnbFluxList", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "3"}], "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"Joined", "->", "True"}], ",", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"dsnbFluxList", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           
           RowBox[{"\"\<MeV\>\"", 
            ",", "\"\<\!\(\*SuperscriptBox[\(MeV\), \
\(-1\)]\)\!\(\*SuperscriptBox[\(cm\), \(-2\)]\)\!\(\*SuperscriptBox[\(s\), \
\(-1\)]\)\>\""}], "}"}]}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "40"}], "}"}], ",", "All"}], "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", "title"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"end", " ", "module"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.98744551905759*^9, 3.98744552167548*^9}, {
