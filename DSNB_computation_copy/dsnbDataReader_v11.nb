      RowBox[{"bin", " ", "syn"}]}]}], ",", 
    RowBox[{"no", " ", "bin", " ", "syn"}], ",", 
    RowBox[{
     RowBox[{"and", " ", "progen"}], "+", "engine"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"dataDirs", ";"}]}]], "Input",
