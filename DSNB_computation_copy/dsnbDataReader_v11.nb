Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SKindicationPlot", "=", 
   RowBox[{"ListLogPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"globalExtremaAllNHSFR", "[", 
         RowBox[{"[", 
