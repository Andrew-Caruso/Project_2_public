Cell[CellGroupData[{

Cell["DSNB integrator", "Subsubsection",
 CellChangeTimes->{{3.970567955478879*^9, 
  3.970567969126882*^9}},ExpressionUUID->"eb0f56d9-94fe-49b8-a08f-\
a4d0d95041f1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"take", " ", "in", " ", "dsnb", " ", "flux", " ", "data", " ", 
    RowBox[{"{", 
     RowBox[{"Enu", ",", "flux"}], "}"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Enu", "~", "MeV"}], " ", "and", " ", 
    RowBox[{"flux", "~", 
     SuperscriptBox["MeV", 
      RowBox[{"-", "1"}]]}], 
    SuperscriptBox["cm", 
     RowBox[{"-", "2"}]], 
    SuperscriptBox["s", 
     RowBox[{"-", "1"}]]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"and", " ", "chosen", " ", "energy", " ", "range", " ", "list", " ", 
    RowBox[{"{", 
     RowBox[{"Emin", ",", "Emax"}], "}"}], " ", "to", " ", "integrate"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "interpolate", " ", "and", " ", "output", " ", "energy", " ", "integrated",
     " ", "DSNB", " ", "flux", " ", 
    SuperscriptBox["cm", 
     RowBox[{"-", "2"}]], 
    SuperscriptBox["s", 
     RowBox[{"-", "1"}]]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dsnbFluxIntegrator", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"fluxData", "=", "x"}], ",", 
        RowBox[{"rangeList", "=", "y"}]}], "}"}], ",", "\[IndentingNewLine]", 
      
      RowBox[{
       RowBox[{"tempInterpFlux", "=", 
        RowBox[{"Interpolation", "[", "fluxData", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"tempInterpFlux", "[", "z", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", 
           RowBox[{"rangeList", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"rangeList", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"end", " ", "module"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.970567975804244*^9, 3.970568028240436*^9}, {
  3.970568076709312*^9, 3.970568284018224*^9}, {3.970568379887149*^9, 
