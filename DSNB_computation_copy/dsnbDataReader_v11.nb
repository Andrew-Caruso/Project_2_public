Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"interpolate", " ", "fiducial", " ", "DSNB", " ", "flux"}], "*)"}],
   "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fidFunc", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{"fiducialData", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", 
         RowBox[{"-", "1"}]}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "get", " ", "y", " ", "values", " ", "corresponding", " ", "to", " ", "x",
      " ", "medians"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"yVals", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"fidFunc", "[", "x", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "xVals"}], "}"}]}], "]"}]}]}]}]], "Input",
