Cell[BoxData[
 RowBox[{"ListStepPlot", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"binner", "[", 
      RowBox[{"fig7Lunardini", ",", "energyBins2"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"binner", "[", 
      RowBox[{
       RowBox[{"fiducialData", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "]"}], "]"}], ",", "energyBins2"}], "]"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"binner", "[", 
      RowBox[{
       RowBox[{"Sort", "[", "fig6MeVtop", "]"}], ",", "energyBins2"}], 
      "]"}]}], "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "->", 
    RowBox[{"\"\<Bin width: \>\"", "<>", 
     RowBox[{"ToString", "[", 
      RowBox[{
       RowBox[{"energyBins2", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "2"}], "]"}], "]"}], "-", 
       RowBox[{"energyBins2", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], 
     "<>", "\"\< MeV\>\""}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"Joined", "->", "True"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Figure 7 Lunardini et al. 2025 (no MSW)\>\"", 
      ",", "\"\<Fiducial (T = 4.7 MeV, coef = 17.4)\>\"", 
      ",", "\"\<Max Horiuchi et al. 2009 (T = 6 MeV)\>\"", 
      ",", "\"\<Max temp T = 5.7-5.8 MeV\>\"", ",", "None"}], "}"}]}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
