Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"from", " ", "particle", " ", "data", " ", "base"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"and", " ", "from", " ", "conversion", " ", 
     RowBox[{"table", ":", " ", "https", ":"}]}], "//", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"www", ".", "saha", ".", "ac", ".", "in"}], "/", "theory"}], "/", 
      RowBox[{"palashbaran", ".", "pal"}]}], "/", 
     RowBox[{"conv", ".", "html"}]}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"for", " ", "distance"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", "distance", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"inversecm", "=", 
     RowBox[{"1.98", "*", 
      SuperscriptBox["10", 
       RowBox[{"-", "14"}]], "GeV"}]}], 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"i", ".", "e", ".", " ", "GeV"}], " ", "cm"}], "*)"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"m", " ", "=", " ", 
     RowBox[{"100", "*", 
      SuperscriptBox["inversecm", 
       RowBox[{"-", "1"}]]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"km", " ", "=", 
     RowBox[{"1000", "m"}]}], " ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"i", ".", "e", ".", " ", "m"}], "/", "km"}], "*)"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Mpc", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"3.08567758149", "*", 
        SuperscriptBox["10", "16"]}], ")"}], "*", 
      RowBox[{"(", 
       SuperscriptBox["10", "6"], ")"}], "m"}]}], " ", 
    RowBox[{"(*", 
     RowBox[{"pc", "->", 
      RowBox[{"Mpc", " ", 
       RowBox[{
        RowBox[{"i", ".", "e", ".", " ", "m"}], "/", "Mpc"}]}]}], "*)"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "time", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"inverseSecond", "=", 
     RowBox[{"6.58", "*", 
      SuperscriptBox["10", 
       RowBox[{"-", "25"}]], "GeV"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"year", "=", 
     RowBox[{"365", "*", "24", "*", "60", "*", "60", "*", 
      SuperscriptBox[
       RowBox[{"(", "inverseSecond", ")"}], 
       RowBox[{"-", "1"}]]}]}], 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"i", ".", "e", ".", " ", "seconds"}], "/", "year"}], "*)"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yearToSec", "=", 
     RowBox[{"365", "*", "24", "*", "60", "*", "60"}]}], 
    RowBox[{"(*", 
     RowBox[{"seconds", ",", " ", 
      RowBox[{
       RowBox[{"i", ".", "e", ".", " ", "seconds"}], "/", "year"}]}], "*)"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "mass", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"g", "=", 
     RowBox[{"5.62", "*", 
      SuperscriptBox["10", "23"], "*", "GeV"}]}], 
    RowBox[{"(*", 
     RowBox[{"GeV", "/", "g"}], "*)"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kg", "=", 
     RowBox[{"1000", "*", "g"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Msol", "=", 
     RowBox[{"1.98841", "*", 
      SuperscriptBox["10", "30"], "kg"}]}], ";"}]}]}]], "Input",
