Cell["\<\
select only BHNS (i.e. throw away all NS i.e. without criterion case) and 2P \
criterion (i.e. do not use 1P criterion)\
\>", "Text",
 CellChangeTimes->{{3.981976118091055*^9, 3.9819761459774523`*^9}, {
  3.9819762252350273`*^9, 
  3.981976248795904*^9}},ExpressionUUID->"8d7cd56c-b6fc-42bd-8064-\
82ed88c5822a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"select", " ", "only", " ", "BHNS", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"i", ".", "e", ".", "throw"}], " ", "away", " ", "all", " ", 
      "NS", " ", 
      RowBox[{"i", ".", "e", ".", "without"}], " ", "criterion", " ", 
      "case"}], ")"}], " ", "and", " ", "2", "P", " ", "criterion", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"i", ".", "e", ".", "do"}], " ", "not", " ", "use", " ", "1", 
      "P", " ", "criterion"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"select", " ", "only", " ", "BHNS", " ", 
    RowBox[{"(", 
     RowBox[{"with", " ", "criterion"}], ")"}], " ", "and", " ", "2", "P", " ",
     "criterion", " ", 
    RowBox[{"(", 
     RowBox[{"is2Pbool", "=", "1"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"i", ".", "e", ".", " ", "omit"}], " ", "all", " ", "NS", " ", 
    RowBox[{"(", 
     RowBox[{"without", " ", "criterion"}], ")"}], " ", "and", " ", "1", "P", 
    " ", "criterion", " ", "case"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"but", " ", "varying", " ", "everything", " ", "else", " ", 
    RowBox[{"(", 
     RowBox[{"alpha", ",", " ", 
      RowBox[{"Max", " ", "NS"}], ",", " ", 
      RowBox[{"bin", " ", "syn", " ", "model", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"rot", " ", "model"}], "+", 
         RowBox[{"CE", " ", "parameter"}]}], ")"}]}], ",", " ", 
      RowBox[{"single", " ", "VS", " ", "binary", " ", "stars", " ", 
       RowBox[{"(", 
        RowBox[{"data", " ", "set"}], ")"}]}], ",", " ", 
      RowBox[{"engine", " ", "model"}], ",", " ", 
      RowBox[{"no", " ", "MSW", " ", "vs", " ", 
       RowBox[{"IH", "/", "NS"}]}]}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
  
  RowBox[{
   RowBox[{
    RowBox[{"globalDataAll", "=", 
     RowBox[{"selectorRecursive", "[", 
      RowBox[{"dataAll", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "\"\<BHNS\>\""}], "}"}], ",", "1"}], "]"}]}], ";"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"for", " ", "no", " ", "MSW", " ", "effect"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"globalDataAllnoMSW", "=", 
     RowBox[{"selectorRecursive", "[", 
      RowBox[{"dataAll", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "\"\<BHNS\>\"", ",", "\"\<no MSW\>\""}], "}"}], ",",
        "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"for", " ", "IH", " ", "only"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"globalDataAllIH", "=", 
     RowBox[{"selectorRecursive", "[", 
      RowBox[{"dataAll", ",", 
       RowBox[{"{", 
