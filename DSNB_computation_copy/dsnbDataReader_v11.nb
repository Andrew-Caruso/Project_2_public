Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"interpolate", " ", 
    RowBox[{"max", "/", "min"}], " ", "DSNB", " ", "flux", " ", "without", " ",
     "SFR", " ", "uncertianty"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"maxFunc", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{
       RowBox[{"globalExtremaAllNH", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "2"}], "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"-", "1"}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minFunc", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{
       RowBox[{"globalExtremaAllNH", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "2"}], "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"-", "1"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"interpolate", " ", 
     RowBox[{"max", "/", "min"}], " ", "DSNB", " ", "flux", " ", "with", " ", 
     "SFR", " ", "uncertianty"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxFuncSFR", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{
       RowBox[{"globalExtremaAllNHSFR", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "2"}], "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"-", "1"}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minFuncSFR", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{
       RowBox[{"globalExtremaAllNHSFR", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "2"}], "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"-", "1"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "get", " ", "y", " ", "values", " ", "corresponding", " ", "to", " ", "x",
      " ", "medians"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"without", " ", "SFR"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yValsMax", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"maxFunc", "[", "x", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "xVals"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yValsMin", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"minFunc", "[", "x", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "xVals"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"with", " ", "SFR"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yValsMaxSFR", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"maxFuncSFR", "[", "x", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "xVals"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yValsMinSFR", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"minFuncSFR", "[", "x", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "xVals"}], "}"}]}], "]"}]}], ";"}]}]}]], "Input",
