Cell["full temperature finder", "Subsubsection",
 CellChangeTimes->{{3.9879567487541323`*^9, 
  3.98795675225388*^9}},ExpressionUUID->"7d6a7917-2c41-4dde-9e35-\
6012dfaffa20"],

Cell["\<\
find corresponding temperature for entire DSNB flux given range\
\>", "Text",
 CellChangeTimes->{{3.987956766183123*^9, 
  3.987956778598455*^9}},ExpressionUUID->"83514dd0-e15c-4112-8144-\
57a686c44a5a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "find", " ", "corresponding", " ", "temperature", " ", "for", " ", 
    "entire", " ", "DSNB", " ", "flux", " ", "given", " ", "range"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"tempFinderFull", "[", "x_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"data", "=", "x"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fitPara", "=", 
        RowBox[{"FindFit", "[", 
         RowBox[{"data", ",", 
          RowBox[{"fermiDirac", "[", 
           RowBox[{"y", ",", "a", ",", "b"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b"}], "}"}], ",", "y"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
