Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"reorder", " ", "dataDirs", " ", "by", " ", "scenario"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"index", " ", "1", " ", "BinSyn_data"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"index", " ", "2", " ", "no", " ", "BinSyn_data"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"index", " ", "3", " ", "progenEngine_data"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "each", " ", "is", " ", "in", " ", "order", " ", "of", " ", "increasing", " ",
     "alpha"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"a1", ".0"}], ",", 
    RowBox[{"a1", ".5"}], ",", 
    RowBox[{"a2", ".0"}], ",", 
    RowBox[{"a2", ".5"}], ",", 
    RowBox[{"and", " ", "a3", ".0"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"thriceDataDirs", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"selectorStr", "[", 
       RowBox[{
        RowBox[{"antiSelectorStr", "[", 
         RowBox[{"dataDirs", ",", "\"\<no\>\""}], "]"}], 
        ",", "\"\<binSyn\>\""}], "]"}], ",", 
      RowBox[{"selectorStr", "[", 
       RowBox[{"dataDirs", ",", "\"\<nobinSyn_data\>\""}], "]"}], ",", 
      RowBox[{"selectorStr", "[", 
       RowBox[{"dataDirs", ",", "\"\<progenEngine_data\>\""}], "]"}]}], 
     "}"}]}], ";"}]}]], "Input",
