Cell["\<\
take in reformated DSNB data and extract only cases that contain the string\
\>", "Text",
 CellChangeTimes->{{3.9688536979887342`*^9, 
  3.968853719081502*^9}},ExpressionUUID->"14be7394-0ca8-4304-a4da-\
b2f9e1ac3b08"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"selectorStr", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"data", "=", "x"}], ",", 
        RowBox[{"str", "=", "y"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "recall", " ", "format", " ", "of", " ", "input", " ", "data", " ", 
        "is", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "case", ",", "intFlux", ",", "outliers", ",", "DSNBflux", ","}], 
           "}"}], ",", "..."}], "}"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "select", " ", "from", " ", "a", " ", "list", " ", "of", " ", 
        "sublists"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "all", " ", "sublists", " ", "that", " ", "match", " ", "a", " ", 
        "phrase", " ", "in", " ", "the", " ", "nth", " ", "index", " ", "of", 
        " ", "the", " ", "list"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"i", ".", "e", ".", " ", "select"}], " ", "all", " ", "cases",
         " ", "that", " ", "contain", " ", "that", " ", "phrase", " ", "in", " ",
         "the", " ", "case"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"e", ".", "g", ".", " ", "get"}], " ", "all", " ", "cases", " ",
         "that", " ", "contain", 
        " ", "\"\<W18 in them, although none of the items/phrases in the list \
of strings exactly match this\>\""}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "but", " ", "some", " ", "may", " ", "contain", " ", "this", " ", 
        "string"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Select", "[", 
       RowBox[{"data", ",", 
        RowBox[{
         RowBox[{"StringContainsQ", "[", 
          RowBox[{
           RowBox[{"ToString", "[", "#", "]"}], ",", "str"}], "]"}], "&"}]}], 
       "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], ";"}], 
  
  RowBox[{"(*", 
   RowBox[{"end", " ", "module"}], "*)"}], "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{
  3.96885369316354*^9, {3.968853734220676*^9, 3.9688538868620777`*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"2f490a52-4b3e-414d-8035-4af2ec146966"]
