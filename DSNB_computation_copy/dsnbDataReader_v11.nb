Cell[CellGroupData[{

Cell["high-end temperature finder", "Subsubsection",
 CellChangeTimes->{{3.9874995897100554`*^9, 
  3.9874995959540462`*^9}},ExpressionUUID->"1cd5d418-d55f-415c-aa08-\
4816377df49b"],

Cell["\<\
find corresponding temperature for high energy end (beyond max) DSNB flux\
\>", "Text",
 CellChangeTimes->{{3.987499597608513*^9, 
  3.987499612442041*^9}},ExpressionUUID->"c4f35c5a-1a85-43ea-bd7f-\
3cd12c28b1ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "find", " ", "corresponding", " ", "temperature", " ", "for", " ", "high", 
    " ", "energy", " ", "end", " ", 
    RowBox[{"(", 
     RowBox[{"beyond", " ", "max"}], ")"}], " ", "DSNB", " ", "flux"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "input", " ", "data", " ", "is", " ", "a", " ", "list", " ", "of", " ", 
    "DSNB", " ", "flux"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"tempFinder", "[", "x_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"data", "=", "x"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"find", " ", "max", " ", "dsnb", " ", "flux", " ", "index"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tempMaxIndex", "=", 
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{"data", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{"Max", "[", 
            RowBox[{"data", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "find", " ", "data", " ", "only", " ", "above", " ", "the", " ", 
         "max", " ", "to", " ", "generic", " ", "fermi", " ", "dirac", " ", 
         "distribution"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"fitPara", "=", 
        RowBox[{"FindFit", "[", 
         RowBox[{
          RowBox[{"data", "[", 
           RowBox[{"[", 
            RowBox[{"tempMaxIndex", ";;", 
             RowBox[{"Length", "[", "data", "]"}]}], "]"}], "]"}], ",", 
          RowBox[{"fermiDirac", "[", 
           RowBox[{"y", ",", "a", ",", "b"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b"}], "}"}], ",", "y"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"output", " ", "the", " ", "temperature"}], ",", " ", 
         RowBox[{"numerator", " ", "value"}], ",", " ", "maxIndex"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"fitPara", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", 
         RowBox[{"fitPara", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", "tempMaxIndex"}], 
        "}"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"end", " ", "module"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.9874996159848833`*^9, 3.987499629878216*^9}, {
  3.987499759983203*^9, 3.987500025419866*^9}, {3.987500173523185*^9, 
  3.987500313830263*^9}, {3.987500355543447*^9, 3.987500377338225*^9}, {
  3.987500472809229*^9, 3.9875004910275717`*^9}, {3.9875005227680492`*^9, 
  3.987500566189204*^9}, {3.98750077832014*^9, 3.987500790807604*^9}, {
  3.9879567576691113`*^9, 3.987956759190151*^9}},
 CellLabel->
  "In[139]:=",ExpressionUUID->"41816b87-a30d-458a-91cf-23c92235e8cc"]
}, Closed]],

