         RowBox[{"include", " ", "energy", " ", "range"}], ")"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"plotTitle", "=", 
       RowBox[{"TempPlotTitle", "<>", "\"\< (\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"boundList", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "<>", "\"\<-\>\"", "<>", 
        RowBox[{"ToString", "[", 
