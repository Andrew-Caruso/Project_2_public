64ff1539887d"],

Cell["\<\
take in a list of data for single case, e.g. binSynModel or maxMNS\
\>", "Text",
 CellChangeTimes->{{3.9823158634173603`*^9, 3.982315884606338*^9}, 
   3.982577391228519*^9},ExpressionUUID->"3e5bd523-78c3-4ceb-9068-\
efadf6064483"],

Cell["and prepare data to be plotted compared to old SK bound ", "Text",
 CellChangeTimes->{{3.9823158920223303`*^9, 
  3.982315903187443*^9}},ExpressionUUID->"6d61a2f3-92c7-4241-bf9e-\
489d204aa87e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"skBoundEvader", "[", 
     RowBox[{"x_", ",", "in_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"dataList", "=", "x"}], ",", 
        RowBox[{"varIndex", "=", "in"}]}], "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"make", " ", "list", " ", "of", " ", "extrema"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"titlesDataList", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "start", " ", "loop", " ", "of", " ", "list", " ", "of", " ", 
         "data"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"get", " ", "extrema"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"If", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"dataList", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}], ">=", 
             RowBox[{
              RowBox[{"fiducialData", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "2"}], "]"}], "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"tempExtrema", "=", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<max case\>\"", ",", 
                 RowBox[{"dataList", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"\"\<max index\>\"", ",", "\"\<inapplicable\>\""}], 
                  "}"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"\"\<min case\>\"", ",", 
                 RowBox[{"fiducialData", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"\"\<min index\>\"", ",", "\"\<inapplicable\>\""}], 
                  "}"}]}], "}"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"tempExtrema", "=", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<max case\>\"", ",", 
                 RowBox[{"fiducialData", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"\"\<max index\>\"", ",", "\"\<inapplicable\>\""}], 
                  "}"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"\"\<min case\>\"", ",", 
                 RowBox[{"dataList", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"\"\<min index\>\"", ",", "\"\<inapplicable\>\""}], 
                  "}"}]}], "}"}]}], "}"}]}]}], "\[IndentingNewLine]", "]"}], ";", 
          RowBox[{"(*", 
           RowBox[{"end", " ", "if", " ", "branch"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"append", " ", "to", " ", "full", " ", "list"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"titlesDataList", ",", 
            RowBox[{"{", 
             RowBox[{"fiducialData", ",", "tempExtrema", ",", 
              RowBox[{"ToString", "[", 
               RowBox[{
                RowBox[{"dataList", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "varIndex"}], "]"}], "]"}], "]"}]}], 
             "}"}]}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"single", " ", "point", " ", "version"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"tempExtrema", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\"\<max case\>\"", ",", 
               RowBox[{"dataList", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"\"\<max index\>\"", ",", "\"\<inapplicable\>\""}], 
                "}"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"\"\<min case\>\"", ",", 
               RowBox[{"dataList", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"\"\<min index\>\"", ",", "\"\<inapplicable\>\""}], 
                "}"}]}], "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"titlesDataList", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"dataList", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "}"}], ",", "tempExtrema", ",", 
              RowBox[{"ToString", "[", 
               RowBox[{
                RowBox[{"dataList", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "varIndex"}], "]"}], "]"}], "]"}]}], 
             "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "dataList", "]"}]}], "}"}]}], "]"}], ";", 
       RowBox[{"(*", 
        RowBox[{"end", " ", "do", " ", "loop"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "output", " ", "entire", " ", "list", " ", "of", " ", "titledata", " ",
          "lists"}], "*)"}], "\[IndentingNewLine]", "titlesDataList"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"end", " ", "module"}], "*)"}]}]], "Input",
