Cell[BoxData[
 RowBox[{"stepPlotExtrema", "=", 
  RowBox[{"ListStepPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "xStartyValsPlusMax", ",", "xStartyValsPlusMin", ",", 
      "xStartyValsPlusMaxSFR", ",", "xStartyValsPlusMinSFR"}], "}"}], ",", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<MeV\>\"", 
       ",", "\"\<\!\(\*SuperscriptBox[\(MeV\), \(-1\)]\)\!\(\*SuperscriptBox[\
\(cm\), \(-2\)]\)\!\(\*SuperscriptBox[\(s\), \(-1\)]\)\>\""}], "}"}]}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{"xRange", ",", "yRange"}], "}"}]}], ",", 
    RowBox[{"ScalingFunctions", "->", "\"\<Log\>\""}], ",", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Max (NH without SFR uncertainty)\>\"", 
       ",", "\"\<Min (NH without SFR uncertainty)\>\"", 
       ",", "\"\<Max (NH with SFR uncertainty)\>\"", 
       ",", "\"\<Min (NH with SFR uncertainty)\>\""}], "}"}]}]}], 
