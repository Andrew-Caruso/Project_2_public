Cell[CellGroupData[{

Cell["integrated DSNB flux plotter II", "Subsubsection",
 CellChangeTimes->{{3.980497682678588*^9, 
  3.980497695873789*^9}},ExpressionUUID->"400c609e-b287-4f2a-a289-\
eeed9bcc9f4c"],

Cell["to replicate fig 10 from Kresse et al. 2021", "Text",
 CellChangeTimes->{{3.980501573119154*^9, 
  3.980501581777461*^9}},ExpressionUUID->"fd1c89dd-0f2a-4893-8a7f-\
fa885fe4ef9d"],

Cell["\<\
(*NOTE: that these integrated DSNB values are NOT already in the data for \
EnuLowerBound-40 MeV*)\
\>", "Text",
 CellChangeTimes->{
  3.970666106671248*^9},ExpressionUUID->"69181320-7368-40cd-95be-\
cc3686c4d7fb"],

Cell["\<\
basically this is a generalized version of integrated DSNB flux errorBar \
plotter (i.e. does integration explicitly)
and does not take on the already integrated DSNB flux values in the data \
(already done in previous code for only 10-30 MeV Enu range)\
\>", "Text",
 CellChangeTimes->{{3.970666434797297*^9, 
  3.9706664881849337`*^9}},ExpressionUUID->"0a5d3bb6-e5ee-4de2-9b23-\
3ec5c8b208a9"],

Cell["\<\
version II of previous, but now only deals with single engines to replicate \
fig 10 of Kresse et al. 2021 \
\>", "Text",
 CellChangeTimes->{{3.980499468046185*^9, 
  3.980499489003685*^9}},ExpressionUUID->"9e70e7b7-1536-49bd-9f4d-\
26b20b30bef7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "plot", " ", "n", " ", "cases", " ", "of", " ", "integrated", " ", "DSNB", 
    " ", "fluxes"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"DSNB", " ", "flux", " ", "in", " ", "units", " ", "of", " ", 
    RowBox[{"MeV", "^", 
     RowBox[{"-", "1"}]}], " ", 
    RowBox[{"cm", "^", 
     RowBox[{"-", "2"}]}], " ", 
    RowBox[{"s", "^", 
     RowBox[{"-", "1"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "integrated", " ", "DSNB", " ", "flux", " ", "in", " ", "units", " ", "of",
     " ", 
    RowBox[{"MeV", "^", 
     RowBox[{"-", "1"}]}], " ", 
    RowBox[{"cm", "^", 
     RowBox[{"-", "2"}]}], " ", 
    RowBox[{"s", "^", 
     RowBox[{"-", "1"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"given", " ", "first", " ", "input", " ", "fidExtrTlist", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fiducialData", ",", " ", 
        RowBox[{"extremaData", 
         RowBox[{"(", 
          RowBox[{"min", "/", "max"}], ")"}]}], ",", " ", "title"}], "}"}], ",",
       "..."}], "}"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "and", " ", "second", " ", "input", " ", "as", " ", "TempPlotTitle"}], 
    " ", "=", " ", 
    RowBox[{"plot", " ", "title"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"and", " ", "third", " ", "input", " ", "as", " ", "boundList"}], 
    " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
