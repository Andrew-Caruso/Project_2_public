Cell[CellGroupData[{

Cell["integrated DSNB flux plotter", "Subsubsection",
 CellChangeTimes->{{3.9706649142746*^9, 
  3.970664929506769*^9}},ExpressionUUID->"97772e6a-bff0-4664-b4bb-\
4984b0b217f4"],

Cell["\<\
(*NOTE: that these integrated DSNB values are NOT already in the data for \
EnuLowerBound-40 MeV*)\
\>", "Text",
 CellChangeTimes->{
  3.970666106671248*^9},ExpressionUUID->"e12dedc8-2e23-4b30-8aab-\
e1e8f429e879"],

Cell["\<\
basically this is a generalized version of integrated DSNB flux errorBar \
plotter (i.e. does integration explicitly)
and does not take on the already integrated DSNB flux values in the data \
(already done in previous code for only 10-30 MeV Enu range)\
\>", "Text",
 CellChangeTimes->{{3.970666434797297*^9, 
  3.9706664881849337`*^9}},ExpressionUUID->"ca794760-5c83-4bea-ba24-\
53f82f6b199f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "plot", " ", "n", " ", "cases", " ", "of", " ", "integrated", " ", "DSNB", 
    " ", "fluxes"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"DSNB", " ", "flux", " ", "in", " ", "units", " ", "of", " ", 
    RowBox[{"MeV", "^", 
     RowBox[{"-", "1"}]}], " ", 
    RowBox[{"cm", "^", 
     RowBox[{"-", "2"}]}], " ", 
    RowBox[{"s", "^", 
     RowBox[{"-", "1"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "integrated", " ", "DSNB", " ", "flux", " ", "in", " ", "units", " ", "of",
     " ", 
    RowBox[{"MeV", "^", 
     RowBox[{"-", "1"}]}], " ", 
    RowBox[{"cm", "^", 
     RowBox[{"-", "2"}]}], " ", 
    RowBox[{"s", "^", 
     RowBox[{"-", "1"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"given", " ", "first", " ", "input", " ", "fidExtrTlist", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fiducialData", ",", " ", 
        RowBox[{"extremaData", 
         RowBox[{"(", 
          RowBox[{"min", "/", "max"}], ")"}]}], ",", " ", "title"}], "}"}], ",",
       "..."}], "}"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "and", " ", "second", " ", "input", " ", "as", " ", "TempPlotTitle"}], 
    " ", "=", " ", 
    RowBox[{"plot", " ", "title"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"and", " ", "third", " ", "input", " ", "as", " ", "boundList"}], 
    " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
     "EnuLowerBound", ",", "EnuUpperBound", ",", "intDSNBfluxUpperBound"}], 
     "}"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"NOTE", ":", " ", 
    RowBox[{
     RowBox[{
     "that", " ", "these", " ", "integrated", " ", "DSNB", " ", "values", " ",
       "are", " ", "NOT", " ", "already", " ", "in", " ", "the", " ", "data", 
      " ", "for", " ", "EnuLowerBound"}], "-", 
     RowBox[{"40", " ", "MeV"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "thus", " ", "need", " ", "to", " ", "interpolate", " ", "and", " ", 
    "integrate", " ", "the", " ", "data", " ", "itself"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"intDSNBplotter", "[", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"fidExtrTlist", "=", "x"}], ",", 
       RowBox[{"TempPlotTitle", "=", "y"}], ",", 
       RowBox[{"boundList", "=", "z"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"will", " ", "be", " ", "filled", " ", "as", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"point", ",", "caseNameXaxis", ",", "legendName"}], "}"}], ",",
          "..."}], "}"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"where", " ", "point"}], " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{"integer", ",", "aroundValue"}], "}"}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"where", " ", "aroundValue"}], " ", "=", " ", 
       RowBox[{
        RowBox[{"value", "^", 
