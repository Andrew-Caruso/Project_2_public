Cell[CellGroupData[{

Cell["Interpolation binner", "Subsubsection",
 CellChangeTimes->{{3.9821703755905743`*^9, 
  3.9821703787655478`*^9}},ExpressionUUID->"fabcd14f-043f-46bf-b346-\
965e3042f302"],

Cell["interpolate fiducial or global extrema DSNB flux", "Text",
 CellChangeTimes->{{3.982170385834725*^9, 
  3.98217040140184*^9}},ExpressionUUID->"160b61bb-4abb-4b79-a62a-\
16122b4f8a45"],

Cell["can use module herein to create binned average DSNB flux ", "Text",
 CellChangeTimes->{{3.9821704031734324`*^9, 
  3.982170416168585*^9}},ExpressionUUID->"4caa2fb1-d7b5-472e-9d3d-\
e2d307929c94"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "input", " ", "data", " ", "must", " ", "be", " ", "in", " ", "format", " ",
     "of", " ", "fiducial", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "taken", " ", "in", " ", "Enu", " ", "bin", " ", "intervals", " ", "and", " ",
     "min", " ", "and", " ", "max", " ", "ranges"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"interpolatorBinner", "[", 
     RowBox[{"x_", ",", "y_", ",", "e1_", ",", "e2_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"DSNBFluxData", "=", "x"}], ",", 
        RowBox[{"binIntervals", "=", "y"}], ",", 
        RowBox[{"Emin", "=", "e1"}], ",", 
        RowBox[{"Emax", "=", "e2"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "interpolate", " ", "the", " ", "data", " ", "in", " ", "same", " ", 
        "format", " ", "as", " ", "fiducial", " ", "data", " ", "format"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tempFunc", "=", 
        RowBox[{"Interpolation", "[", "DSNBFluxData", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"create", " ", "tabulated", " ", "data"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"tempTabData", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"tempFunc", "[", "i", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "Emin", ",", "Emax", ",", "0.1"}], "}"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"bin", " ", "all", " ", "these", " ", "points"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"dataBinner", " ", "[", 
        RowBox[{"tempTabData", ",", "binIntervals"}], "]"}]}]}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",\

 CellChangeTimes->{{3.982170423614562*^9, 3.982170479144112*^9}, {
  3.982170594053644*^9, 3.98217066974862*^9}, {3.982170729920065*^9, 
  3.9821708111584873`*^9}, {3.982170984563628*^9, 3.98217102978085*^9}, {
  3.982171179274234*^9, 3.98217119011679*^9}, {3.9821712689794292`*^9, 
  3.9821712705779552`*^9}, {3.9821713708899097`*^9, 3.9821713811194468`*^9}, {
  3.982171472262182*^9, 3.9821714899303417`*^9}, {3.982171645318211*^9, 
  3.982171659465115*^9}, {3.982171700452471*^9, 3.9821717220104027`*^9}},
 CellLabel->
  "In[415]:=",ExpressionUUID->"853a21a6-7a5d-4ebd-862c-35abcd1090d2"]
}, Closed]],

Cell[CellGroupData[{

Cell["converted binned data integrator ", "Subsubsection",
 CellChangeTimes->{{3.9832930868640203`*^9, 
  3.9832931014494133`*^9}},ExpressionUUID->"13126f4c-acc5-48f9-94df-\
13e3f32b6626"],

Cell["convert binned DSNB flux data into event rates per bin ", "Text",
 CellChangeTimes->{{3.98329310545634*^9, 
  3.983293120764061*^9}},ExpressionUUID->"e6aa721f-d118-4893-8256-\
29f01b5fd308"],

Cell[BoxData[
 RowBox[{
  RowBox[{"binnedDataIntegrator", "[", "x_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"allbinnedData", "=", "x"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"format", " ", "as", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"integratedDSNB", ",", " ", "case"}], "}"}], ",", "..."}], 
       "}"}]}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"in", " ", "units", " ", "of", " ", 
      RowBox[{"cm", "^", 
       RowBox[{"-", "2"}]}], " ", 
      RowBox[{"s", "^", 
       RowBox[{"-", "1"}]}]}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"output", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"get", " ", "the", " ", "case"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"tempCase", "=", 
         RowBox[{"binnedData", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"tempData3", "=", 
           RowBox[{"binnedData", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"tempData3", "=", 
         RowBox[{"binnedData", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", 
            RowBox[{
             RowBox[{"-", "2"}], ";;", 
             RowBox[{"-", "1"}]}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tempIntegratedDSNBvalue", "=", 
         RowBox[{"Total", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"tempData3", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "2"}], "]"}], "]"}], "-", 
               RowBox[{
                RowBox[{"tempData3", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ")"}], "*", 
             RowBox[{
              RowBox[{"tempData3", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"Length", "[", "tempData3", "]"}]}], "}"}]}], "]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"append", " ", "to", " ", "output"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"output", ",", 
          RowBox[{"{", 
           RowBox[{"tempIntegratedDSNBvalue", ",", "tempCase"}], "}"}]}], 
         "]"}]}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"binnedData", ",", "allbinnedData"}], "}"}]}], "]"}], ";", 
     " ", 
     RowBox[{"(*", 
      RowBox[{
      "end", " ", "do", " ", "outer", " ", "loop", " ", "for", " ", "all", " ",
        "cases"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"throw", " ", "out", " ", "the", " ", "output"}], "*)"}], 
     "\[IndentingNewLine]", "output"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.983280198513876*^9, 3.9832802939931297`*^9}, {
  3.9832803430403233`*^9, 3.983280551700501*^9}, {3.983280587026381*^9, 
  3.983280629292254*^9}, {3.983280660385594*^9, 3.983280733603696*^9}, {
  3.983280788882947*^9, 3.9832809105769978`*^9}, {3.98328103670794*^9, 
  3.9832811273858843`*^9}, {3.983281166073393*^9, 3.983281168688387*^9}, {
  3.983281322299424*^9, 3.983281329753407*^9}, {3.98328137911732*^9, 
  3.9832814406527023`*^9}, {3.983286027478883*^9, 3.983286054150523*^9}, {
  3.983288245366197*^9, 3.983288260341663*^9}, {3.9832894503705597`*^9, 
  3.983289457179068*^9}, {3.983289493511697*^9, 3.983289497419026*^9}, {
  3.9832895757595797`*^9, 3.9832895978296556`*^9}, {3.983289641751231*^9, 
  3.983289646060482*^9}, {3.9832897644959383`*^9, 3.983289790215029*^9}, {
  3.9832898293133497`*^9, 3.98328983434787*^9}},
 CellLabel->
  "In[416]:=",ExpressionUUID->"f3b8f3c7-4836-4f1b-9136-e4aed74e41ca"]
}, Closed]],

Cell[CellGroupData[{

Cell["DSNB flux selector", "Subsubsection",
 CellChangeTimes->{{3.98965844827343*^9, 3.989658454016529*^9}, {
  3.9896591125862913`*^9, 
  3.989659113326476*^9}},ExpressionUUID->"82f58385-a33b-455d-ad9f-\
5d026b9554d4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"take", " ", "in", " ", "DSNB", " ", "flux", " ", "data"}], "*)"}],
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"in", " ", "format", " ", "of", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Enu", ",", "flux"}], "}"}], ",", "..."}], "}"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "and", " ", "select", " ", "only", " ", "in", " ", "relevant", " ", 
    "energy", " ", "range"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dsnbSelector", "[", 
     RowBox[{"z_", ",", "x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"dsnbFlux", "=", "z"}], ",", 
        RowBox[{"min", "=", "x"}], ",", 
        RowBox[{"max", "=", "y"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Select", "[", 
       RowBox[{"dsnbFlux", " ", ",", 
        RowBox[{
         RowBox[{"min", "<", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "<", "max"}], "&"}]}], "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"end", " ", "module"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.989659023185212*^9, 3.989659122925378*^9}},
 CellLabel->
  "In[417]:=",ExpressionUUID->"b9e055af-07df-4d92-9bff-fdf98edd3220"]
}, Closed]],

Cell[CellGroupData[{

Cell["binner ", "Subsubsection",
 CellChangeTimes->{{3.9902825304460506`*^9, 
  3.990282531223619*^9}},ExpressionUUID->"065f936c-1701-4c8d-94c8-\
04d11e0e136c"],

Cell["take energy bins and DSNB flux and create listStepPlot data", "Text",
 CellChangeTimes->{{3.990282606363204*^9, 
  3.9902826237243567`*^9}},ExpressionUUID->"d499e419-a466-4065-9fe5-\
542adc6aa830"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"create", " ", "data", " ", "for", " ", "ListStepPlot"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"based", " ", "on", " ", "DSNB", " ", "flux", " ", "data", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Enu", ",", "flux"}], "}"}], "..."}], "}"}]}], ",", " ", 
    RowBox[{"and", " ", "energy", " ", "bins", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x1a", ",", "x1b"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x2a", ",", "x2b"}], "}"}], ",", "..."}], "}"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "x", " ", "is", " ", "energy", " ", "Enu", " ", "and", " ", "y", " ", "is",
     " ", "DSNB", " ", "flux", " ", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["cm", 
       RowBox[{"-", "2"}]], 
      SuperscriptBox["s", 
       RowBox[{"-", "1"}]], 
      SuperscriptBox["MeV", 
       RowBox[{"-", "1"}]]}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"binner", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"data", "=", "x"}], ",", 
        RowBox[{"bins", "=", "y"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "select", " ", "only", " ", "DSNB", " ", "data", " ", "within", " ", 
        "the", " ", "range", " ", "of", " ", "max", " ", "and", " ", "min", " ",
         "energy", " ", "bin", " ", "values"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tempData", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"data", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"bins", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}], "<=", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "<=", 
            RowBox[{"bins", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}]}], "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "make", " ", "function", " ", "of", " ", "selected", " ", "DSNB", " ",
          "data"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"tempFunc", "=", 
        RowBox[{"Interpolation", "[", "tempData", "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"get", " ", "y", " ", 
         RowBox[{"i", ".", "e", ".", " ", "DSNB"}], " ", "flux", " ", 
         "values"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"yList", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "get", " ", "midpoints", " ", "then", " ", "get", " ", 
         "corresponding", " ", "DSNB", " ", "flux"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"tempMid", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"bins", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}], "+", 
              RowBox[{
               RowBox[{"bins", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", "2"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"tempY", "=", 
           RowBox[{"tempFunc", "[", "tempMid", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"yList", ",", "tempY"}], "]"}], ";"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "bins", "]"}]}], "}"}]}], "]"}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{"end", " ", "do", " ", "loop"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"get", " ", "x", " ", "start", " ", "values"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"xStarts", "=", 
        RowBox[{"bins", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"following", " ", "format", " ", "required"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"add", " ", "last", " ", "x", " ", "value"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"xStarts2", "=", " ", 
          RowBox[{"Join", "[", 
           RowBox[{"xStarts", ",", 
            RowBox[{"{", 
             RowBox[{"bins", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}], "}"}]}], 
           "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"add", " ", "last", " ", "midpoint"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"xStarts2", "=", " ", 
        RowBox[{"Join", "[", 
         RowBox[{"xStarts", ",", 
          RowBox[{"{", "tempMid", "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "add", " ", "duplicate", " ", "last", " ", "y", " ", "value"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"yList2", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"yList", ",", 
          RowBox[{"{", 
           RowBox[{"yList", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"format", " ", "output", " ", "data", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y"}], "}"}], "}"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"outputList", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"xStarts2", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{"yList2", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "yList2", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"toss", " ", "out", " ", "the", " ", "output"}], "*)"}], 
       "\[IndentingNewLine]", "outputList"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], 
  RowBox[{"(*", "module", "*)"}]}]], "Input",
