Cell["vary only alpha or pinching parameter ", "Text",
 CellChangeTimes->{
  3.981978819762396*^9},ExpressionUUID->"758aef94-6023-4edd-b9c7-\
9e3a88afadcf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "fix", " ", "fiducial", " ", "model", " ", "except", " ", "vary", " ", 
    "only", " ", "alpha", " ", "or", " ", "pinching", " ", "parameter"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"select", " ", "all", " ", "fiducial", " ", "cases"}], ",", " ", 
    RowBox[{
     RowBox[{"i", ".", "e", ".", " ", "will"}], " ", "only", " ", "vary", " ",
      "via", " ", "alpha"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"then", " ", "extract"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"get", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"alphaCheck", "=", 
     RowBox[{"selectorStr", "[", 
      RowBox[{
       RowBox[{"selectorRecursive", "[", 
        RowBox[{"dataAll", ",", 
         RowBox[{"{", 
          
          RowBox[{"\"\<bin syn\>\"", ",", "\"\<fiducialCE1\>\"", ",", "2.7", ",",
            "1", ",", "\"\<NH\>\"", ",", "\"\<BHNS\>\""}], "}"}], ",", "1"}], 
        "]"}], ",", "\"\<W18\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Length", "[", "alphaCheck", "]"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"find", " ", "extrema"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"localExtremaAlpha", "=", 
     RowBox[{"extremaFinder", "[", "alphaCheck", "]"}]}], ";"}]}]}]], "Input",\

