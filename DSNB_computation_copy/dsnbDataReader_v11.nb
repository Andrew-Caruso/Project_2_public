Cell[CellGroupData[{

Cell["integrated DSNB flux plotter dual ", "Subsubsection",
 CellChangeTimes->{{3.9706649142746*^9, 3.970664929506769*^9}, {
  3.989407267362211*^9, 
  3.98940726832549*^9}},ExpressionUUID->"af63bb99-59ec-4210-af0a-\
f02947c3d539"],

Cell["\<\
(*NOTE: that these integrated DSNB values are NOT already in the data for \
EnuLowerBound-40 MeV*)\
\>", "Text",
 CellChangeTimes->{
  3.970666106671248*^9},ExpressionUUID->"4a91b945-8921-4af5-8c3f-\
75331311da7a"],

Cell["\<\
basically this is a generalized version of integrated DSNB flux errorBar \
plotter (i.e. does integration explicitly)
and does not take on the already integrated DSNB flux values in the data \
(already done in previous code for only 10-30 MeV Enu range)\
\>", "Text",
 CellChangeTimes->{{3.970666434797297*^9, 
  3.9706664881849337`*^9}},ExpressionUUID->"8eff5eee-d263-4fb3-ad1f-\
57658c37a870"],

Cell["\<\
does this for choice of two energy range with error bars side by side\
\>", "Text",
 CellChangeTimes->{{3.9894072963252087`*^9, 
  3.989407308832416*^9}},ExpressionUUID->"5d7c67a8-4224-4167-8827-\
a3a5a5575eb4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "plot", " ", "n", " ", "cases", " ", "of", " ", "integrated", " ", "DSNB", 
    " ", "fluxes"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"DSNB", " ", "flux", " ", "in", " ", "units", " ", "of", " ", 
    RowBox[{"MeV", "^", 
     RowBox[{"-", "1"}]}], " ", 
    RowBox[{"cm", "^", 
     RowBox[{"-", "2"}]}], " ", 
    RowBox[{"s", "^", 
     RowBox[{"-", "1"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "integrated", " ", "DSNB", " ", "flux", " ", "in", " ", "units", " ", "of",
     " ", 
    RowBox[{"MeV", "^", 
     RowBox[{"-", "1"}]}], " ", 
    RowBox[{"cm", "^", 
     RowBox[{"-", "2"}]}], " ", 
    RowBox[{"s", "^", 
     RowBox[{"-", "1"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"given", " ", "first", " ", "input", " ", "fidExtrTlist", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fiducialData", ",", " ", 
        RowBox[{"extremaData", 
         RowBox[{"(", 
          RowBox[{"min", "/", "max"}], ")"}]}], ",", " ", "title"}], "}"}], ",",
       "..."}], "}"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "and", " ", "second", " ", "input", " ", "as", " ", "TempPlotTitle"}], 
    " ", "=", " ", 
    RowBox[{"plot", " ", "title"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"and", " ", "third", " ", "input", " ", "as", " ", "boundList"}], 
    " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
     "EnuLowerBound", ",", "EnuUpperBound", ",", "intDSNBfluxUpperBound"}], 
     "}"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"NOTE", ":", " ", 
    RowBox[{
     RowBox[{
     "that", " ", "these", " ", "integrated", " ", "DSNB", " ", "values", " ",
       "are", " ", "NOT", " ", "already", " ", "in", " ", "the", " ", "data", 
      " ", "for", " ", "EnuLowerBound"}], "-", 
     RowBox[{"40", " ", "MeV"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "thus", " ", "need", " ", "to", " ", "interpolate", " ", "and", " ", 
    "integrate", " ", "the", " ", "data", " ", "itself"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"intDSNBplotterDual", "[", 
     RowBox[{"x_", ",", "y_", ",", "z1_", ",", "z2_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"fidExtrTlist", "=", "x"}], ",", 
        RowBox[{"TempPlotTitle", "=", "y"}], ",", 
        RowBox[{"boundList1", "=", "z1"}], ",", 
        RowBox[{"boundList2", "=", "z2"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"will", " ", "be", " ", "filled", " ", "as", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"point", ",", "caseNameXaxis", ",", "legendName"}], "}"}], 
          ",", "..."}], "}"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"where", " ", "point"}], " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{"integer", ",", "aroundValue"}], "}"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"where", " ", "aroundValue"}], " ", "=", " ", 
        RowBox[{
         RowBox[{"value", "^", 
          RowBox[{"{", 
           RowBox[{"+", 
            RowBox[{"^", "max"}]}], "}"}]}], "_", 
         RowBox[{"{", 
          RowBox[{"-", "min"}], "}"}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"for", " ", "both", " ", "energy", " ", "ranges"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"barPointsT1", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"barPointsT2", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"make", " ", "plot", " ", "title", " ", 
         RowBox[{"(", 
          RowBox[{"include", " ", "energy", " ", "range"}], ")"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"subtitle1", "=", 
        RowBox[{"\"\< (\>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"boundList1", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], "<>", "\"\<-\>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"boundList1", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}], "<>", "\"\< MeV)\>\""}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"subtitle2", "=", 
        RowBox[{"\"\< (\>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"boundList2", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], "<>", "\"\<-\>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"boundList2", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}], "<>", "\"\< MeV)\>\""}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"plotTitle", "=", 
        RowBox[{
        "TempPlotTitle", "<>", "subtitle1", "<>", "\"\< & \>\"", "<>", 
         "subtitle2"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"get", " ", "fiducial", " ", "data"}], ",", " ", 
          RowBox[{"extrema", " ", "data"}], ",", " ", 
