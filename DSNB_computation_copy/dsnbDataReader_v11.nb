Cell["vary only with SFR uncertainty ", "Text",
 CellChangeTimes->{{3.982146611875935*^9, 
  3.982146620943061*^9}},ExpressionUUID->"c921a690-ca4b-4490-af66-\
d2dc04c6d020"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "fix", " ", "fiducial", " ", "model", " ", "except", " ", "vary", " ", 
    "SFR", " ", "uncertainty"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "make", " ", "fake", " ", "fiducial", " ", "max", " ", "and", " ", "min", " ",
     "data", " ", 
    RowBox[{"(", 
     RowBox[{
     "these", " ", "are", " ", "exactly", " ", "the", " ", "same"}]}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fakeExtremaSFR", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<Max\>\"", ",", 
         RowBox[{"fiducialData", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Min\>\"", ",", 
         RowBox[{"fiducialData", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "then", " ", "offset", " ", "them", " ", "by", " ", "SFR", " ", 
     "uncertainty"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"localExtremaSFR", "=", 
     RowBox[{"SFRuncertaintyIncorporator", "[", "fakeExtremaSFR", "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"Length", "[", "localExtremaSFR", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.982146625761587*^9, 3.982146798842573*^9}, {
  3.982146945843088*^9, 3.982146952135168*^9}, {3.982151370540859*^9, 
