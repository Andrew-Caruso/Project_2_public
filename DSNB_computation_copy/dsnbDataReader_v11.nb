        RowBox[{
         RowBox[{"get", " ", "fiducial", " ", "data"}], ",", " ", 
         RowBox[{"extrema", " ", "data"}], ",", " ", 
         RowBox[{
          RowBox[{"and", " ", "case", " ", "x"}], "-", 
          RowBox[{"axis", " ", "title"}]}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"tempfidData2", "=", 
          RowBox[{"fidExtrTlist", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1", ",", "1"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"tempExtremaData2", "=", 
          RowBox[{"fidExtrTlist", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"tempTitle2", "=", 
          RowBox[{"fidExtrTlist", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "3"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "interpolate", " ", "then", " ", "integrated", " ", "DSNB", " ", 
