Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"take", " ", "in", " ", "data", " ", "as"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xmin", ",", "xmax", ",", "xval"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"ymin", ",", "ymax", ",", "yval"}], "}"}]}], "}"}], ",", 
     "..."}], "*)"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"convert", " ", "into", " ", "plot", " ", "ready", " ", "data"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"(*", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "+", 
         RowBox[{
          RowBox[{"/", 
           RowBox[{"-", "max"}]}], "/", "min"}]}], ",", " ", 
        RowBox[{"y", "+", 
         RowBox[{
          RowBox[{"/", 
           RowBox[{"-", "max"}]}], "/", "min"}]}]}], "}"}], "..."}], "}"}], 
    "*)"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"errorBarPointMaker", "[", "x_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"data", "=", "x"}], "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "create", " ", "empty", " ", "list", " ", "for", " ", "output"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"outputData", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"separate", " ", "into", " ", "x"}], ",", " ", "y", ",", " ", 
         RowBox[{"and", " ", "y", " ", 
          RowBox[{"(", 
           RowBox[{"with", " ", "SFR", " ", "uncertainty"}], ")"}]}]}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"each", " ", "formated", " ", "as", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"min", ",", "max", ",", "val"}], "}"}], ",", "..."}], 
          "}"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"xData", "=", 
        RowBox[{
         RowBox[{"Transpose", "[", "data", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "All"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"yData", "=", 
        RowBox[{
         RowBox[{"Transpose", "[", "data", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "All"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "convert", " ", "data", " ", "to", " ", "create", " ", "error", " ", 
         "bar", " ", "points"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"get", " ", 
          RowBox[{"{", 
           RowBox[{"min", ",", " ", "max"}], "}"}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"tempMinMaxX", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"xData", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "[", 
               RowBox[{"[", "3", "]"}], "]"}], "-", 
              RowBox[{
               RowBox[{"xData", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"xData", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}], "-", 
              RowBox[{
               RowBox[{"xData", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "[", 
               RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"tempMinMaxY", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"yData", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "[", 
               RowBox[{"[", "3", "]"}], "]"}], "-", 
              RowBox[{
               RowBox[{"yData", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"yData", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}], "-", 
              RowBox[{
               RowBox[{"yData", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "[", 
               RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "create", " ", "x", " ", "error", " ", "bar", " ", "point"}], 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"tempX", "=", 
           RowBox[{"Around", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"xData", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "[", 
              RowBox[{"[", "3", "]"}], "]"}], ",", "tempMinMaxX"}], "]"}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "create", " ", "y", " ", "error", " ", "bar", " ", "point"}], 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"tempY", "=", 
           RowBox[{"Around", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"yData", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "[", 
              RowBox[{"[", "3", "]"}], "]"}], ",", "tempMinMaxY"}], "]"}]}], ";",
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "create", " ", "plot", " ", "point", " ", "without", " ", "SFR", " ",
             "uncertainty"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"tempPoint", " ", "=", " ", 
           RowBox[{"{", 
            RowBox[{"tempX", ",", "tempY"}], "}"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{"i", ",", "tempPoint"}], "]"}], ";"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "and", " ", "append", " ", "to", " ", "full", " ", "output"}], 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"outputData", ",", "tempPoint"}], "]"}], ";"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "xData", "]"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"end", " ", "do", " ", "loop"}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"output", " ", "all", " ", "data"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "without", " ", "and", " ", "with", " ", "SFR", " ", "uncertainty", " ",
          "respectively"}], "*)"}], "\[IndentingNewLine]", "outputData"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"end", " ", "module"}], "*)"}]}]], "Input",
