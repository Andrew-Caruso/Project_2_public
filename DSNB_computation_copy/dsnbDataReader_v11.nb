         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"with", " ", "SFR"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yValsMaxSFRPlus", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"yValsMaxSFR", ",", 
       RowBox[{"{", 
