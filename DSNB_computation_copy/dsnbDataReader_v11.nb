        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}], ",", 
       RowBox[{"fiducialDataNH", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"globalExtremaAllNH", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "2"}], "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"globalExtremaAllNH", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "2"}], "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}], ",", 
       "SKfig3normalizedHoriuchi2026"}], "}"}], ",", 
     RowBox[{"Joined", "->", "True"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<MeV\>\"", 
        ",", "\"\<\!\(\*SuperscriptBox[\(MeV\), \
\(-1\)]\)\!\(\*SuperscriptBox[\(cm\), \(-2\)]\)\!\(\*SuperscriptBox[\(s\), \
\(-1\)]\)\>\""}], "}"}]}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<DSNB flux (NH)\>\""}], ",", 
