Cell[CellGroupData[{

Cell["SK Bound Evader", "Subsubsection",
 CellChangeTimes->{{3.982577377104705*^9, 
  3.982577381262596*^9}},ExpressionUUID->"319dc4aa-0772-4179-81fe-\
22bafb7b5403"],

Cell["take in a list of data sets for single case e.g. maxNS", "Text",
 CellChangeTimes->{{3.9825773835896463`*^9, 3.982577395230091*^9}, {
  3.982577458130578*^9, 
  3.982577460426609*^9}},ExpressionUUID->"b3659ffd-71d8-443f-9429-\
e3ee50ee1836"],

Cell["for each maxNS mass keep fix but vary everything else", "Text",
 CellChangeTimes->{{3.982577467810299*^9, 
  3.982577481350855*^9}},ExpressionUUID->"548a57e9-ae52-4b17-870a-\
d90727ccc546"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "take", " ", "in", " ", "a", " ", "list", " ", "of", " ", "data", " ", 
    "sets", " ", "for", " ", "single", " ", "case", " ", 
    RowBox[{"e", ".", "g", ".", "maxNS"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "for", " ", "each", " ", "maxNS", " ", "mass", " ", "keep", " ", "fix", " ",
     "but", " ", "vary", " ", "everything", " ", "else"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"skBoundEvaderII", "[", 
     RowBox[{"x_", ",", "in_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"dataList", "=", "x"}], ",", 
        RowBox[{"varIndex", "=", "in"}]}], "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"make", " ", "list", " ", "of", " ", "extrema"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"titlesDataList", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "start", " ", "loop", " ", "of", " ", "list", " ", "of", " ", 
         "data"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"fixedVal", "=", 
           RowBox[{
            RowBox[{"dataList", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "varIndex"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"tempData2", "=", 
           RowBox[{"selectorRecursive", "[", 
            RowBox[{"dataAll", ",", 
             RowBox[{"{", "fixedVal", "}"}], ",", "1"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"tempExtrema2", "=", 
           RowBox[{"extremaFinder", "[", "tempData2", "]"}]}], ";", 
          "\[IndentingNewLine]", 
