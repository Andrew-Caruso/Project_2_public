      " ", 
     RowBox[{
      RowBox[{
       RowBox[{"i", ".", "e", ".", " ", "has"}], " ", "no", " ", "Ee"}], "+", 
      " ", 
      RowBox[{"value", " ", "in", " ", "original", " ", "table"}]}]}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "thus", " ", "skip", " ", "first", " ", "element", " ", "of", " ", 
     "data"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
