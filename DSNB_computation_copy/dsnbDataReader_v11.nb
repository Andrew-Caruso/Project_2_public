    RowBox[{"yValsMinSFRPlus", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"yValsMinSFR", ",", 
       RowBox[{"{", 
        RowBox[{"yValsMinSFR", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], "}"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
