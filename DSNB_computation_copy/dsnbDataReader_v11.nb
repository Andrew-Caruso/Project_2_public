Cell["vary only stellar distribution (combo of two)", "Text",
 CellChangeTimes->{{3.985088976420899*^9, 3.98508898302536*^9}, {
  3.9850892761029263`*^9, 
  3.98508927890901*^9}},ExpressionUUID->"06b24c61-c355-4dee-8eb3-\
eeef8b414adc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "essentially", " ", "vary", " ", "only", " ", "single", " ", "vs", " ", 
    "binary", " ", "stars", " ", "AND", " ", "binary", " ", "model"}], "*)"}],
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "combination", " ", "of", " ", "two", " ", "case", " ", "variables", " ", 
    "varying"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"stellarDistdata", "=", 
     RowBox[{"selectorRecursive", "[", 
      RowBox[{"dataAll", ",", 
       RowBox[{"{", 
        RowBox[{"\"\<W18-BH2.7-a2.0\>\"", ",", "2.7", ",", "1", 
         ",", "\"\<BHNS\>\"", ",", "\"\<NH\>\""}], "}"}], ",", "1"}], "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{"Length", "[", "stellarDistdata", "]"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"find", " ", "extrema"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"localExtremaStellarDist", "=", 
     RowBox[{"extremaFinder", "[", "stellarDistdata", "]"}]}], 
    ";"}]}]}]], "Input",
