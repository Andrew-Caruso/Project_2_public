Cell["vary only max NS mass", "Text",
 CellChangeTimes->{{3.981978351204959*^9, 
  3.981978353983913*^9}},ExpressionUUID->"973dcc20-7bbb-48d1-974a-\
3a5c7b5a660b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "fix", " ", "fiducial", " ", "model", " ", "except", " ", "vary", " ", 
    "only", " ", "max", " ", "NS", " ", "mass", " ", 
    RowBox[{"i", ".", "e", ".", " ", "baryonic"}], " ", "NS", " ", "mass", " ",
     "prior", " ", "to", " ", "BH", " ", "formation"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"varying", " ", "only", " ", "max", " ", "NS", " ", "mass"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "since", " ", "selectorRecursive", " ", "only", " ", "gets", " ", "all", " ",
     "engines", " ", "when", " ", "unfixing", " ", "max", " ", "NS", " ", 
    "mass"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "because", " ", "engine", " ", "formated", " ", "as", 
     " ", "\"\<W18-BH2.3-a2.0\>\""}], ",", "2.3`"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "need", " ", "to", " ", "select", " ", "only", " ", "engines", " ", "that",
     " ", "are", " ", "W18", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"i", ".", "e", ".", " ", "discard"}], " ", "N20"}], ",", " ", 
      "W15", ",", " ", 
      RowBox[{"S19", ".8"}], ",", " ", "W20", ",", " ", 
      RowBox[{
      "since", " ", "there", " ", "is", " ", "only", " ", "these", " ", "are",
        " ", "all", " ", "fixed", " ", "at", " ", "2.7", " ", "Msol"}]}], 
     ")"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"i", ".", "e", ".", " ", "only"}], " ", "having", " ", "vary", " ",
     "mass", " ", "NS", " ", "mass", " ", "for", " ", "W18", " ", "engine"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "therefore", " ", "use", " ", "selectorStr", " ", "function", " ", "as", " ",
     "well"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"get", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"maxMnsData", "=", 
     RowBox[{"selectorStr", "[", 
      RowBox[{
       RowBox[{"selectorRecursive", "[", 
        RowBox[{"dataAll", ",", 
         RowBox[{"{", 
          
          RowBox[{"\"\<bin syn\>\"", ",", "\"\<fiducialCE1\>\"", ",", "1", 
           ",", "\"\<BHNS\>\"", ",", "\"\<NH\>\"", ",", "\"\<a2.0\>\""}], 
          "}"}], ",", "1"}], "]"}], ",", "\"\<W18\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Length", "[", "maxMnsData", "]"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"find", " ", "extrema"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"localExtremaMaxNSm", "=", 
     RowBox[{"extremaFinder", "[", "maxMnsData", "]"}]}], ";"}]}]}]], "Input",\

 CellChangeTimes->{{3.9819783843424387`*^9, 3.981978414992455*^9}, {
  3.9819787561481647`*^9, 3.981978756801153*^9}, {3.981978874544464*^9, 
  3.981978895273233*^9}, {4.004277818378471*^9, 4.0042778186222563`*^9}},
