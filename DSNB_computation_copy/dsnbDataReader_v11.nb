Cell[CellGroupData[{

Cell["binned data Converter", "Subsubsection",
 CellChangeTimes->{{3.981717211646908*^9, 3.981717217740501*^9}, {
  3.981719030060329*^9, 
  3.9817190313161182`*^9}},ExpressionUUID->"43ca7e5b-c53b-446f-9674-\
efb19033462c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"take", " ", "in", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"data", ",", "\"\<name\>\""}], "}"}], ",", "..."}], "}"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"convert", " ", "into", " ", "plot", " ", "ready", " ", "data"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"binnedDataConverter", "[", "x_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fullDataNames", "=", "x"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"allData", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"get", " ", "data", " ", "and", " ", "name"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"tempdata", "=", 
           RowBox[{"fullDataNames", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"tempName", "=", 
           RowBox[{"fullDataNames", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"start", " ", "loop", " ", "over", " ", "data"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "convert", " ", "data", " ", "to", " ", "error", " ", "bar", " ", 
            "points"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"tempNewData", "=", 
           RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{"tempdata", ",", "tempName"}], "]"}], ";"}], "*)"}], 
          "\[IndentingNewLine]", "\t", 
          RowBox[{"Do", "[", "\[IndentingNewLine]", "\t\t", 
           RowBox[{"(*", 
            RowBox[{"format", " ", "point", " ", "as", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"x", "+", 
                  RowBox[{
                   RowBox[{"/", 
                    RowBox[{"-", "max"}]}], "/", "min"}]}], ",", " ", "y"}], 
                "}"}], "..."}], "}"}]}], "*)"}], "\[IndentingNewLine]", 
           "\t\t", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"tempdata", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "]"}], ";"}], "*)"}], 
           "\[IndentingNewLine]", "\t\t", 
           RowBox[{"(*", 
            RowBox[{"get", " ", "mean", " ", "of", " ", "x", " ", "data"}], 
            "*)"}], "\[IndentingNewLine]", "\t\t", 
           RowBox[{
            RowBox[{
             RowBox[{"tempMean", "=", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"tempdata", "[", 
                   RowBox[{"[", "j", "]"}], "]"}], "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "2"}], "]"}], "]"}], "+", 
                 RowBox[{
                  RowBox[{"tempdata", "[", 
                   RowBox[{"[", "j", "]"}], "]"}], "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ")"}], "/", 
               "2"}]}], ";", "\[IndentingNewLine]", "\t\t", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"tempMean", "=", 
                RowBox[{"Median", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"tempdata", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", 
                   RowBox[{
                    RowBox[{"tempdata", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "}"}], "]"}]}], 
               ";"}], "*)"}], "\[IndentingNewLine]", "\t\t", 
             RowBox[{"tempMin", "=", 
              RowBox[{"tempMean", "-", 
               RowBox[{
                RowBox[{"tempdata", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", "\t\t", 
             RowBox[{"tempMax", "=", 
              RowBox[{
               RowBox[{
                RowBox[{"tempdata", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "2"}], "]"}], "]"}], "-", "tempMean"}]}], ";",
              "\[IndentingNewLine]", "\t\t", 
             RowBox[{"(*", 
              RowBox[{"create", " ", "point", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"x", "+", 
                  RowBox[{
                   RowBox[{"/", 
                    RowBox[{"-", "max"}]}], "/", "min"}]}], ",", " ", "y"}], 
                "}"}]}], "*)"}], "\[IndentingNewLine]", "\t\t", 
             RowBox[{"tempNewPoint", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Around", "[", 
                 RowBox[{"tempMean", ",", 
                  RowBox[{"{", 
                   RowBox[{"tempMin", ",", "tempMax"}], "}"}]}], "]"}], ",", 
                RowBox[{
                 RowBox[{"tempdata", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], ";", 
             "\[IndentingNewLine]", "\t\t", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"Print", "[", "tempNewPoint", "]"}], ";"}], "*)"}], 
             "\[IndentingNewLine]", "\t\t", 
             RowBox[{"(*", 
              RowBox[{"save", " ", "to", " ", "new", " ", "data"}], "*)"}], 
             "\[IndentingNewLine]", "\t\t", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"tempNewData", ",", "tempNewPoint"}], "]"}]}], ",", 
            "\[IndentingNewLine]", "\t", 
            RowBox[{"{", 
             RowBox[{"j", ",", "1", ",", 
              RowBox[{"Length", "[", "tempdata", "]"}]}], "}"}]}], 
           "\[IndentingNewLine]", "\t", "]"}], ";", 
          RowBox[{"(*", 
           RowBox[{"end", " ", "internal", " ", "loop"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "save", " ", "all", " ", "new", " ", "data", " ", "to", " ", 
            "list", " ", "of", " ", "data", " ", "sets", " ", "with", " ", 
            "its", " ", "corresponding", " ", "name"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"allData", ",", 
            RowBox[{"{", 
             RowBox[{"tempNewData", ",", "tempName"}], "}"}]}], "]"}], ";"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "fullDataNames", "]"}]}], "}"}]}], "]"}], ";", 
       RowBox[{"(*", 
        RowBox[{"end", " ", "do", " ", "loop"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"output", " ", "all", " ", "data"}], "*)"}], 
       "\[IndentingNewLine]", "allData"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], 
  RowBox[{"(*", 
   RowBox[{"end", " ", "module"}], "*)"}]}]], "Input",
