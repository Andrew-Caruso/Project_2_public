Cell["vary only single VS binary stars (i.e. data set)", "Text",
 CellChangeTimes->{{3.9819794479854*^9, 3.981979455759514*^9}, 
   3.985088259678144*^9},ExpressionUUID->"6b450a55-325d-4c1a-bc35-\
7469faee52de"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "fix", " ", "fiducial", " ", "model", " ", "except", " ", "vary", " ", 
    "only", " ", "single", " ", "VS", " ", "binary", " ", "stars", " ", 
    RowBox[{"i", ".", "e", ".", " ", "data"}], " ", "set"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"binaries", " ", "=", " ", 
    RowBox[{"binary", " ", "synthesis", " ", "data"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"single", " ", "stars"}], " ", "=", " ", 
    RowBox[{"progen", "+", 
     RowBox[{
     "engine", " ", "data", " ", "or", " ", "no", " ", "binary", " ", 
      "synthesis", " ", "data"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"singleVsbinarydata", "=", 
     RowBox[{"selectorRecursive", "[", 
      RowBox[{"dataAll", ",", 
       RowBox[{"{", 
        RowBox[{"\"\<fiducialCE1\>\"", ",", "\"\<W18-BH2.7-a2.0\>\"", ",", 
         "2.7", ",", "1", ",", "\"\<BHNS\>\"", ",", "\"\<NH\>\""}], "}"}], ",",
        "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Length", "[", "singleVsbinarydata", "]"}], "\[IndentingNewLine]", 
   
   RowBox[{"(*", 
    RowBox[{"find", " ", "extrema"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"localExtremaSingleVbinary", "=", 
     RowBox[{"extremaFinder", "[", "singleVsbinarydata", "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.981979461476305*^9, 3.9819795417432613`*^9}, {
