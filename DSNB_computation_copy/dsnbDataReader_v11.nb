    RowBox[{"al", ".", " ", "1999"}], " ", "eqn", " ", "7", " ", "referenced",
     " ", "from", " ", "Strumia", " ", "et", " ", 
    RowBox[{"al", ".", " ", "2003"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"for", " ", "comparison", " ", "from", " ", "Strumia", " ", "et", " ", 
