67c2e6b7ed47"],

Cell["\<\
(*NOTE: that these integrated DSNB values are NOT already in the data for \
EnuLowerBound-40 MeV*)\
\>", "Text",
 CellChangeTimes->{
  3.970666106671248*^9},ExpressionUUID->"b3e9df53-5e4a-43fc-9e87-\
4fae0ff3bc83"],

Cell["\<\
basically this is a generalized version of integrated DSNB flux errorBar \
plotter (i.e. does integration explicitly)
and does not take on the already integrated DSNB flux values in the data \
(already done in previous code for only 10-30 MeV Enu range)\
\>", "Text",
 CellChangeTimes->{{3.970666434797297*^9, 
  3.9706664881849337`*^9}},ExpressionUUID->"e40b0b2b-a8f7-4fb3-89aa-\
735ef3b4c3e6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "plot", " ", "n", " ", "cases", " ", "of", " ", "integrated", " ", "DSNB", 
    " ", "fluxes"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"DSNB", " ", "flux", " ", "in", " ", "units", " ", "of", " ", 
    RowBox[{"MeV", "^", 
     RowBox[{"-", "1"}]}], " ", 
    RowBox[{"cm", "^", 
     RowBox[{"-", "2"}]}], " ", 
    RowBox[{"s", "^", 
     RowBox[{"-", "1"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "integrated", " ", "DSNB", " ", "flux", " ", "in", " ", "units", " ", "of",
     " ", 
    RowBox[{"MeV", "^", 
     RowBox[{"-", "1"}]}], " ", 
    RowBox[{"cm", "^", 
     RowBox[{"-", "2"}]}], " ", 
    RowBox[{"s", "^", 
     RowBox[{"-", "1"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"given", " ", "first", " ", "input", " ", "fidExtrTlist", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fiducialData", ",", " ", 
        RowBox[{"extremaData", 
         RowBox[{"(", 
          RowBox[{"min", "/", "max"}], ")"}]}], ",", " ", "title"}], "}"}], ",",
       "..."}], "}"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "and", " ", "second", " ", "input", " ", "as", " ", "TempPlotTitle"}], 
    " ", "=", " ", 
    RowBox[{"plot", " ", "title"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"and", " ", "third", " ", "input", " ", "as", " ", "boundList"}], 
    " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
     "EnuLowerBound", ",", "EnuUpperBound", ",", "intDSNBfluxUpperBound"}], 
     "}"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"NOTE", ":", " ", 
    RowBox[{
     RowBox[{
     "that", " ", "these", " ", "integrated", " ", "DSNB", " ", "values", " ",
       "are", " ", "NOT", " ", "already", " ", "in", " ", "the", " ", "data", 
      " ", "for", " ", "EnuLowerBound"}], "-", 
     RowBox[{"40", " ", "MeV"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "thus", " ", "need", " ", "to", " ", "interpolate", " ", "and", " ", 
    "integrate", " ", "the", " ", "data", " ", "itself"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"intDSNBplotter3", "[", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"fidExtrTlist", "=", "x"}], ",", 
       RowBox[{"TempPlotTitle", "=", "y"}], ",", 
       RowBox[{"boundList", "=", "z"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"will", " ", "be", " ", "filled", " ", "as", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"point", ",", "caseNameXaxis", ",", "legendName"}], "}"}], ",",
          "..."}], "}"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"where", " ", "point"}], " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{"integer", ",", "aroundValue"}], "}"}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"where", " ", "aroundValue"}], " ", "=", " ", 
       RowBox[{
        RowBox[{"value", "^", 
         RowBox[{"{", 
          RowBox[{"+", 
           RowBox[{"^", "max"}]}], "}"}]}], "_", 
        RowBox[{"{", 
         RowBox[{"-", "min"}], "}"}]}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"pointsOut", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"make", " ", "plot", " ", "title", " ", 
        RowBox[{"(", 
         RowBox[{"include", " ", "energy", " ", "range"}], ")"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"plotTitle", "=", 
       RowBox[{"TempPlotTitle", "<>", "\"\< (\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"boundList", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "<>", "\"\<-\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"boundList", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], "<>", "\"\< MeV)\>\""}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"get", " ", "fiducial", " ", "data"}], ",", " ", 
         RowBox[{"extrema", " ", "data"}], ",", " ", 
         RowBox[{
          RowBox[{"and", " ", "case", " ", "x"}], "-", 
          RowBox[{"axis", " ", "title"}]}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"tempfidData3", "=", 
          RowBox[{"fidExtrTlist", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1", ",", "1"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"tempExtremaData3", "=", 
          RowBox[{"fidExtrTlist", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"tempTitle3", "=", 
          RowBox[{"fidExtrTlist", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "3"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "interpolate", " ", "then", " ", "integrated", " ", "DSNB", " ", 
           "flux"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "over", " ", "given", " ", "Enu", " ", "energy", " ", "range"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"intDSNBfid3", "=", 
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Interpolation", "[", 
              RowBox[{"tempfidData3", "[", 
               RowBox[{"[", "5", "]"}], "]"}], "]"}], "[", "w", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"w", ",", 
              RowBox[{"boundList", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"boundList", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"intDSNBmax3", "=", 
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Interpolation", "[", 
              RowBox[{
               RowBox[{"tempExtremaData3", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", "5"}], "]"}], "]"}], "]"}], "[", "w", "]"}],
             ",", 
            RowBox[{"{", 
             RowBox[{"w", ",", 
              RowBox[{"boundList", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"boundList", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"intDSNBmin3", "=", 
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Interpolation", "[", 
              RowBox[{
               RowBox[{"tempExtremaData3", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", "5"}], "]"}], "]"}], "]"}], "[", "w", "]"}],
             ",", 
            RowBox[{"{", 
             RowBox[{"w", ",", 
              RowBox[{"boundList", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"boundList", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
           "make", " ", "around", " ", "point", " ", "of", " ", "integrated", 
            " ", "DSNB", " ", "value"}], " ", "+", 
           RowBox[{
            RowBox[{"/", 
             RowBox[{"-", " ", "max"}]}], "/", "min"}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"tempPointBar3", "=", 
            RowBox[{"Around", "[", 
             RowBox[{"intDSNBfid3", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"intDSNBfid3", "-", "intDSNBmin3"}], ",", 
                RowBox[{"intDSNBmax3", "-", "intDSNBfid3"}]}], "}"}]}], 
             "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", "tempPointBar", "]"}], ";"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"make", " ", "legendName"}], "*)"}], "\[IndentingNewLine]", 
         
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"tempLegend", "=", 
            RowBox[{"ToString", "[", 
             RowBox[{"tempfidData", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"tempLegend", "=", 
            RowBox[{"ToString", "[", 
             RowBox[{"tempExtremaData", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "2", ",", "1"}], "]"}], "]"}], "]"}]}], 
           ";"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"tempLegend", "=", 
           RowBox[{"ToString", "[", 
            RowBox[{"tempExtremaData", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2", ",", "1"}], "]"}], "]"}], "]"}]}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"tempLegend3", "=", 
          RowBox[{
           RowBox[{"ToString", "[", 
            RowBox[{"tempExtremaData3", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2", ",", "1"}], "]"}], "]"}], "]"}], 
           "<>", "\"\<\\n\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"tempfidData3", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], 
           "<>", "\"\<\\n\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"tempExtremaData3", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "2", ",", "1"}], "]"}], "]"}], "]"}]}]}], ";",
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "append", " ", "to", " ", "full", " ", "list", " ", "of", " ", 
           "data", " ", "points"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"pointsOut", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"intDSNBmin3", ",", "intDSNBfid3", ",", "intDSNBmax3"}],
               "}"}], ",", "tempTitle3", ",", "tempLegend3"}], "}"}]}], "]"}],
          ";"}], "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "fidExtrTlist", "]"}]}], "}"}]}], 
       "\[IndentingNewLine]", "]"}], ";", 
      RowBox[{"(*", 
       RowBox[{"end", " ", "do", " ", "loop"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"throw", " ", "pointsOut", " ", "out"}], "*)"}], 
      "\[IndentingNewLine]", "pointsOut"}]}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "]"}], 
   RowBox[{"(*", 
    RowBox[{"end", " ", "module"}], "*)"}]}]}]], "Input",
