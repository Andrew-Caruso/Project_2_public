          RowBox[{"[", "2", "]"}], "]"}], "]"}], "<>", "\"\< MeV)\>\""}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"get", " ", "fiducial", " ", "data"}], ",", " ", 
         RowBox[{"extrema", " ", "data"}], ",", " ", 
         RowBox[{
          RowBox[{"and", " ", "case", " ", "x"}], "-", 
          RowBox[{"axis", " ", "title"}]}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"tempfidData2", "=", 
          RowBox[{"fidExtrTlist", "[", 
