            RowBox[{"{", 
             RowBox[{"0", ",", "7"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", "title"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], ";"}], 
