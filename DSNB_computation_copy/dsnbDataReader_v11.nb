Cell["AND update integrated DSNB from 10-30 MeV", "Text",
 CellChangeTimes->{{3.982151691530987*^9, 
  3.982151698703734*^9}},ExpressionUUID->"28def08a-0b1f-44e1-abe2-\
6218256c8dc5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "how", " ", "to", " ", "recale", " ", "DSNB", " ", "flux", " ", "max", " ",
     "or", " ", "min", " ", "respectively"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"f2", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"Rcc0upper", "/", "Rcc0"}]}], ")"}], "*", "f1"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"f2", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"Rcc0lower", "/", "Rcc0"}]}], ")"}], "*", "f1"}]}], 
   "*)"}]}]], "Input",
 CellChangeTimes->{{3.982141294068673*^9, 3.982141306030402*^9}, {
  3.982142137313663*^9, 3.98214216277783*^9}},
 CellLabel->
  "In[174]:=",ExpressionUUID->"28de7e54-5b9e-49c3-a1f3-ea7cc5ef6c81"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"with", " ", 
    RowBox[{"IH", "/", "NH"}], " ", "and", " ", "SFR", " ", "uncertainty"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"globalExtremaAllSFR", "=", 
