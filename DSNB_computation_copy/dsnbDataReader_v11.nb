  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"NOTE", ":", " ", 
    RowBox[{
    "bound", " ", "list", " ", "does", " ", "NOT", " ", "have", " ", "3", 
     "rd", " ", "element", " ", 
     RowBox[{"(", 
      RowBox[{"SK", " ", "bound"}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"intDSNBplotter0", "[", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], ":=", 
