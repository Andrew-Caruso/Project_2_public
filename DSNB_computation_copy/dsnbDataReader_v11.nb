Cell["\<\
split single string of allNS/BH+NS and noMSW/IH/NH into two separate strings \
\
\>", "Text",
 CellChangeTimes->{{3.968833470165921*^9, 
  3.968833563071198*^9}},ExpressionUUID->"74869a30-2200-4de8-a50e-\
6bfa56332483"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"replace", " ", "single", " ", "strings", " ", 
    RowBox[{"{", "\"\<BH+NS no MSW\>\"", "}"}], " ", "or", " ", 
    RowBox[{"{", "\"\<all NS no MSW\>\"", "}"}], " ", "with", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<BHNS\>\"", ",", " ", "\"\<no MSW\>\""}], "}"}], " ", "or", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<allNS\>\"", ",", " ", "\"\<no MSW\>\""}], "}"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "works", " ", "not", " ", "only", " ", "for", " ", "no", " ", "MSW", " ", 
    "but", " ", "also", " ", "IH", " ", "and", " ", "NH", " ", 
    RowBox[{"too", "!"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"sting", "[", "x_", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"StringJoin", "[", 
       RowBox[{
        RowBox[{"StringSplit", "[", 
         RowBox[{
          RowBox[{"StringReplace", "[", 
           RowBox[{"x", ",", 
            RowBox[{"\"\<+\>\"", "->", "\"\< \>\""}]}], "]"}], 
          ",", "\"\< \>\"", ",", "3"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "2"}], "]"}], "]"}], "]"}], ",", 
      RowBox[{"StringJoin", "[", 
       RowBox[{
        RowBox[{"StringSplit", "[", 
         RowBox[{
          RowBox[{"StringReplace", "[", 
           RowBox[{"x", ",", 
            RowBox[{"\"\<+\>\"", "->", "\"\< \>\""}]}], "]"}], 
          ",", "\"\< \>\"", ",", "3"}], "]"}], "[", 
        RowBox[{"[", "3", "]"}], "]"}], "]"}]}], "}"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.968833354626046*^9, 3.9688333565457582`*^9}, {
  3.968833513009602*^9, 3.968833527499357*^9}, {3.9688335690899277`*^9, 
