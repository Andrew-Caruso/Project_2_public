Cell[CellGroupData[{

Cell["extrema in fig 1 from Abe et al. 2025 (Sk collab)", "Subsubsection",
 CellChangeTimes->{{3.987953503912273*^9, 
  3.9879535187299013`*^9}},ExpressionUUID->"b2ae9b59-e7f8-4cdd-b950-\
26859e9d3c26"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "list", " ", "of", " ", "DSNB", " ", "flux", " ", "from", " ", "fig", " ", 
    "1", " ", "of", " ", "Abe", " ", "et", " ", 
    RowBox[{"al", ".", " ", "2025"}], " ", "theory", " ", "plot"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"from", " ", "SK", " ", "collab"}], "*)"}], "\[IndentingNewLine]", 
  
  RowBox[{"(*", 
   RowBox[{
   "barranco18", " ", "was", " ", "not", " ", "in", " ", "indep", " ", "var", 
    " ", "ascending", " ", "order"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"theoryDSNB", "=", 
     RowBox[{"{", 
      RowBox[{"ivanez23", ",", "nakazato24", ",", 
       RowBox[{"Sort", "[", "barranco18", "]"}], ",", "kaplinghat00"}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theoryDSNBnames", "=", 
