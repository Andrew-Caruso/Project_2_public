Cell["vary only 1P vs 2P criterion ", "Text",
 CellChangeTimes->{{3.98198104390425*^9, 
  3.981981057636725*^9}},ExpressionUUID->"5ebea187-7c7f-418e-b393-\
cec926aad6ba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "fix", " ", "fiducial", " ", "model", " ", "except", " ", "vary", " ", 
    "only", " ", "1", "P", " ", "vs", " ", "2", "P", " ", "criterion"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"criterionData", "=", 
     RowBox[{"selectorRecursive", "[", 
      RowBox[{"dataAll", ",", 
       RowBox[{"{", 
        RowBox[{"\"\<bin syn\>\"", ",", "\"\<fiducialCE1\>\"", 
         ",", "\"\<W18-BH2.7-a2.0\>\"", ",", "2.7", ",", "\"\<BHNS\>\"", 
         ",", "\"\<NH\>\""}], "}"}], ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Length", "[", "criterionData", "]"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"find", " ", "extrema"}], "*)"}], "\[IndentingNewLine]", 
