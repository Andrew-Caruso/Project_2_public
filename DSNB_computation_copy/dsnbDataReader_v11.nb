Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"enter", " ", "current", " ", "dir", " ", "lest"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SetDirectory", "[", "currentDir", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allRawDataBS", "=", 
