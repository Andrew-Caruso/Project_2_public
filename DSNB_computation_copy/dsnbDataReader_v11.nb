Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "data", " ", "full", " ", "run", " ", "directories", " ", "and", " ", 
    "scenario", " ", "directories", " ", "from", " ", "target", " ", 
    "directory"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"data", " ", "full", " ", "runs", " ", "for", " ", "all", " ", 
     RowBox[{"alphas", ":", " ", 
      RowBox[{"a1", ".0"}]}]}], ",", 
    RowBox[{"a1", ".5"}], ",", 
    RowBox[{"a2", ".0"}], ",", 
    RowBox[{"a2", ".5"}], ",", 
    RowBox[{"and", " ", "a3", ".0"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"scenario", " ", 
