          "over", " ", "given", " ", "Enu", " ", "energy", " ", "range"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"intDSNBfid", "=", 
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{
