Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "make", " ", "tables", " ", "of", " ", "integrated", " ", "values"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"for", " ", "9", " ", "to", " ", "40", " ", "MeV"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"localINDSNBdata940correct", "=", 
     RowBox[{"intDSNBplotter3", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "singleVbinaryIntDSNBList", ",", "binModIntDSNBList", ",", 
         "stellarDistIntDSNBList", ",", "engineModIntDSNBList", ",", 
         "criterion1P2PintDSNBList", ",", "maxNSmassIntDSNBList", ",", 
         "alphaIntDSNBList", ",", "noMSWIHNHIntDSNBList", ",", 
         "SFRuncertaintyIntDSNBList", ",", "globalIntDSNBList"}], "}"}], 
       ",", "\"\<Integrated DSNB flux\>\"", ",", 
       RowBox[{"{", 
        RowBox[{"9", ",", "40", ",", "intDSNBfluxBound"}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"for", " ", "16", " ", "to", " ", "40", " ", "MeV"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"localINDSNBdata1640correct", "=", 
     RowBox[{"intDSNBplotter3", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "singleVbinaryIntDSNBList", ",", "binModIntDSNBList", ",", 
         "stellarDistIntDSNBList", ",", "engineModIntDSNBList", ",", 
         "criterion1P2PintDSNBList", ",", "maxNSmassIntDSNBList", ",", 
         "alphaIntDSNBList", ",", "noMSWIHNHIntDSNBList", ",", 
         "SFRuncertaintyIntDSNBList", ",", "globalIntDSNBList"}], "}"}], 
       ",", "\"\<Integrated DSNB flux\>\"", ",", 
       RowBox[{"{", 
        RowBox[{"16", ",", "40", ",", "intDSNBfluxBound"}], "}"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
