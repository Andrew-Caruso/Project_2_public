Cell[CellGroupData[{

Cell["data binner ", "Subsubsection",
 CellChangeTimes->{{3.981714035269861*^9, 
  3.9817140425387993`*^9}},ExpressionUUID->"53000c03-69ad-4f92-9749-\
b3417b120f71"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"make", " ", "bins", " ", "for", " ", "data"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"take", " ", "in", " ", 
     RowBox[{"data", ":", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}], ",", "..."}], "}"}], " ", "of", " ",
        "Enu", " ", 
       RowBox[{"(", "MeV", ")"}]}]}]}], ",", " ", 
    RowBox[{"DSNB", " ", "flux", " ", "in", " ", 
     RowBox[{"cm", "^", 
      RowBox[{"-", "2"}]}], " ", 
     RowBox[{"MeV", "^", 
      RowBox[{"-", "1"}]}], " ", 
     RowBox[{"s", "^", 
      RowBox[{"-", "1"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"and", " ", "uneven", " ", "bin", " ", "intervals", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x1", ",", "x2"}], "}"}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x3", ",", "x4"}], "}"}], "..."}]}], "}"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"then", " ", "return", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x1", ",", "x2", ",", 
        RowBox[{"<", "y", ">"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x3", ",", "x4", ",", 
        RowBox[{"<", "y", ">"}]}], "}"}], ",", "..."}], "}"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dataBinner", "[", 
     RowBox[{"in1_", ",", "in2_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"data", "=", "in1"}], ",", 
        RowBox[{"binIntervals", "=", "in2"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"newData", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"tempEmin", "=", 
           RowBox[{"binIntervals", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"tempEmax", "=", 
           RowBox[{"binIntervals", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"tempData", "=", 
           RowBox[{"Select", "[", 
            RowBox[{"data", ",", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"tempEmin", "<=", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "<=", "tempEmax"}], ")"}], 
              "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"avgDSNBFlux", "=", 
           RowBox[{"Mean", "[", 
            RowBox[{"tempData", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"newData", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"tempEmin", ",", "tempEmax"}], "}"}], ",", 
              "avgDSNBFlux"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "binIntervals", "]"}]}], "}"}]}], 
        "\[IndentingNewLine]", "]"}], ";", 
       RowBox[{"(*", 
        RowBox[{"end", " ", "do", " ", "loop"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"output", " ", "the", " ", "new", " ", "data"}], "*)"}], 
       "\[IndentingNewLine]", "newData"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], 
  RowBox[{"(*", 
   RowBox[{"end", " ", "module"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.981714434373294*^9, 3.981714603623748*^9}, {
  3.981714656406876*^9, 3.9817147124066772`*^9}, {3.9817147820109797`*^9, 
