Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"take", " ", "in", " ", "list", " ", "of", " ", "dsnbDatas", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}], ",", "..."}], "}"}], " ", "and", " ", 
    "list", " ", "of", " ", "legendNames"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "create", " ", "DSNB", " ", "flux", " ", "plot", " ", "of", " ", "all", " ",
     "elements"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dsnbFluxesTemperaturePlotter4", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"data", "=", "x"}], ",", 
        RowBox[{"legends", "=", "y"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"fill", " ", "as", " ", 
        RowBox[{"{", 
         RowBox[{"caseName", ",", "DSNBflux"}], "}"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"dsnbFluxList", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "get", " ", "DSNB", " ", "flux", " ", "and", " ", "case", " ", 
          "name"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"tempDSNBFlux", "=", 
           RowBox[{"data", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"tempCaseName", "=", 
           RowBox[{"legends", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"get", " ", "temperature"}], ",", " ", 
            RowBox[{"numerator", " ", "coefficient"}], ",", " ", 
            RowBox[{"maxIndex", " ", "for", " ", "corresponding"}]}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"dirac", " ", "delta", " ", "distribution"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"FDpara", "=", 
           RowBox[{"tempFinderFull", "[", "tempDSNBFlux", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"foundTemp", "=", 
           RowBox[{"FDpara", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"foundNumNum", "=", 
           RowBox[{"FDpara", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "create", " ", "list", " ", "of", " ", "of", " ", "corresponding", 
            " ", "dirac", " ", "delta"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"FDlist", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"z", ",", 
               RowBox[{"fermiDirac", "[", 
                RowBox[{"z", ",", "foundTemp", ",", "foundNumNum"}], "]"}]}], 
              "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"z", ",", "5", ",", "50"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"append", " ", "to", " ", "ultimate", " ", "list"}], 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "legendName", ",", " ", "dsnbFlux", ",", "fermiDiracDist"}], 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"dsnbFluxList", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"ToString", "[", "FDpara", "]"}], "<>", 
               RowBox[{"ToString", "[", "tempCaseName", "]"}]}], ",", 
              "tempDSNBFlux", ",", "FDlist"}], "}"}]}], "]"}], ";"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "data", "]"}]}], "}"}]}], "]"}], ";", 
       RowBox[{"(*", 
        RowBox[{"end", " ", "do", " ", "loop"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"end", " ", "do", " ", "loop"}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"create", " ", "plot"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"dsnbFluxList", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{"dsnbFluxList", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "3"}], "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"Joined", "->", "True"}], ",", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"dsnbFluxList", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           
           RowBox[{"\"\<MeV\>\"", 
            ",", "\"\<\!\(\*SuperscriptBox[\(MeV\), \
\(-1\)]\)\!\(\*SuperscriptBox[\(cm\), \(-2\)]\)\!\(\*SuperscriptBox[\(s\), \
\(-1\)]\)\>\""}], "}"}]}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"5", ",", "50"}], "}"}], ",", "All"}], "}"}]}]}], 
        "]"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], 
   ";"}], 
  RowBox[{"(*", 
   RowBox[{"end", " ", "module"}], "*)"}]}]], "Input",
