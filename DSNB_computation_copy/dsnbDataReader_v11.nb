Cell[CellGroupData[{

Cell["Integrated DSNB plotter JR (full range)", "Subsubsection",
 CellChangeTimes->{{3.980948398780916*^9, 
  3.980948442560973*^9}},ExpressionUUID->"df354672-2ed1-43fe-90b1-\
572a9d69af6a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "plot", " ", "n", " ", "cases", " ", "of", " ", "integrated", " ", "DSNB", 
    " ", "fluxes"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"DSNB", " ", "flux", " ", "in", " ", "units", " ", "of", " ", 
    RowBox[{"MeV", "^", 
     RowBox[{"-", "1"}]}], " ", 
    RowBox[{"cm", "^", 
     RowBox[{"-", "2"}]}], " ", 
    RowBox[{"s", "^", 
     RowBox[{"-", "1"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "integrated", " ", "DSNB", " ", "flux", " ", "in", " ", "units", " ", "of",
     " ", 
    RowBox[{"MeV", "^", 
     RowBox[{"-", "1"}]}], " ", 
    RowBox[{"cm", "^", 
     RowBox[{"-", "2"}]}], " ", 
    RowBox[{"s", "^", 
     RowBox[{"-", "1"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"given", " ", "first", " ", "input", " ", "fidExtrTlist", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fiducialData", ",", " ", 
        RowBox[{"extremaData", 
         RowBox[{"(", 
          RowBox[{"min", "/", "max"}], ")"}]}], ",", " ", "title"}], "}"}], ",",
       "..."}], "}"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "and", " ", "second", " ", "input", " ", "as", " ", "TempPlotTitle"}], 
    " ", "=", " ", 
    RowBox[{"plot", " ", "title"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"and", " ", "third", " ", "input", " ", "as", " ", "boundList"}], 
    " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
     "EnuLowerBound", ",", "EnuUpperBound", ",", "intDSNBfluxUpperBound"}], 
     "}"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"NOTE", ":", " ", 
    RowBox[{
     RowBox[{
     "that", " ", "these", " ", "integrated", " ", "DSNB", " ", "values", " ",
       "are", " ", "NOT", " ", "already", " ", "in", " ", "the", " ", "data", 
      " ", "for", " ", "EnuLowerBound"}], "-", 
     RowBox[{"40", " ", "MeV"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "thus", " ", "need", " ", "to", " ", "interpolate", " ", "and", " ", 
    "integrate", " ", "the", " ", "data", " ", "itself"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"intDSNBplotterJR", "[", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"fidExtrTlist", "=", "x"}], ",", 
       RowBox[{"TempPlotTitle", "=", "y"}], ",", 
       RowBox[{"boundList", "=", "z"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"will", " ", "be", " ", "filled", " ", "as", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"point", ",", "caseNameXaxis", ",", "legendName"}], "}"}], ",",
          "..."}], "}"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"where", " ", "point"}], " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{"integer", ",", "aroundValue"}], "}"}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"where", " ", "aroundValue"}], " ", "=", " ", 
       RowBox[{
        RowBox[{"value", "^", 
         RowBox[{"{", 
          RowBox[{"+", 
           RowBox[{"^", "max"}]}], "}"}]}], "_", 
        RowBox[{"{", 
         RowBox[{"-", "min"}], "}"}]}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"barPointsT", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"make", " ", "plot", " ", "title", " ", 
        RowBox[{"(", 
         RowBox[{"include", " ", "energy", " ", "range"}], ")"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"plotTitle", "=", 
       RowBox[{"TempPlotTitle", "<>", "\"\< (\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"boundList", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "<>", "\"\<-\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"boundList", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], "<>", "\"\< MeV)\>\""}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"get", " ", "fiducial", " ", "data"}], ",", " ", 
         RowBox[{"extrema", " ", "data"}], ",", " ", 
         RowBox[{
          RowBox[{"and", " ", "case", " ", "x"}], "-", 
          RowBox[{"axis", " ", "title"}]}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"tempfidData2", "=", 
          RowBox[{"fidExtrTlist", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1", ",", "1"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"tempExtremaData2", "=", 
          RowBox[{"fidExtrTlist", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"tempTitle2", "=", 
          RowBox[{"fidExtrTlist", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "3"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "interpolate", " ", "then", " ", "integrated", " ", "DSNB", " ", 
           "flux"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "over", " ", "given", " ", "Enu", " ", "energy", " ", "range"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"intDSNBfid", "=", 
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Interpolation", "[", 
              RowBox[{"tempfidData2", "[", 
               RowBox[{"[", "5", "]"}], "]"}], "]"}], "[", "w", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"w", ",", 
              RowBox[{"boundList", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"boundList", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"intDSNBmax", "=", 
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Interpolation", "[", 
              RowBox[{
               RowBox[{"tempExtremaData2", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", "5"}], "]"}], "]"}], "]"}], "[", "w", "]"}],
             ",", 
            RowBox[{"{", 
             RowBox[{"w", ",", 
              RowBox[{"boundList", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"boundList", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"intDSNBmin", "=", 
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Interpolation", "[", 
              RowBox[{
               RowBox[{"tempExtremaData2", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", "5"}], "]"}], "]"}], "]"}], "[", "w", "]"}],
             ",", 
            RowBox[{"{", 
             RowBox[{"w", ",", 
              RowBox[{"boundList", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"boundList", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
           "make", " ", "around", " ", "point", " ", "of", " ", "integrated", 
            " ", "DSNB", " ", "value"}], " ", "+", 
           RowBox[{
            RowBox[{"/", 
             RowBox[{"-", " ", "max"}]}], "/", "min"}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"tempPointBar", "=", 
          RowBox[{"Around", "[", 
           RowBox[{"intDSNBfid", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"intDSNBfid", "-", "intDSNBmin"}], ",", 
              RowBox[{"intDSNBmax", "-", "intDSNBfid"}]}], "}"}]}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", "tempPointBar", "]"}], ";"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"make", " ", "legendName"}], "*)"}], "\[IndentingNewLine]", 
         
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"tempLegend", "=", 
            RowBox[{"ToString", "[", 
             RowBox[{"tempfidData", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"tempLegend", "=", 
            RowBox[{"ToString", "[", 
             RowBox[{"tempExtremaData", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "2", ",", "1"}], "]"}], "]"}], "]"}]}], 
           ";"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"tempLegend", "=", 
           RowBox[{"ToString", "[", 
            RowBox[{"tempExtremaData", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2", ",", "1"}], "]"}], "]"}], "]"}]}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"tempLegend2", "=", 
          RowBox[{
           RowBox[{"ToString", "[", 
            RowBox[{"tempExtremaData2", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2", ",", "1"}], "]"}], "]"}], "]"}], 
           "<>", "\"\<\\n\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"tempfidData2", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], 
           "<>", "\"\<\\n\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"tempExtremaData2", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "2", ",", "1"}], "]"}], "]"}], "]"}]}]}], ";",
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "append", " ", "to", " ", "full", " ", "list", " ", "of", " ", 
           "data", " ", "points"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"barPointsT", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"{", 
               RowBox[{"i", ",", "tempPointBar"}], "}"}], "}"}], ",", 
             "tempTitle2", ",", "tempLegend2"}], "}"}]}], "]"}], ";"}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "fidExtrTlist", "]"}]}], "}"}]}], 
       "\[IndentingNewLine]", "]"}], ";", 
      RowBox[{"(*", 
       RowBox[{"end", " ", "do", " ", "loop"}], "*)"}], "\[IndentingNewLine]",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "make", " ", "list", " ", "of", " ", "all", " ", "titles", " ", "for", 
        " ", "x", " ", "axis"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"titleList", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"barPointsT", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "barPointsT", "]"}]}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"barPointsT", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "3"}], "]"}], "]"}], ";"}], "*)"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"make", " ", "plot"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"ListPlot", "[", 
       RowBox[{
        RowBox[{"barPointsT", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"PlotRange", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{
                RowBox[{"Length", "[", "fidExtrTlist", "]"}], "*", "1.25"}]}],
               "}"}], ",", "All"}], "}"}]}], ","}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"PlotRange", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{
                RowBox[{"Length", "[", "fidExtrTlist", "]"}], "*", "1.25"}]}],
               "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "5"}], "}"}]}], "}"}]}], ","}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"PlotRange", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{
                RowBox[{"Length", "[", "fidExtrTlist", "]"}], "*", "1.25"}]}],
               "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "6.5"}], "}"}]}], "}"}]}], ","}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
        RowBox[{"PlotLabel", "->", "plotTitle"}], ",", "\[IndentingNewLine]", 
        
        RowBox[{"Axes", "->", "False"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Frame", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"True", ",", "False"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"True", ",", "False"}], "}"}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             
             RowBox[{"\"\<\!\(\*SuperscriptBox[\(cm\), \
\(-2\)]\)\!\(\*SuperscriptBox[\(s\), \(-1\)]\) (>\>\"", "<>", 
              RowBox[{"ToString", "[", 
               RowBox[{"boundList", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}], 
              "<>", "\"\< MeV)\>\""}], ",", "None"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<\>\"", ",", "None"}], "}"}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"FrameStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"16", ",", "Black"}], "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"FrameTicks", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Automatic", ",", "Automatic"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"titleList", ",", "Automatic"}], "}"}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"barPointsT", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "3"}], "]"}], "]"}], ",", 
           RowBox[{"LineLegend", "[", 
            RowBox[{
             RowBox[{"{", "Red", "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"\"\<SK-Gd bound: \>\"", "<>", 
               RowBox[{"ToString", "[", 
                RowBox[{"boundList", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], "]"}], 
               "<>", "\"\< \!\(\*SuperscriptBox[\(cm\), \
\(-2\)]\)\!\(\*SuperscriptBox[\(s\), \(-1\)]\)\>\""}], "}"}]}], "]"}]}], 
          "}"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"GridLines", "->", 
         RowBox[{"{", 
          RowBox[{"None", ",", 
           RowBox[{"{", 
            RowBox[{"boundList", "[", 
             RowBox[{"[", "3", "]"}], "]"}], "}"}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"GridLinesStyle", "->", 
         RowBox[{"{", 
          RowBox[{"Thick", ",", "Red"}], "}"}]}], ",", "\[IndentingNewLine]", 
        
        RowBox[{"ImageSize", "->", "Full"}]}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"PlotMarkers", "->", "Automatic"}], "*)"}], 
       "\[IndentingNewLine]", "]"}]}]}], 
    RowBox[{"(*", 
     RowBox[{"end", " ", "listplot"}], "*)"}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], 
   RowBox[{"(*", 
    RowBox[{"end", " ", "module"}], "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.980948380878277*^9, 3.980948384408346*^9}, {
  3.980948425755004*^9, 3.9809484312539673`*^9}, {3.982314777357417*^9, 
  3.9823147802975388`*^9}},
 CellLabel->
  "In[112]:=",ExpressionUUID->"c00f75e9-91a0-4348-aae5-2cf2d8aca1dd"]
