Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "form", " ", "list", " ", "of", " ", "binned", " ", "data", " ", "and", " ",
     "corresponding", " ", "name"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "for", " ", "other", " ", "theoretical", " ", "predictions", " ", "from", " ",
     "optimistic", " ", "Kaplinghat", " ", "et", " ", 
    RowBox[{"al", ".", "2000"}], " ", "and", " ", "pessimistic", " ", 
    "Nakazato", " ", "et", " ", 
    RowBox[{"al", ".", "2015"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"versus", " ", "out", " ", "fiducial", " ", "case"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"binnedTheoryDataList", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"binnedfidInterpData", ",", "\"\<fiducial case\>\""}], "}"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"binnedOtherPredictLow", ",", "\"\<theory low\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"binnedOtherPredictHigh", ",", "\"\<theory high\>\""}], 
        "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"for", " ", "observations"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"binnedObservDataList", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"binobsSKVIVIIBDT", ",", "\"\<observed SK VI+VII BDT\>\""}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"binobsSKVIVIINN", ",", "\"\<observed SK VI+VII NN\>\""}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"binobsSKVIBDT", ",", "\"\<observed SK IV BDT\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"binobsSKIVBDT", ",", "\"\<observed SK IV BDT (2021)\>\""}], 
        "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "combine", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"binDataSetall", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"binnedTheoryDataList", ",", "binnedObservDataList"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"binnedPlotData", "=", 
     RowBox[{"binnedDataConverter", "[", "binDataSetall", "]"}]}], 
    ";"}]}]}]], "Input",
