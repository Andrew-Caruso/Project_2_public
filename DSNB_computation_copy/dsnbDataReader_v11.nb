   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"without", " ", "SFR"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"yValsMaxPlus", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"yValsMax", ",", 
       RowBox[{"{", 
        RowBox[{"yValsMax", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yValsMinPlus", "=", 
