Cell[CellGroupData[{

Cell["DSNB data selector recursive", "Subsubsection",
 CellChangeTimes->{{3.968784910860526*^9, 
  3.9687849444437037`*^9}},ExpressionUUID->"008d7cd6-0760-4439-9877-\
e6fa44c0dbbb"],

Cell["\<\
take in reformated DSNB data and extract only cases containing a list of \
items/phrases\
\>", "Text",
 CellChangeTimes->{{3.9687563615780983`*^9, 3.96875638424023*^9}, {
  3.968756443178628*^9, 3.968756444099043*^9}, {3.9687603302920513`*^9, 
  3.968760330810861*^9}, {3.968764878482888*^9, 3.968764895185713*^9}, {
  3.968767148127486*^9, 3.968767160374715*^9}, {3.968784991807856*^9, 
  3.968784998677403*^9}},ExpressionUUID->"6af81b6c-2f29-458f-a34e-\
cf82a61f48b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"selectorRecursive", "[", 
     RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"data", "=", "x"}], ",", 
        RowBox[{"itemList", "=", "y"}], ",", 
        RowBox[{"n", "=", "z"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "recall", " ", "format", " ", "of", " ", "input", " ", "data", " ", 
        "is", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "case", ",", "intFlux", ",", "outliers", ",", "DSNBflux", ","}], 
           "}"}], ",", "..."}], "}"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "select", " ", "from", " ", "a", " ", "list", " ", "of", " ", 
        "sublists"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "all", " ", "sublists", " ", "that", " ", "match", " ", "each", " ", 
        "phrase", " ", "in", " ", "the", " ", "nth", " ", "index", " ", "of", 
        " ", "the", " ", "list"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"i", ".", "e", ".", " ", "select"}], " ", "all", " ", "cases",
         " ", "that", " ", "contain", " ", "the", " ", "list", " ", "of", " ", 
        RowBox[{"phrases", "/", "items"}], " ", "in", " ", "the", " ", 
        "case"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"recurviseNext", "=", "data"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"recurviseNext", "=", 
           RowBox[{"Select", "[", 
            RowBox[{"recurviseNext", ",", 
             RowBox[{
              RowBox[{"MemberQ", "[", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "n", "]"}], "]"}], ",", "phrase"}], "]"}], 
              "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"phrase", ",", "itemList"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", "output", "*)"}], "\[IndentingNewLine]", 
       "recurviseNext"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
     "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"end", " ", "module"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.9687563938683567`*^9, 3.968756464000738*^9}, {
  3.968756519377054*^9, 3.968756568380454*^9}, {3.968759214529434*^9, 
  3.968759222056796*^9}, {3.968759355583552*^9, 3.96875938245059*^9}, {
  3.968759802613514*^9, 3.968759828997457*^9}, {3.96875990759147*^9, 
  3.9687601064594717`*^9}, {3.96876018382591*^9, 3.96876018870951*^9}, {
  3.968766701848175*^9, 3.968766703515009*^9}, {3.9687667800164757`*^9, 
  3.968766827742167*^9}, {3.968767089354261*^9, 3.968767119389513*^9}, {
  3.968785002506336*^9, 3.96878521232962*^9}, {3.968785259114182*^9, 
  3.968785265479372*^9}, {3.96878529741229*^9, 3.9687853126348543`*^9}, {
  3.968785350241881*^9, 3.96878535043826*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"201c97a8-e332-4a58-b82e-4114b9f1105a"]
}, Closed]],

Cell[CellGroupData[{

Cell["Extrema Finder", "Subsubsection",
 CellChangeTimes->{{3.9685262608526363`*^9, 
  3.968526275619779*^9}},ExpressionUUID->"60c233f3-a750-4675-8bf1-\
3aa73f7c741f"],

Cell["find case that has min and max integrated DSNB ", "Text",
 CellChangeTimes->{{3.968526270504332*^9, 
  3.968526303192828*^9}},ExpressionUUID->"3dd95140-9e30-45a3-9596-\
1fb9c275b7c0"],

Cell["for given input data from loop ", "Text",
 CellChangeTimes->{{3.968526305565029*^9, 
  3.968526314517888*^9}},ExpressionUUID->"a0f86117-7138-4f34-88a9-\
808003dfd8a7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "take", " ", "in", " ", "DSNB", " ", "flux", " ", "data", " ", "from", " ",
     "loop"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"extremaFinder", "[", "x_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"data", "=", "x"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"recall", " ", "format", " ", 
        RowBox[{"(", 
         RowBox[{
         "after", " ", "raw", " ", "data", " ", "is", " ", "reformated", " ", 
          "via", " ", "dataReformator", " ", "module"}], ")"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"format", " ", "as", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"case", ",", "intFlux"}], "}"}], ",", "..."}], "}"}]}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "look", " ", "at", " ", "solely", " ", "original", " ", "integrated", " ",
         "DSNB", " ", "flux", " ", "values"}], "*)"}], "\[IndentingNewLine]", 
      
      RowBox[{
       RowBox[{"tempIntFluxList", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"data", "[", 
           RowBox[{"[", "All", "]"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "find", " ", "max", " ", "and", " ", "min", " ", "integrated", " ", 
         "DSNB", " ", "flux"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"maxIntFluxVal", "=", 
        RowBox[{"Max", "[", "tempIntFluxList", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"minIntFluxVal", "=", 
        RowBox[{"Min", "[", "tempIntFluxList", "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"find", " ", "corresponding", " ", "indices"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"maxIndex", "=", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{"tempIntFluxList", ",", "maxIntFluxVal"}], "]"}], ",", 
           "1"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"minIndex", "=", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{"tempIntFluxList", ",", "minIntFluxVal"}], "]"}], ",", 
           "1"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"find", " ", "case"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"maxCase", "=", 
        RowBox[{"data", "[", 
         RowBox[{"[", "maxIndex", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"minCase", "=", 
        RowBox[{"data", "[", 
         RowBox[{"[", "minIndex", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", "output", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<max case\>\"", ",", "maxCase", ",", 
           RowBox[{"{", 
            RowBox[{"\"\<max index\>\"", ",", "maxIndex"}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\"\<min case\>\"", ",", "minCase", ",", 
           RowBox[{"{", 
            RowBox[{"\"\<min index\>\"", ",", "minIndex"}], "}"}]}], "}"}]}], 
        "}"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"end", " ", "module"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.968526320619915*^9, 3.968526376797353*^9}, {
  3.968526438656775*^9, 3.968526468481058*^9}, {3.9685279816722803`*^9, 
  3.9685280485191193`*^9}, {3.96852810491129*^9, 3.968528134856357*^9}, {
  3.968528245323635*^9, 3.968528304690309*^9}, {3.9685283457791443`*^9, 
  3.968528525921054*^9}, {3.9685286175501833`*^9, 3.968528708735776*^9}, {
  3.968528857274219*^9, 3.9685289199803343`*^9}, {3.968528959626886*^9, 
  3.968529034842029*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"5019b937-3b44-4101-a154-f37279ba4d75"]
}, Closed]],

Cell[CellGroupData[{

Cell["SFR uncertainty incorporator", "Subsubsection",
 CellChangeTimes->{{3.982142332086156*^9, 
  3.982142337469516*^9}},ExpressionUUID->"0140820a-22c6-4be4-bffd-\
9808155c2b58"],

Cell["\<\
implement upper and lower SFR uncertainty via CCSN renormalization\
\>", "Text",
 CellChangeTimes->{{3.982143771937183*^9, 3.982143773713626*^9}, {
  3.982143921039111*^9, 
  3.9821439396990433`*^9}},ExpressionUUID->"8e05c806-62ba-4ce3-88d2-\
fd0b361b497e"],

Cell["\<\
into extrema data (max and min respectively) i.e. data after using extrema \
finder 
also update integrated DSNB flux (from 10-30 MeV) accordingly\
\>", "Text",
 CellChangeTimes->{{3.982143942433282*^9, 3.9821439652271767`*^9}, {
  3.9821519934982557`*^9, 
  3.9821520088255672`*^9}},ExpressionUUID->"12d16d30-f46f-46c4-8cb3-\
254e0166b74d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SFRuncertaintyIncorporator", "[", "x_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"extremaData", "=", "x"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"rescale", " ", "DSNB", " ", "flux", " ", "data"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "implement", " ", "upper", " ", "and", " ", "lower", " ", "SFR", " ", 
        "uncertainty", " ", "via", " ", "CCSN", " ", "renormalization"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"into", " ", "extrema", " ", "data", " ", 
        RowBox[{"(", 
         RowBox[{"max", " ", "and", " ", "min", " ", "respectively"}], ")"}], 
        " ", 
        RowBox[{"i", ".", "e", ".", "data"}], " ", "after", " ", "using", " ",
         "extrema", " ", "finder"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "rescale", " ", "max", " ", "and", " ", "min", " ", "cases", " ", 
        "respectively"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tempMaxDSNBflux", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "*", 
              RowBox[{"(", 
               RowBox[{"1", "+", 
                RowBox[{"Rcc0upper", "/", "Rcc0"}]}], ")"}]}]}], "}"}], "&"}],
           ",", 
          RowBox[{"extremaData", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2", ",", "5"}], "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tempMinDSNBflux", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "*", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{"Rcc0lower", "/", "Rcc0"}]}], ")"}]}]}], "}"}], "&"}],
           ",", 
          RowBox[{"extremaData", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "2", ",", "5"}], "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"replace", " ", "max", " ", 
         RowBox[{"(", "min", ")"}], " ", "DSNB", " ", "flux", " ", "data", " ",
          "with", " ", "new", " ", "one"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"tempMaxDataJR", "=", 
        RowBox[{"ReplacePart", "[", 
         RowBox[{
          RowBox[{"extremaData", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", "5"}], "}"}], "->", "tempMaxDSNBflux"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"tempMinDataJR", "=", 
        RowBox[{"ReplacePart", "[", 
         RowBox[{
          RowBox[{"extremaData", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", "5"}], "}"}], "->", "tempMinDSNBflux"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"update", " ", "integrated", " ", "DSNB", " ", "flux"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "get", " ", "new", " ", "integrated", " ", "DSNB", " ", "flux", " ", 
         "value"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"tempMaxIntDSNB", "=", 
        RowBox[{"dsnbFluxIntegrator", "[", 
         RowBox[{"tempMaxDSNBflux", ",", 
          RowBox[{"{", 
           RowBox[{"10", ",", "30"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tempMinIntDSNB", "=", 
        RowBox[{"dsnbFluxIntegrator", "[", 
         RowBox[{"tempMinDSNBflux", ",", 
          RowBox[{"{", 
           RowBox[{"10", ",", "30"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"replace", " ", "max", " ", 
         RowBox[{"(", "min", ")"}], " ", "integrated", " ", "DSNB", " ", 
         "flux", " ", "with", " ", "new", " ", "one"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"tempMaxData", "=", 
        RowBox[{"ReplacePart", "[", 
         RowBox[{"tempMaxDataJR", ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", "2", ",", "2"}], "}"}], "->", 
           "tempMaxIntDSNB"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"tempMinData", "=", 
        RowBox[{"ReplacePart", "[", 
         RowBox[{"tempMinDataJR", ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", "2", ",", "2"}], "}"}], "->", 
           "tempMinIntDSNB"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "recombine", " ", "into", " ", "new", " ", "extrema", " ", "data"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "in", " ", "order", " ", "of", " ", "max", " ", "and", " ", "min", " ",
          "respecitvely"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"newExtremaData", "=", 
        RowBox[{"{", 
         RowBox[{"tempMaxData", ",", "tempMinData"}], "}"}]}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"end", " ", "module"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.982143745615066*^9, 3.982143766038291*^9}, {
  3.9821439705993423`*^9, 3.982144069979404*^9}, {3.982144253969722*^9, 
  3.982144413001772*^9}, {3.9821444460336123`*^9, 3.98214445225308*^9}, {
  3.982144496350588*^9, 3.982144496666264*^9}, {3.98214481469022*^9, 
  3.9821448224961843`*^9}, {3.982145131217125*^9, 3.982145137014619*^9}, {
  3.98214522023234*^9, 3.982145223323125*^9}, {3.982145324984147*^9, 
  3.982145329439734*^9}, {3.9821462605908813`*^9, 3.982146262562187*^9}, {
  3.982151742782592*^9, 3.982151929211129*^9}, {3.9821520157698383`*^9, 
  3.982152030882472*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"f06f8b99-6ca8-4c56-b88d-013df3158991"]
}, Closed]]
}, Closed]],

