   RowBox[{"(*", 
    RowBox[{
     RowBox[{"for", " ", "alpha"}], "=", "3.5"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"F5", "[", "x_", "]"}], ":=", 
     RowBox[{"nuSpec", "[", 
      RowBox[{"x", ",", 
