Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"extractNSBHpops", "[", "x_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"chosenMbaryLim", "=", "x"}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "Get", " ", "NS", " ", "and", " ", "BH", " ", "pops", " ", "from", " ",
          "progen"}], "+", 
        RowBox[{"engine", " ", "data"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"For", " ", "NS", " ", "pops"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"NScomboData", " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"comboData", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "15", "]"}], "]"}], "==", "\"\<NS\>\""}], "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"NScomboData", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "15"}], "]"}], "]"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"For", " ", "BH", " ", "pops"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "select", " ", "out", " ", "BH", " ", "data", " ", "assuming", " ", 
         "the", " ", "chosen", " ", "NS", " ", "baryonic", " ", "mass", " ", 
         "limit", " ", "prior", " ", "to", " ", "BH", " ", "formation"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "baryonic", " ", "NS", " ", "mass", " ", "limit", " ", "at", " ", 
          "time", " ", "of", " ", "BH", " ", "formation", " ", "is", " ", 
          "at", " ", "column", " ", "17", " ", "of", " ", "progen"}], "+", 
         RowBox[{"explode", " ", "data"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"BHcomboData", " ", "=", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{"comboData", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "15", "]"}], "]"}], "==", "\"\<BH\>\""}], "&"}]}],
            "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "17", "]"}], "]"}], "==", "chosenMbaryLim"}], 
           "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"peMissingBHPop", "=", 
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"Select", "[", 
           RowBox[{"comboData", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "15", "]"}], "]"}], "==", "\"\<BH\>\""}], "&"}]}],
            "]"}], "]"}], "-", 
         RowBox[{"Length", "[", "BHcomboData", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"BHcomboData", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "15"}], "]"}], "]"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"BHcomboData", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "17"}], "]"}], "]"}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "get", " ", "Mzams", " ", "range", " ", "for", " ", "NS", " ", "and",
           " ", "BH", " ", "of", " ", "progen"}], "+", 
         RowBox[{"engine", " ", "combo", " ", "data"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Progen", "+", 
         RowBox[{"engine", " ", "NS", " ", "Mzams", " ", 
          RowBox[{"range", ":"}]}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"peMaxMzamsNS", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"NScomboData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"peMinMzamsNS", "=", 
        RowBox[{"Min", "[", 
         RowBox[{"NScomboData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Progen", "+", 
         RowBox[{"engine", " ", "BH", " ", "Mzams", " ", 
          RowBox[{"range", ":"}]}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"peMaxMzamsBH", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"BHcomboData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"peMinMzamsBH", "=", 
        RowBox[{"Min", "[", 
         RowBox[{"BHcomboData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";"}]}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"end", " ", "of", " ", "module"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.963939283525713*^9, 3.963939404336768*^9}, {
  3.964012451784186*^9, 3.9640124937319393`*^9}, {3.964012551791936*^9, 
  3.964012578924686*^9}, {3.964013806658619*^9, 3.964013818109799*^9}, {
