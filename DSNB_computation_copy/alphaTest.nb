Cell[CellGroupData[{

Cell["Test 1 description", "Subsubsection",
 CellChangeTimes->{{3.979894973935211*^9, 
  3.979894988056821*^9}},ExpressionUUID->"f32493c5-3683-4c44-9779-\
6287d42c1d6a"],

Cell[TextData[{
 "Kresse et al. 2021 set instantaneous neutrino spectral-shape parameter ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"\[Alpha]", " "}], 
    SubscriptBox[
     OverscriptBox["\[Nu]", "_"], "e"]], TraditionalForm]],ExpressionUUID->
  "c2a66bdf-ed4a-4c79-adce-bfabdabb98b1"],
 "  to be",
 Cell[BoxData[
  RowBox[{" ", 
   RowBox[{
    RowBox[{"3.5", " ", "for", " ", 
     SubscriptBox["M", "NSbary"]}], " ", "<=", " ", 
    RowBox[{"1.6", " ", "and", " ", "3", " ", "for", " ", 
     SubscriptBox["M", "NSbary"]}], " ", ">", " ", "1.6", "  "}]}]],
  CellChangeTimes->{{3.94645834370008*^9, 3.9464583616053123`*^9}, {
   3.946458411015049*^9, 3.946458487008602*^9}, {3.946458713881481*^9, 
   3.946458722604329*^9}, {3.946458781568462*^9, 3.946458822145293*^9}, {
   3.946461754406208*^9, 3.946461762914117*^9}, {3.946461837429826*^9, 
   3.946461842870319*^9}, {3.946462695824869*^9, 3.94646272351099*^9}, {
   3.9464627606359653`*^9, 3.9464631101974773`*^9}, {3.946469353708701*^9, 
   3.946469499171517*^9}, {3.946469623953813*^9, 3.946469725059696*^9}, {
   3.9464700000669928`*^9, 3.9464700015079193`*^9}, {3.946557100198152*^9, 
   3.9465571192735767`*^9}, {3.946557267555882*^9, 3.946557267740985*^9}, {
   3.946557812738831*^9, 3.9465578377557907`*^9}, {3.946557953956504*^9, 
   3.946557962349533*^9}},ExpressionUUID->
  "75c593b2-d92f-45ba-bb94-acc0924b288a"],
 "to be constant for NS and 2 for BH pops\nHowever, the engine model data for \
different engine models includes spectral-shape parameter \[Alpha] of the \
TIME INTRAGTED ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["\[Nu]", "_"], "e"], TraditionalForm]],ExpressionUUID->
  "023f303a-9bf9-4bf6-bebb-adb0aa740a97"],
 " spectrum which are obviously not 3.5, 3, nor 2, but vary by a lot. \n\
Shunsaku thinks that if one takes neutrino energy spectra for any \[Alpha] \
and combine the spectra, it should yield \[Alpha] < or > 3.5. \nTo test this \
idea reasonable spectral parameters are chosen to mimic neutrino spectra and \
this idea is tested. "
}], "Text",
 CellChangeTimes->{{3.946577291623953*^9, 3.946577303860733*^9}, {
  3.946577335944825*^9, 3.946577417347416*^9}, {3.9465774955093822`*^9, 
  3.946577499764914*^9}, {3.946577617556765*^9, 3.946577725529533*^9}, {
  3.9465777556229563`*^9, 3.946577774578484*^9}, {3.946577808798704*^9, 
  3.946578040671258*^9}, {3.946578072739675*^9, 3.946578155067259*^9}, {
  3.9798951223072557`*^9, 
  3.979895123816839*^9}},ExpressionUUID->"5a15763d-b972-4fd4-b6c1-\
aa525f40b3d7"],

