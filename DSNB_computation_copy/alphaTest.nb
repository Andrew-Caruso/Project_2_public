        "erg"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"snap5", "=", 
     RowBox[{"{", 
      RowBox[{"3.5", ",", "14", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"A1", "+", "A2", "+", "A3", "+", "A4", "+", "A5"}], ")"}], "*",
         "erg"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"snap6", "=", 
