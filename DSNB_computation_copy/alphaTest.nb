Cell[BoxData[
 FractionBox["b", 
  RowBox[{"1", "+", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", 
     FractionBox["x", "a"]}]]}]]], "Output",
 CellChangeTimes->{3.986465159080385*^9, 3.986465189454898*^9, 
