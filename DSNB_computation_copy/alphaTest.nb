Cell["fit DSNB flux to generic fermi dirac distribution ", "Text",
 CellChangeTimes->{{3.9858903470662394`*^9, 3.985890368593453*^9}, {
  3.985890578720065*^9, 
  3.9858905795351763`*^9}},ExpressionUUID->"3a5c77c3-54b5-49b0-aaac-\
09cf8f9c3be4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"generic", " ", "fermi", " ", "dirac", " ", "distribution"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "take", " ", "in", " ", "neutrino", " ", "energy", " ", "and", " ", 
    "temperature", " ", "in", " ", "MeV"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"fermiDirac1", "[", 
    RowBox[{"E_", ",", "T_", ",", "A_"}], "]"}], ":=", 
   FractionBox["A", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"E", "/", "T"}], "]"}], "+", "1"}], ")"}]]}]}]], "Input",
 CellChangeTimes->{{3.985890555909706*^9, 3.9858905881671867`*^9}, {
   3.985890668781212*^9, 3.9858907741178102`*^9}, {3.985890809301303*^9, 
