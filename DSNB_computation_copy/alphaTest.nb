Cell[CellGroupData[{

Cell["finding temperature (avg nu spec)", "Section",
 CellChangeTimes->{{3.985203946129525*^9, 3.985203950067605*^9}, {
  3.9858902238414288`*^9, 
  3.9858902418738937`*^9}},ExpressionUUID->"4eab6893-a7c9-4ae1-ac57-\
b60d8a71f40f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "find", " ", "temperature", " ", "closest", " ", "to", " ", "fiducial", " ",
      "case", "\[IndentingNewLine]", "via", " ", "equation", " ", "8", " ", 
     "from", " ", "Horiuchi", " ", "et", " ", 
     RowBox[{"al", ".", "2009"}], " ", 
     RowBox[{"https", ":"}]}], "//", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"arxiv", ".", "org"}], "/", "abs"}], "/", "0812.3157"}], "\[IndentingNewLine]",
      "and", " ", "compare", " ", "to", " ", "fig", " ", "4", " ", 
     "therein"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "and", " ", "based", " ", "on", " ", "avg", " ", "neutrino", " ", 
    "spectrum", " ", "for", " ", "fiducial", " ", "case"}], "*)"}]}]], "Input",\

 CellChangeTimes->{{3.985262008406898*^9, 3.9852620304069242`*^9}},
 CellLabel->"In[73]:=",ExpressionUUID->"db95b4e9-4dab-49ee-8637-6f9291ca474f"],

Cell[CellGroupData[{

Cell["compare neutrino spectra functions per se", "Subsection",
 CellChangeTimes->{{3.985020274983794*^9, 3.9850202775157337`*^9}, {
  3.985255872380355*^9, 3.985255878793982*^9}, {3.985262254090419*^9, 
  3.985262255832694*^9}},ExpressionUUID->"a11f3eb2-f975-4134-ad56-\
5902758c35e1"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
   "find", " ", "temperature", " ", "closest", " ", "to", " ", "fiducial", " ",
     "case", "\n", "\[IndentingNewLine]", "via", " ", "equation", " ", "8", " ",
     "from", " ", "Horiuchi", " ", "et", " ", 
    RowBox[{"al", ".", "2009"}], " ", 
    RowBox[{"https", ":"}]}], "//", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"arxiv", ".", "org"}], "/", "abs"}], "/", "0812.3157"}], "\n", "\[IndentingNewLine]",
     "and", " ", "compare", " ", "to", " ", "fig", " ", "4", " ", 
    "therein"}]}], "*)"}]], "Input",
 CellChangeTimes->{{3.98502057647919*^9, 3.985020580066515*^9}},
 CellLabel->"In[74]:=",ExpressionUUID->"1239c2ae-afa3-4e44-893a-fb95e25e21c8"],

Cell["make functions of nu energy spectrum", "Text",
 CellChangeTimes->{{3.985020590332265*^9, 
  3.9850205985929823`*^9}},ExpressionUUID->"535aba36-58c4-4478-9d5d-\
1f4dbc1ffef5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"from", " ", "Horiuchi", " ", "et", " ", 
    RowBox[{"al", ".", " ", "2021"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "used", " ", "in", " ", "2", "para_DSNB", "_v19", " ", "when", " ", 
    "computing", " ", "DSNB", " ", "flux"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "nuetrino", " ", "spectrum", " ", "threefold", " ", "parameterization"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "UNLIKE", " ", "PREVIOUS", " ", "FUNCTION", " ", "Etot", " ", "is", " ", 
    "NOT", " ", "in", " ", "units", " ", "of", " ", 
    RowBox[{"Etot", "/", 
     SuperscriptBox["10", "52"]}], "erg"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Etot", " ", "is", " ", "in", " ", "units", " ", "of", " ", 
    RowBox[{"Etot", "/", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["10", "52"], "erg"}], ")"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Eavg", " ", "is", " ", "in", " ", "units", " ", "of", " ", 
    RowBox[{"Eavg", "/", "MeV"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"alpha", " ", "is", " ", "dimless"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "put", " ", "all", " ", "energies", " ", "in", " ", "terms", " ", "of", " ",
     "MeV"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "as", " ", "a", " ", "function", " ", "of", " ", "neutrino", " ", "energy",
     " ", "in", " ", "MeV"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"already", " ", "defined"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nuSpec2", "[", 
     RowBox[{"E_", ",", "Etot_", ",", "Eavg_", ",", "\[Alpha]_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", "\[Alpha]"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], 
       RowBox[{"Gamma", "[", 
        RowBox[{"1", "+", "\[Alpha]"}], "]"}]], ")"}], "*", 
     RowBox[{"(", 
      FractionBox[
       RowBox[{"(", 
        RowBox[{"Etot", "*", 
         SuperscriptBox["10", "52"], "*", "erg"}], ")"}], 
       RowBox[{
        RowBox[{"(", "Eavg", ")"}], "^", "2"}]], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        FractionBox["E", "Eavg"], ")"}], "^", "\[Alpha]"}], ")"}], "*", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], "*", 
       FractionBox["E", "Eavg"]}], "]"}]}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.985020392312282*^9, 3.985020456425186*^9}, {
  3.9850206878789587`*^9, 3.985020705348956*^9}, {3.985204289215601*^9, 
  3.985204293749167*^9}, {3.985256535238969*^9, 3.9852565946645393`*^9}, {
  3.985258839662918*^9, 3.9852588448129053`*^9}, {3.9852589291934557`*^9, 
  3.9852589372109213`*^9}},
 CellLabel->"In[75]:=",ExpressionUUID->"d97a4d33-1f1d-4741-b611-4368c3bd2b44"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "put", " ", "all", " ", "energies", " ", "in", " ", "terms", " ", "of", " ",
     "MeV"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "as", " ", "a", " ", "function", " ", "of", " ", "neutrino", " ", "energy",
     " ", "in", " ", "MeV"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"eqn", " ", "8", " ", "from", " ", "Horiuchi", " ", "et", " ", 
    RowBox[{"al", ".", " ", "2009"}]}], "*)"}], " ", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "was", " ", "not", " ", "used", " ", "and", " ", "depends", " ", "on", " ",
     "neutrino", " ", "temperature"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nuSpecDisused", "[", 
     RowBox[{"E_", ",", "Etot_", ",", "Temp_"}], "]"}], ":=", 
    RowBox[{
     FractionBox[
      RowBox[{"Etot", "*", 
       SuperscriptBox["10", "52"], "*", "erg"}], "6"], "*", 
     FractionBox["120", 
      RowBox[{"7", "*", 
       SuperscriptBox["Pi", "4"]}]], "*", 
     FractionBox[
      SuperscriptBox["E", "2"], 
      SuperscriptBox["Temp", "4"]], "*", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"E", "/", "Temp"}], "]"}], "+", "1"}], ")"}], 
      RowBox[{"-", "1"}]]}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.985020611094829*^9, 3.985020783111989*^9}, {
   3.985204700300115*^9, 3.98520470604215*^9}, 3.9852563883273363`*^9, {
   3.98525642711862*^9, 3.985256427874308*^9}, 3.985256516525167*^9, {
   3.985258853581918*^9, 3.985258855317924*^9}},
 CellLabel->"In[76]:=",ExpressionUUID->"89ff8ae6-4a02-49b3-a5eb-d374d7d6ccaf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"nuSpec2", "[", 
        RowBox[{"x", ",", "\[Alpha]", ",", "Eavg", ",", "Etot"}], "]"}], ",", 
       
       RowBox[{"nuSpecDisused", "[", 
        RowBox[{"x", ",", "Etot", ",", "T"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "Emin", ",", "Emax"}], "}"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<MeV\>\"", 
        ",", "\"\<\!\(\*SuperscriptBox[\(MeV\), \(-1\)]\)\>\""}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<nu spec with \[Alpha]\>\"", 
        ",", "\"\<nu spec with T\>\""}], "}"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Alpha]", ",", "2", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"Eavg", ",", "1", ",", "20"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"Etot", ",", "1", ",", "20"}], "}"}], ",", 
