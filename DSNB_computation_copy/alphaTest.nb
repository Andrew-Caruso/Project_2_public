Cell["look at nuebar alpha parameter", "Text",
 CellChangeTimes->{{3.9798994252206707`*^9, 
  3.979899430179781*^9}},ExpressionUUID->"cd4b2dd4-fa62-4228-8d06-\
3d91ffaf61d0"],

Cell[TextData[{
 "Kresse et al. 2021 set instantaneous neutrino spectral-shape parameter ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"\[Alpha]", " "}], 
    SubscriptBox[
     OverscriptBox["\[Nu]", "_"], "e"]], TraditionalForm]],ExpressionUUID->
  "a31030b8-ba3e-49aa-a07d-44c31d738e05"],
 "  to be",
 Cell[BoxData[
  RowBox[{" ", 
   RowBox[{
    RowBox[{"3.5", " ", "for", " ", 
     SubscriptBox["M", "NSbary"]}], " ", "<=", " ", 
    RowBox[{"1.6", " ", "and", " ", "3", " ", "for", " ", 
     SubscriptBox["M", "NSbary"]}], " ", ">", " ", "1.6", "  "}]}]],
  CellChangeTimes->{{3.94645834370008*^9, 3.9464583616053123`*^9}, {
   3.946458411015049*^9, 3.946458487008602*^9}, {3.946458713881481*^9, 
   3.946458722604329*^9}, {3.946458781568462*^9, 3.946458822145293*^9}, {
   3.946461754406208*^9, 3.946461762914117*^9}, {3.946461837429826*^9, 
   3.946461842870319*^9}, {3.946462695824869*^9, 3.94646272351099*^9}, {
   3.9464627606359653`*^9, 3.9464631101974773`*^9}, {3.946469353708701*^9, 
   3.946469499171517*^9}, {3.946469623953813*^9, 3.946469725059696*^9}, {
   3.9464700000669928`*^9, 3.9464700015079193`*^9}, {3.946557100198152*^9, 
   3.9465571192735767`*^9}, {3.946557267555882*^9, 3.946557267740985*^9}, {
   3.946557812738831*^9, 3.9465578377557907`*^9}, {3.946557953956504*^9, 
   3.946557962349533*^9}},ExpressionUUID->
  "c69e2bfa-f34c-4bf6-8eb3-009d3d330d13"],
 "to be constant for NS and 2 for BH pops"
}], "Text",
 CellChangeTimes->{{3.979899683382268*^9, 
  3.979899684290144*^9}},ExpressionUUID->"2a3903e1-6b72-4610-a58e-\
d0b9b51e0832"],

