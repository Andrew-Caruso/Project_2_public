 RowBox[{
  RowBox[{"(*", 
   RowBox[{"reformat", " ", "the", " ", "snap", " ", "shot", " ", "data"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"recall", " ", "format", " ", 
    RowBox[{"is", ":"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
