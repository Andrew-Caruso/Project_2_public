Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"dsnbFluxFidFunc", "=", 
    RowBox[{"Interpolation", "[", "fiducialDSNBflux", "]"}]}], ";"}], 
