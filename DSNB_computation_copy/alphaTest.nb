Cell[CellGroupData[{

Cell["attempt to modified sigmoid", "Subsubsection",
 CellChangeTimes->{{3.9864655749979553`*^9, 
  3.986465594282175*^9}},ExpressionUUID->"ecad983e-4f12-461a-be22-\
1c11bcb80b49"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"modsigmoid", "[", 
   RowBox[{"x_", ",", "a_", ",", "b_"}], "]"}], "=", 
  FractionBox[
   SuperscriptBox["x", "b"], 
   RowBox[{"1", "+", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "x"}], "/", "a"}], "]"}]}]]}]], "Input",
 CellChangeTimes->{{3.986465646651908*^9, 3.986465654075245*^9}},
 CellLabel->
  "In[143]:=",ExpressionUUID->"dad26796-55d5-464c-b919-30bc0f151d92"],

Cell[BoxData[
 FractionBox[
  SuperscriptBox["x", "b"], 
  RowBox[{"1", "+", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", 
     FractionBox["x", "a"]}]]}]]], "Output",
 CellChangeTimes->{3.986465654716733*^9, 3.986494700530848*^9, 
  3.988406359878008*^9},
 CellLabel->
  "Out[143]=",ExpressionUUID->"a9ad3b53-14db-421c-ba16-e25c66ffbf55"]
}, Open  ]],

