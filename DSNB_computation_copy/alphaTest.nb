       RowBox[{"2", "+", "\[Alpha]"}], "}"}]}]], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], "*", 
      FractionBox["E", "Eavg"]}], "]"}]}]}]}]], "Input",
