Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"eye", "-", 
    RowBox[{
    "ball", " ", "some", " ", "values", " ", "from", " ", "figure", " ", 
     "2"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "use", " ", "\"\<Probing the neutrino mass hierarchy with the rise time of \
a supernova burst\>\""}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Serpico", " ", "et", " ", 
    RowBox[{"al", ".", " ", "2012"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"https", ":"}], "//", 
    RowBox[{
     RowBox[{
      RowBox[{"arxiv", ".", "org"}], "/", "abs"}], "/", "1111.4483"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"\"\<https://arxiv.org/abs/1111.4483\>\"", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"in", " ", "format", " ", "of", " ", 
     RowBox[{"(", 
      RowBox[{
      "time", ",", " ", "alpha", ",", " ", "Eavg", ",", " ", "Luminosity"}], 
      ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"in", " ", 
     RowBox[{"units", ":", " ", 
      RowBox[{"(", 
       RowBox[{"s", ",", " ", "dimless", ",", " ", "MeV", ",", " ", 
        RowBox[{"erg", "/", "s"}]}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"convert", " ", "to", " ", 
     RowBox[{"(", 
      RowBox[{"s", ",", " ", "dimless", ",", " ", "MeV", ",", " ", 
       RowBox[{"MeV", "/", "s"}]}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "selected", " ", "timeshot", " ", "corresponding", " ", "to", " ", "the", 
     " ", "nuetrino", " ", "parameters", " ", "and", " ", "the", " ", 
     "areas"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"snapTimes", "=", 
     RowBox[{"{", 
      RowBox[{
      "0.005", ",", "0.01", ",", "0.02", ",", "0.1", ",", "0.15", ",", 
       "0.18"}], "}"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"in", " ", "seconds", " ", "post"}], "-", "bounce"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Etot", 
      RowBox[{"(", "t", ")"}]}], " ", "=", " ", 
     RowBox[{"integrated", " ", 
      RowBox[{"(", 
       RowBox[{
       "rather", " ", "sum", " ", "up", " ", "areas", " ", "of", " ", 
        "luminosity", " ", 
        RowBox[{"(", 
         RowBox[{"energy", "/", "time"}], ")"}]}], ")"}], " ", "to", " ", 
      "that", " ", "particular", " ", "time"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "note", " ", "that", " ", "these", " ", "are", " ", "only", " ", "chunks",
      " ", "and", " ", "must", " ", "be", " ", "summed", " ", "up", " ", "to",
      " ", "the", " ", "corresponding", " ", "timeshot"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"A1", " ", "=", 
     RowBox[{"0.005", "*", "1", "*", 
      SuperscriptBox["10", "51"]}]}], " ", 
    RowBox[{"(*", "erg", "*)"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"A2", " ", "=", " ", 
     FractionBox[
      RowBox[{"0.005", "*", "4", "*", 
       SuperscriptBox["10", "51"]}], "2"]}], 
    RowBox[{"(*", "erg", "*)"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"A3", "=", 
     RowBox[{
      FractionBox[
       RowBox[{"0.01", "*", "10", "*", 
        SuperscriptBox["10", "51"]}], "2"], "+", 
      RowBox[{"0.01", "*", "4", "*", 
       SuperscriptBox["10", "51"]}]}]}], 
    RowBox[{"(*", "erg", "*)"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"A4", "=", 
     RowBox[{
      FractionBox[
       RowBox[{"(", 
        RowBox[{"24", "*", 
         SuperscriptBox["10", "51"], "*", "0.08"}], ")"}], "2"], "+", 
      RowBox[{"0.08", "*", "25", "*", 
       SuperscriptBox["10", "51"]}]}]}], 
    RowBox[{"(*", "erg", "*)"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"A5", "=", 
     RowBox[{
      FractionBox[
       RowBox[{"5", "*", 
        SuperscriptBox["10", "51"], "*", "0.05"}], "2"], "+", 
      RowBox[{"44", "*", 
       SuperscriptBox["10", "51"], "*", "0.05"}]}]}], 
    RowBox[{"(*", "erg", "*)"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"A6", "=", 
     RowBox[{
      FractionBox[
       RowBox[{"10", "*", 
        SuperscriptBox["10", "51"], "*", "0.03"}], "2"], "+", 
      RowBox[{"34", "*", 
       SuperscriptBox["10", "51"], "*", "0.03"}]}]}], 
    RowBox[{"(*", "erg", "*)"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"in", " ", "format", " ", "of", " ", "alpha"}], ",", " ", "Eavg",
      ",", " ", "Etot"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"in", " ", 
     RowBox[{"units", ":", " ", 
      RowBox[{"(", 
       RowBox[{"dimless", ",", " ", "MeV", ",", " ", 
        RowBox[{"erg", "->", "MeV"}]}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"snap1", "=", 
     RowBox[{"{", 
      RowBox[{"3.5", ",", "9", ",", 
       RowBox[{"A1", "*", "erg"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"snap2", "=", 
     RowBox[{"{", 
      RowBox[{"4", ",", "10.5", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"A1", "+", "A2"}], ")"}], "*", "erg"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"snap3", "=", 
     RowBox[{"{", 
      RowBox[{"4.3", ",", "11", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"A1", "+", "A2", "+", "A3"}], ")"}], "*", "erg"}]}], "}"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"snap4", "=", 
     RowBox[{"{", 
      RowBox[{"4", ",", "13", ",", 
