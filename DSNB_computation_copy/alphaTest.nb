Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"sigmoid", "[", 
   RowBox[{"x_", ",", "a_", ",", "b_"}], "]"}], "=", 
  FractionBox["b", 
   RowBox[{"1", "+", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "x"}], "/", "a"}], "]"}]}]]}]], "Input",
 CellChangeTimes->{{3.986465127157611*^9, 3.986465187827454*^9}, {
  3.986465253169242*^9, 3.9864652881018972`*^9}, {3.986465558805869*^9, 
