  RowBox[{
   RowBox[{"nuSpec", "[", 
    RowBox[{"E_", ",", "\[Alpha]_", ",", "Eavg_", ",", "Etot_"}], "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", "\[Alpha]"}], ")"}], "^", 
      RowBox[{"{", 
       RowBox[{"1", "+", "\[Alpha]"}], "}"}]}], 
